export interface MbtiScenario {
  situation: string;
  kiridashi: { A: string; B: string; C: string; D: string; correct: string };
  furumai: { A: string; B: string; C: string; D: string; correct: string };
  result: string;
  naze: string;
  otoshiana: string;
  hint: string;
  more: string;
}

export type MbtiScenarios = Record<string, Record<number, MbtiScenario>>;

export const mbtiScenarios: MbtiScenarios = {"ENFP":{"1":{"situation":"あなたは社内プロジェクトのリーダーを任されている。\n来週金曜が納期の重要な成果物について、協力会社からの納品遅延が判明。全体スケジュールが3日ほど後ろ倒しになる見込みだ。\n\n田中部長（プロジェクト責任者）にこの事実を報告し、今後の対応を相談しなければならない。","kiridashi":{"A":"「部長、今お時間よろしいでしょうか。〇〇プロジェクトについて、ご報告とご相談がございます」","B":"「部長！お疲れ様です！あ、そうそう、〇〇プロジェクトの件なんですけどね、協力会社の方と話してて分かったことがあって、それがですね…」","C":"「部長…あの…〇〇プロジェクトの件で…ちょっとご報告があって…」","D":"「部長、〇〇プロジェクトの進捗データを見てください。ここ、赤信号です」","correct":"A"},"furumai":{"A":"落ち着いて事実を簡潔に伝え、「こう対応したいと考えているが、ご意見を伺いたい」と相談する","B":"遅延の経緯をドラマチックに語り、「でも大丈夫です！私、代替案も考えてます！あと〇〇もできるかも！」と次々アイデアを出す","C":"報告しなきゃという焦りから、勢いだけで話してしまい、要点がぼやける","D":"スケジュール表を提示し、遅延の影響範囲を論理的に説明する","correct":"A"},"result":"A + A","naze":"「今お時間よろしいでしょうか」は、相手の状況を尊重する基本の切り出し。田中部長は多忙な管理職だから、いきなり本題に入られると心の準備ができていない。\n\n「ご報告とご相談がございます」と伝えることで、**話の目的を先に示して、相手に受け止める準備を促せる**。事実を簡潔に伝えて、相談に移る。この王道パターンが確実に伝わりやすい。","otoshiana":"ENFPは**「報告が脱線しがち。話が長くなる。本題から逸れる」**傾向がある。Bの切り出し方はまさにそのパターン。「協力会社の方と話しててね…」と経緯から入り、気づけば脇道にそれている。\n\nもう一つ注意。ENFPは**「アイデアが次々湧いてくる」**のが強みだけど、悪い報告の場面ではそれが裏目に出る。「あと〇〇もできるかも！」と楽観的な提案を並べすぎると、部長は「本当に大丈夫か？」と逆に不安になる。まずは事実をシンプルに伝えて、一つの対策案に絞って相談するのがおすすめ。","hint":"**悪い報告の3ステップ切り出し：**\n1. 「今お時間よろしいでしょうか」（タイミングの確認）\n2. 「ご報告とご相談がございます」（目的の提示）\n3. 「実は〜」（本題に入る）\n\n**言い換え例：**\n- ×「あのね、今日協力会社の方と話してて、それがですね…」（前置きが長い）\n- 〇「スケジュールに影響が出る件がございまして、ご相談がございます」（事実を先に）","more":"ENFPの**「話が面白い」「アイデアが豊富」**という強みは、プレゼンや企画では大活躍する。でも、悪い報告の場面では**「シンプル・簡潔・的確」**が効果的。話を一つに絞る練習をしておくと、ピンチの時に信頼される存在になれる。"},"2":{"situation":"あなたは新規プロジェクトのメンバーとして参加している。\n同僚の佐藤さんが担当しているデザイン作業の進捗が予定より遅れており、このままではあなたの担当領域（フロントエンド実装）の着手にも影響が出そうだ。\n\n佐藤さんに状況を確認し、どう進めるか話し合いたい。","kiridashi":{"A":"「佐藤さん、今ちょっといいかな。プロジェクトの進捗について、確認と相談があるんだけど」","B":"「佐藤さん〜！お疲れ様！あのさ、デザインの進捗どう？まあ焦らなくていいんだけどね、でもちょっと気になってて、そういえば佐藤さん最近忙しそうだけど大丈夫？」","C":"「佐藤さん…デザインの件、あの…あまり急かしたくないんだけど…」","D":"「佐藤さん、デザインまだ終わらないの？俺の実装に響いてるんだけど」","correct":"A"},"furumai":{"A":"相手の状況を先に聞き、「どう進めるのがお互いにとって良いか」を一緒に考える","B":"楽しい雰囲気で話しつつ、「まあなんとかなるでしょ！」と明るく流す","C":"相手のペースに合わせて、もう少し待ってみる","D":"「他に手がないなら、俺がデザインもやろうか？」と次々アイデアを出す","correct":"A"},"result":"A + A","naze":"同僚関係は上下関係ではない。対等な立場だからこそ、「確認と相談」という言葉で**相手を責めるのではなく、一緒に考える姿勢**を見せることが大切。\n\nまず相手の事情を聞くことで、本当のボトルネックが見えてくる。お互いの状況を正直に共有して、現実的な着地点を決める。これが同僚として信頼されやすいスタンス。","otoshiana":"ENFPは**「楽しい雰囲気で伝えようとして、問題の深刻さが伝わらない」**ことがある。Bの対応はまさにそのパターン。「焦らなくていいんだけどね」「まあなんとかなるでしょ」と明るく振る舞ううちに、「実は結構困っている」という本音が伝わらない。\n\nもう一つ注意。ENFPは**「会話が脱線しやすい」**。「佐藤さん最近忙しそうだけど大丈夫？」と気遣いのつもりで話を広げると、いつの間にか本題から離れてしまう。確認と相談は短く集中して。雑談はその後にするのがおすすめ。","hint":"**同僚への「確認＋相談」の基本パターン：**\n1. 「今ちょっといいかな」（タイミング確認）\n2. 「〇〇の件で、確認と相談があるんだけど」（目的を先に伝える）\n3. 「今どんな状況か教えてもらえる？」（相手の状況を先に聞く）\n\n**言い換え例：**\n- ×「まあなんとかなるでしょ！焦らなくていいよ！」（深刻さが伝わらない）\n- 〇「デザインの進捗を確認したいんだけど、今どんな感じ？」（直接的＋配慮）","more":""},"3":{"situation":"あなたはチームのサブリーダー。入社2年目の後輩・高橋さんが、クライアント向けの提案資料に複数のデータミスを混入させてしまった。\n幸い提出前にあなたが発見したが、高橋さんにはミスの原因を理解してもらい、同じ間違いを繰り返さないように指導したい。","kiridashi":{"A":"「高橋さん、提出前の資料チェックしてて気になった点があったんだけど、ちょっと見てくれる？」","B":"「高橋さん、お疲れ様〜！資料チェックしたんだけど、いくつか直すところがあったから一緒に見よう！まあ大丈夫だよ、誰でもやるミスだから！」","C":"「高橋さん…資料なんだけど…俺が直しておいたから…気にしないでね」","D":"「高橋さん、この資料のデータ、複数間違ってるよ。どうやって確認したの？」とストレートに指摘する","correct":"A"},"furumai":{"A":"具体的にどこが違うかを示し、「どうやって確認したか教えてくれる？」と原因を一緒に考える","B":"「全然問題ないよ！私も昔よくやってたし！むしろここ、すごくいいアイデアだね！」とポジティブな面を強調する","C":"ミスを指摘するが、高橋さんが落ち込んだらすぐに「まあまあ、次頑張ろう！」と慰める","D":"「こういう確認シートを作るといいよ」と、新しいツールや仕組みを次々提案する","correct":"A"},"result":"A + A","naze":"「気になった点がある」という言い方は、ミスを**「指摘」ではなく「一緒に確認」**というフレームに変えている。後輩が防御的になるのを防げる。\n\n「ちょっと見てくれる？」と問いかけ形にすることで、相手に自分で気づく機会を与えている。自分で見つけたミスの方が、次から意識に残りやすい。その上で「どうやって確認した？」と原因を一緒に考える。これが再発防止につながりやすい。","otoshiana":"ENFPは**「ポジティブに励ますだけで、ミスの根本的な指摘が甘い」**ことがある。Bの対応はまさにそのパターン。「全然問題ないよ！」「すごくいいアイデアだね！」と、ポジティブな面にフォーカスしすぎて、肝心の「何が間違っていたのか」が薄まってしまう。\n\nもう一つ注意。ENFPは**「次々アイデアが出る」**から、Dのように「確認シートを作ろう」「ツールを導入しよう」と解決策をあれこれ提案しがち。でも、まず意識したいのは「なぜミスが起きたのか」を高橋さん自身に考えてもらうこと。根本原因への気づきなしに仕組みだけ追加しても、また別のミスが出る。","hint":"**後輩へのフィードバックの基本パターン：**\n1. 「ちょっと見てくれる？」（共に確認する姿勢）\n2. 「ここ、〇〇と××で数字が違うね」（事実を具体的に指摘）\n3. 「どうやって確認したか教えてもらえる？」（プロセスを一緒に振り返る）\n\n**言い換え例：**\n- ×「全然問題ないよ！私も昔よくやってたし！」（指摘が甘い）\n- 〇「ここ、元のデータと数字が違うんだけど、どこから持ってきたか一緒に見てみよう」（一緒に考える姿勢）","more":"ENFPの**「ポジティブなエネルギー」**は後輩にとって心強いサポート。ただ、**「励ます」ことと「指導する」ことは別の役割**。「事実を整理する」「原因を考える」「対策を決める」という実務プロセスを踏んだ上で、最後にポジティブな言葉をかける。この順番なら、励ましも本質的な指摘も両方機能する。"},"4":{"situation":"あなたはWeb制作会社のプロジェクトマネージャー。\nクライアントの鈴木社長から「納品前に機能を追加したい」という要望が入った。仕様は既に確定し、追加費用の予算はない。\n\n追加費用なしでは対応が難しいが、クライアントとの関係も悪くしたくない。鈴木社長に対応方針を伝える必要がある。","kiridashi":{"A":"「鈴木社長、ご要望ありがとうございます。一度内容を整理させていただき、改めてご提案してもよろしいでしょうか」","B":"「鈴木社長、いいですねそのアイデア！面白そう！ぜひやりましょう！あ、でもちょっと確認が必要なんで、後でね！」","C":"「鈴木社長…その機能…今の予算だと…うーん…でも何とか…」","D":"「鈴木社長、その追加機能についてですが、仕様確定後の変更は規定外となります」","correct":"A"},"furumai":{"A":"相手の要望の背景を質問で深掘りし、本当に必要なものを一緒に整理した上で、現実的な提案を行う","B":"クライアントと意気投合して、追加機能のアイデアを一緒に盛り上がってしまう","C":"断るのが嫌で、話を合わせてその場をやり過ごす","D":"追加費用の計算を始めて、数字で説得しようとする","correct":"A"},"result":"A + A","naze":"クライアントの要望をまず受け止めることが出発点。「ありがとうございます」で相手の提案を尊重しつつ、「整理して改めてご提案」と**即答を避けて考える時間を確保**している。\n\n相手の真のニーズを深掘りしてから、現実的な着地点を探る。この「一旦受け止めて整理する」プロセスが、クライアントとの信頼関係を確実に守りやすい。","otoshiana":"ENFPは**「クライアントと仲良くなることに注力して、条件面の詰めが甘い」**ことがある。Bの対応はまさにそのパターン。「いいですね！」「面白そう！」「ぜひやりましょう！」と、相手のアイデアに飛びついてしまい、肝心の「予算は？工期は？リソースは？」が後回しになる。\n\nもう一つ注意。ENFPは**「その場の盛り上がりで約束してしまう」**癖がある。楽しい会話の中で「やりましょう！」と言ってしまうのは気持ちいいけど、後で冷静になった時、「あれ、どうやって実現するんだっけ？」と困ることに。まずは「ありがとうございます」で受け止めて、考える時間をできるだけもらうようにするのがおすすめ。","hint":"**クライアントの追加要望への3ステップ：**\n1. 「ありがとうございます／ご要望、承知しました」（まず受け止める）\n2. 「少し具体的に教えても良いですか？ どういう場面で使いたいかなど」（背景を深掘り）\n3. 「整理して、〇日までにご提案します」（即答せず時間をもらう）\n\n**言い換え例：**\n- ×「いいですね！ぜひやりましょう！」（その場の勢いで約束）\n- 〇「ご要望の背景を教えていただければ、ベストな提案ができます」（協力の姿勢＋時間をもらう）","more":"ENFPの**「人と打ち解ける力」**は、営業でもPMでも強力な武器。ただ、ビジネスの交渉では**「仲良くなる」と「条件を詰める」は別ステップ**。盛り上がった後に冷静な確認を挟む癖をつけると、ENFPらしさを保ちながらプロとしての信頼も勝ち取れる。"},"5":{"situation":"あなたはマーケティング部門のメンバー。来月実施するキャンペーンの企画が承認されたが、実行にはシステム部門の協力（LPの開発とサーバー準備）が必要だ。\n\nシステム部門は今、自社サービスの大型リリース準備で忙しいと聞いている。システム部門の山田課長に協力を依頼しなければならない。","kiridashi":{"A":"「山田課長、お忙しいところ恐れ入ります。マーケティングの〇〇キャンペーンの件で、ご相談がございます」","B":"「山田課長、お疲れ様です！あのね、マーケティングですごい企画が承認されたんですよ！LP開発とサーバー準備が必要なんですが、きっと面白いと思うんです！お願いできますかね？」","C":"「山田課長…システム部門忙しいのは知ってるんですが…実はお願いがあって…でも無理なら…」","D":"「山田課長、マーケティングのキャンペーンのLP開発をお願いしたいです。〇日までに完成をお願いします」","correct":"A"},"furumai":{"A":"相手の都合を先に聞き、こちらの要件を共有した上で「一緒にスケジュールを調整できないか」と提案する","B":"企画の素晴らしさを熱意で語り、「きっとシステム部門にとっても良い経験になりますよ！」と勧誘する","C":"相手が忙しそうなので、詳細はまた後でいいやと思って、曖昧なまま終わる","D":"まず企画書を送りつけて、「詳細は企画書を見てください」と丸投げする","correct":"A"},"result":"A + A","naze":"他部署への依頼は、社内とはいえ**「相手にも相手の仕事がある」**ことが前提。まず「お忙しいところ恐れ入ります」と相手の状況を認めることで、「こちらの事情を押し付けるつもりはない」というサインになる。\n\n「ご相談がございます」という言葉で、一方的な依頼ではなく**双方向の話し合いの姿勢**を示せている。相手の都合を聞きつつ、自分の希望も明確に伝える。このバランスが協力を得やすくなる。","otoshiana":"ENFPは**「熱意で押すが、具体的な依頼内容が曖昧。スケジュール感がない」**ことがある。Bの対応はまさにそのパターン。「すごい企画なんです！」「面白いと思います！」と熱意は伝わるけど、「いつまでに」「何を」「どのくらいの規模で」が必要なのかが見えない。\n\nもう一つ注意。ENFPは**「相手にも楽しさが伝われば協力してくれるはず」**と思いがちだけど、忙しい他部署の人にとって「面白い」は動機にならないことが多い。彼らが知りたいのは「何を・いつまでに・どれくらいの工数か」。熱意は付加価値であって、メインの説明じゃない。","hint":"**他部署への依頼の基本パターン：**\n1. 「お忙しいところ恐れ入ります」（相手の状況を認める）\n2. 「〇〇の件でご相談がございます」（「お願い」より「相談」が良い）\n3. 「まずは今の状況を教えていただけますか」（相手の都合を先に聞く）\n\n**言い換え例：**\n- ×「すごい企画なんです！きっと面白いと思います！」（熱意だけで内容が見えない）\n- 〇「〇日が理想ですが、山田課長のスケジュールに合わせて調整できます」（柔軟性を示す）","more":"ENFPの**「熱意で人を動かす力」**は強み。ただ、他部署への依頼では**「熱意」の前に「事実」**を置くことを意識するのがおすすめ。「何を依頼したいか」「いつまでに必要か」「どれくらいの規模か」を先に伝えて、その上で熱意を添える。この順番なら、ENFPらしい魅力も伝わるし、相手も検討しやすい。"}},"ENFJ":{"1":{"situation":"あなたは社内プロジェクトのリーダーを任されている。\n来週金曜が納期の重要な成果物について、協力会社からの納品遅延が判明。全体スケジュールが3日ほど後ろ倒しになる見込みだ。\n\n田中部長（プロジェクト責任者）にこの事実を報告し、今後の対応を相談しなければならない。","kiridashi":{"A":"「部長、今お時間よろしいでしょうか。〇〇プロジェクトについて、ご報告とご相談がございます」","B":"「部長、ご安心ください！〇〇プロジェクトで少し遅延が出たんですが、私がなんとかしますので！リカバリー案も考えてます！」","C":"「部長…あの…〇〇プロジェクトの件なんですけど…ご迷惑をおかけして申し訳ありません」","D":"「部長、〇〇プロジェクトの遅延について、原因と責任の所在を整理したので確認してください」","correct":"A"},"furumai":{"A":"落ち着いて事実を簡潔に伝え、「こう対応したいと考えているが、ご意見を伺いたい」と相談する","B":"部長ががっかりしないよう、「大丈夫です！」「何とかします！」と前向きな姿勢を強調する","C":"自分が全て解決するつもりで、過剰な約束をしてしまう","D":"原因の分析を詳細に行い、論理的に説明しようとする","correct":"A"},"result":"A + A","naze":"「今お時間よろしいでしょうか」は、相手の状況を尊重する基本の切り出し。田中部長は多忙な管理職だから、いきなり本題に入られると心の準備ができていない。\n\n「ご報告とご相談がございます」と伝えることで、**話の目的を先に示して、相手に受け止める準備を促せる**。落ち着いて事実を伝えつつ、自分の考えも共有する。このオーソドックスな進め方が、上司との信頼関係を確実に築きやすい。","otoshiana":"ENFJは**「上司の期待に応えようとして、安請け合い・過剰な約束をしてしまう」**傾向がある。BやCの対応はまさにそのパターン。「何とかします！」「リカバリー案も考えてます！」と、部長を安心させたい気持ちが先行する。\n\nもう一つ注意。ENFJは**「自分が全ての調整役を引き受ける」**癖がある。遅延の報告でも、「私がなんとかします」と一人で抱え込みがち。でも、プロジェクトの遅延は一人で解決すべき問題ではない。部長に報告して、一緒に対応を考えるのが本来の望ましい進め方。","hint":"**悪い報告の3ステップ切り出し：**\n1. 「今お時間よろしいでしょうか」（タイミングの確認）\n2. 「ご報告とご相談がございます」（目的の提示）\n3. 「実は〜」（本題に入る）\n\n**言い換え例：**\n- ×「大丈夫です！私がなんとかします！」（過剰な約束）\n- 〇「スケジュールに影響が出る件がございまして、ご相談がございます」（事実を先に）","more":"ENFJの**「人の期待に応えたい」**という原動力は素晴らしい強み。でも、悪い報告の場面では、その原動力が**「事実を隠して元気な姿を見せる」**方向に働くことがある。部長にとって本当に必要なのは、安心させる笑顔ではなく、正確な事実。事実をちゃんと伝えることも、相手を大切にするコミュニケーションの一部。"},"2":{"situation":"あなたは新規プロジェクトのメンバーとして参加している。\n同僚の佐藤さんが担当しているデザイン作業の進捗が予定より遅れており、このままではあなたの担当領域（フロントエンド実装）の着手にも影響が出そうだ。\n\n佐藤さんに状況を確認し、どう進めるか話し合いたい。","kiridashi":{"A":"「佐藤さん、今ちょっといいかな。プロジェクトの進捗について、確認と相談があるんだけど」","B":"「佐藤さん、最近お疲れ気味？大丈夫？何かサポートできることがあれば言ってね！デザインの進捗も気になってるんだけど」","C":"「佐藤さん…デザインの件、ちょっと気になってて…でも無理しないでね」","D":"「佐藤さん、デザインまだ？みんな待ってるんだけど、そろそろ進めないと厳しくない？」","correct":"A"},"furumai":{"A":"相手の状況を先に聞き、「どう進めるのがお互いにとって良いか」を一緒に考える","B":"佐藤さんの体調やメンタルを気遣い、「休憩取った？」「何か悩みがあるの？」とケアに徹する","C":"相手の都合に合わせて、自分の方で調整できることは調整する","D":"「他のメンバーも困ってるから」と、周囲の意見を持ち出してプレッシャーをかける","correct":"A"},"result":"A + A","naze":"同僚関係は上下関係ではない。対等な立場だからこそ、「確認と相談」という言葉で**相手を責めるのではなく、一緒に考える姿勢**を見せることが大切。\n\nまず相手の事情を聞くことで、本当のボトルネックが見えてくる。メンタルケアも大切だけど、この場面で必要なのは「進め方の合意」。お互いの状況を共有して、着地点を一緒に決めるのがプロフェッショナルな働き方につながりやすい。","otoshiana":"ENFJは**「同僚のメンタルケアに注力しすぎて、課題解決が後回しになる」**ことがある。Bの対応はまさにそのパターン。「大丈夫？」「休憩取った？」と気遣うのはENFJらしい優しさだけど、肝心の「デザインの進捗が遅れていて困っている」が伝わらない。\n\nもう一つ注意。ENFJは**「みんなのために」**という意識が強いから、Dのように「他のメンバーも困ってる」と周囲を巻き込んでプレッシャーをかけてしまうことも。でも、これは佐藤さんを追い詰めるだけ。「私とあなた」の間で解決策を探す方が、関係も成果も良くなる。","hint":"**同僚への「確認＋相談」の基本パターン：**\n1. 「今ちょっといいかな」（タイミング確認）\n2. 「〇〇の件で、確認と相談があるんだけど」（目的を先に伝える）\n3. 「今どんな状況か教えてもらえる？」（相手の状況を先に聞く）\n\n**言い換え例：**\n- ×「最近お疲れ気味？大丈夫？何かサポートできることある？」（本題に入らない）\n- 〇「デザインの進捗を確認したいんだけど、今どんな感じ？」（直接的＋配慮）","more":"ENFJの強みは**「人の気持ちに寄り添う力」**。ただ、ビジネスの場では**「寄り添う」ことと「課題を解決する」ことは別ステップ**。まず課題を明確にしてから、必要に応じてケアする。この順番を意識すると、ENFJの優しさがより効果的に活きる。"},"3":{"situation":"あなたはチームのサブリーダー。入社2年目の後輩・高橋さんが、クライアント向けの提案資料に複数のデータミスを混入させてしまった。\n幸い提出前にあなたが発見したが、高橋さんにはミスの原因を理解してもらい、同じ間違いを繰り返さないように指導したい。","kiridashi":{"A":"「高橋さん、提出前の資料チェックしてて気になった点があったんだけど、ちょっと見てくれる？」","B":"「高橋さん、お疲れ様！資料チェックしたんだけど、いくつか直したいところがあって。でも大丈夫、一緒に直そう！」","C":"「高橋さん…資料なんだけど…あんまり気にしないでね…少しだけ直しておいたから…」","D":"「高橋さん、この資料のデータ、複数間違ってるよ。確認した？」とストレートに指摘する","correct":"A"},"furumai":{"A":"具体的にどこが違うかを示し、「どうやって確認したか教えてくれる？」と原因を一緒に考える","B":"「全然気にしなくていいよ！私も昔よくやったから！一緒に頑張ろう！」と励ますことに全力を注ぐ","C":"ミスを指摘するが、高橋さんが悲しそうだとすぐに慰めに切り替える","D":"「これくらいのミス、2年目なら気づいてほしかったな」と感情を出す","correct":"A"},"result":"A + A","naze":"「気になった点がある」という言い方は、ミスを**「指摘」ではなく「一緒に確認」**というフレームに変えている。後輩が防御的になるのを防げる。\n\n「ちょっと見てくれる？」と問いかけ形にすることで、相手に自分で気づく機会を与えている。自分で見つけたミスの方が、次から意識に残りやすい。その上で「どうやって確認した？」と原因を一緒に考えると、再発防止につながりやすい。","otoshiana":"ENFJは**「後輩を励ますことに注力しすぎて、具体的な改善指導が不足」**しがち。Bの対応はまさにそのパターン。「大丈夫！」「一緒に頑張ろう！」と励ますのはENFJらしい優しさだけど、何が間違っていたのか、なぜ起きたのか、どう防ぐのか、という具体的なステップが抜け落ちている。\n\nもう一つ注意。ENFJは**「相手のモチベーションを維持させる」ことには長けているけど、「ミスの根本原因に向き合わせる」ことは別スキル**。励ましは心のサポート。でも、この場面で大切なのは「再発防止の仕組み」を作ること。まずは事実を整理して、それから励ます。この順番を意識するのがおすすめ。","hint":"**後輩へのフィードバックの基本パターン：**\n1. 「ちょっと見てくれる？」（共に確認する姿勢）\n2. 「ここ、〇〇と××で数字が違うね」（事実を具体的に指摘）\n3. 「どうやって確認したか教えてもらえる？」（プロセスを一緒に振り返る）\n\n**言い換え例：**\n- ×「大丈夫！私も昔よくやったから！一緒に直そう！」（指導が甘い）\n- 〇「ここ、元のデータと数字が違うんだけど、どこから持ってきたか一緒に見てみよう」（一緒に考える姿勢）","more":"ENFJの強みは**「人の可能性を信じて引き出す力」**。後輩指導でも、「この子なら大丈夫」と信じる姿勢はとても大事。ただ、**「信じる」ことと「指導する」ことは両立できる**。事実をちゃんと指摘した上で「一緒に乗り越えよう」と励ます。この組み合わせがあれば、後輩も成長を実感できるし、ENFJらしい温かい指導になる。"},"4":{"situation":"あなたはWeb制作会社のプロジェクトマネージャー。\nクライアントの鈴木社長から「納品前に機能を追加したい」という要望が入った。仕様は既に確定し、追加費用の予算はない。\n\n追加費用なしでは対応が難しいが、クライアントとの関係も悪くしたくない。鈴木社長に対応方針を伝える必要がある。","kiridashi":{"A":"「鈴木社長、ご要望ありがとうございます。一度内容を整理させていただき、改めてご提案してもよろしいでしょうか」","B":"「鈴木社長、ぜひ実現しましょう！私からチームに働きかけますので、何とか良い形にします！」","C":"「鈴木社長…その機能、現在の予算では難しいかもしれません…でも何とか…」","D":"「鈴木社長、その追加機能について、まずは要件定義書との差分を整理してからお話ししましょう」","correct":"A"},"furumai":{"A":"相手の要望の背景を質問で深掘りし、本当に必要なものを一緒に整理した上で、現実的な提案を行う","B":"クライアントとの関係を深めようと、追加要望にも熱心に耳を傾け、「全力でサポートします」と約束する","C":"断るのが怖くて、曖昧な返事でその場を乗り切ろうとする","D":"契約内容に基づいて、冷静に追加費用の根拠を説明する","correct":"A"},"result":"A + A","naze":"クライアントの要望をまず受け止めることが出発点。「ありがとうございます」で相手の提案を尊重しつつ、「整理して改めてご提案」と**即答を避けて考える時間を確保**している。\n\n即座に「ぜひ実現しましょう！」と安請け合いすると、後で自分が苦しくなる。まずは相手の真のニーズを深掘りしてから、現実的な着地点を探る。クライアントとの関係を大切にするならこそ、最初の約束は慎重に。","otoshiana":"ENFJは**「クライアントとの関係構築に注力しすぎて、条件交渉が甘くなる」**ことがある。Bの対応はまさにそのパターン。「全力でサポートします」「何とか良い形にします」と、関係を深めることに夢中になって、自社の条件を守れていない。\n\nもう一つ注意。ENFJは**「相手の期待に応えたい」という思いが強く、つい「できます！」と言ってしまう**。でも、本当にできるかどうかを確認せずに約束すると、後で「できませんでした」と言うことになる方が関係のダメージは大きい。勇気ある「少しお時間をください」が、実は誠実な対応につながりやすい。","hint":"**クライアントの追加要望への3ステップ：**\n1. 「ありがとうございます／ご要望、承知しました」（まず受け止める）\n2. 「少し具体的に教えても良いですか？ どういう場面で使いたいかなど」（背景を深掘り）\n3. 「整理して、〇日までにご提案します」（即答せず時間をもらう）\n\n**言い換え例：**\n- ×「ぜひ実現しましょう！全力でサポートします！」（安請け合い）\n- 〇「ご要望の背景を教えていただければ、ベストな提案ができます」（協力の姿勢＋慎重な約束）","more":"ENFJの**「人を巻き込む力」**は素晴らしい強み。でも、この場面では**「巻き込む」前に「整理する」**ステップが必要。まず事実と条件を整理して、それからチームを動かす。この順番を意識すると、ENFJのリーダーシップがより信頼されやすくなる。"},"5":{"situation":"あなたはマーケティング部門のメンバー。来月実施するキャンペーンの企画が承認されたが、実行にはシステム部門の協力（LPの開発とサーバー準備）が必要だ。\n\nシステム部門は今、自社サービスの大型リリース準備で忙しいと聞いている。システム部門の山田課長に協力を依頼しなければならない。","kiridashi":{"A":"「山田課長、お忙しいところ恐れ入ります。マーケティングの〇〇キャンペーンの件で、ご相談がございます」","B":"「山田課長、お疲れ様です！〇〇キャンペーンの件なんですが、すごく面白い企画で、きっとシステム部門にとってもプラスになると思います！ぜひご協力いただけないでしょうか！」","C":"「山田課長…システム部門忙しいのは知ってるんですが…少しだけお時間もらえますか」","D":"「山田課長、〇〇キャンペーンのLP開発の依頼です。経営陣も期待しているプロジェクトなので、ご対応をお願いします」","correct":"A"},"furumai":{"A":"相手の都合を先に聞き、こちらの要件を共有した上で「一緒にスケジュールを調整できないか」と提案する","B":"「この企画は全社的に意味があるんです！関係各位にも説明しますよ！」と、どんどん人が増える方向に話を広げる","C":"「いつでもいいので、時間がある時にでも」と、相手の都合に完全に委ねる","D":"まず自分の上長に話をして、正式なルートで依頼をかける","correct":"A"},"result":"A + A","naze":"他部署への依頼は、社内とはいえ**「相手にも相手の仕事がある」**ことが前提。まず「お忙しいところ恐れ入ります」と相手の状況を認めることで、「こちらの事情を押し付けるつもりはない」というサインになる。\n\n「ご相談がございます」という言葉で、一方的な依頼ではなく**双方向の話し合いの姿勢**を示せている。相手の都合を聞きつつ、自分の希望も明確に伝える。このバランスが協力を得やすい。","otoshiana":"ENFJは**「関係者を巻き込もうとして、話が大きくなりすぎる・調整過多」**になることがある。Bの対応はまさにそのパターン。「全社的に意味がある」「関係各位にも説明します」と、一人でドンドン話を大きくしてしまう。\n\nもう一つ注意。ENFJは**「みんなでワイワイ進めるのがうまくいく」と思いがち**だけど、忙しい他部署の人にとっては「関係者が増える＝調整コストが増える」という負担に感じられる。まずは「私と山田課長」の小さな話し合いから始める。必要があれば後で広げる、くらいのスタンスが丁度いい。","hint":"**他部署への依頼の基本パターン：**\n1. 「お忙しいところ恐れ入ります」（相手の状況を認める）\n2. 「〇〇の件でご相談がございます」（「お願い」より「相談」が良い）\n3. 「まずは今の状況を教えていただけますか」（相手の都合を先に聞く）\n\n**言い換え例：**\n- ×「きっとプラスになりますよ！全社的にも意味があるんで！」（話が大きすぎる）\n- 〇「〇日が理想ですが、山田課長のスケジュールに合わせて調整できます」（柔軟性を示す）","more":"ENFJの**「人を巻き込む力」**は、組織を動かす上で強力な武器。ただ、この場面では**「シンプルに頼む」**ことが相手への配慮にもつながりやすい。関係者の数を最小限に抑えることも、相手への思いやり。まずは1対1で核心を話して、必要な時だけスケールアップする。この「最小限の巻き込み」もまた、ENFJの調整力の活かし方。"}},"INFJ":{"1":{"situation":"あなたは社内プロジェクトのリーダーを任されている。\n来週金曜が納期の重要な成果物について、協力会社からの納品遅延が判明。全体スケジュールが3日ほど後ろ倒しになる見込みだ。\n\n田中部長（プロジェクト責任者）にこの事実を報告し、今後の対応を相談しなければならない。","kiridashi":{"A":"「部長、今お時間よろしいでしょうか。〇〇プロジェクトについて、ご報告とご相談がございます」","B":"「部長…お忙しいとは思うんですが…その…〇〇プロジェクトの件で、ちょっと気になってることがあって…」","C":"「部長、あの…あまり急ぎの話ではないんですけど…〇〇の件で…」","D":"「部長！〇〇プロジェクトなんですけど、実は大変なことになってて…！」","correct":"A"},"furumai":{"A":"落ち着いて事実を簡潔に伝え、「こう対応したいと考えているが、ご意見を伺いたい」と相談する","B":"部長の表情を気にしながら、遅延の事実を小出しにして徐々に伝える","C":"「何とか自分で解決しようと思ったんですが…」と、助けを求める形で伝える","D":"協力会社の遅延について感情的に「信じられない」と怒りを示す","correct":"A"},"result":"A + A","naze":"「今お時間よろしいでしょうか」は、相手の状況を尊重する基本の切り出し。田中部長は多忙な管理職だから、いきなり本題に入られると心の準備ができていない。\n\n「ご報告とご相談がございます」と伝えることで、**話の目的を先に示して、相手に受け止める準備を促せる**。悪い報告でも受け入れられやすくなる。落ち着いて事実を伝えつつ、対策案も一緒に示すのが信頼につながりやすい。","otoshiana":"INFJは**「相手の反応を過剰に気にして、核心を伝えるのをためらう」**傾向がある。Bの切り出し方はまさにそのパターン。言い方をあれこれ考えすぎて、結局どう伝えるか迷ってしまう。\n\nもう一つ注意。INFJは**「部長をがっかりさせたくない」という思いから、報告自体をためらう**ことがある。でも、遅延の事実は早く伝えるほど对策の余地が広がる。完璧な言い方を探すより、早くシンプルに伝える方が信頼につながりやすい。","hint":"**悪い報告の3ステップ切り出し：**\n1. 「今お時間よろしいでしょうか」（タイミングの確認）\n2. 「ご報告とご相談がございます」（目的の提示）\n3. 「実は〜」（本題に入る）\n\n**言い換え例：**\n- ×「あの…ちょっと気になってることが…」（ぼかしすぎ）\n- 〇「スケジュールに影響が出る件がございまして、ご相談がございます」（明確に目的を示す）","more":"報連相の基本原則は**「悪い報告ほど早く、でも丁寧に」**。INFJの強みである「相手の気持ちを想像する力」は、言い方を工夫する際にとても役立つ。でも、その感受性が裏目に出ると**「言いにくさ」が「遅れ」に変わってしまう**。感情の配慮と事実の速報のバランスを意識するのがおすすめ。このスキルは**アサーティブコミュニケーション**（自己主張と相手配慮の両立）と呼ばれている。"},"2":{"situation":"あなたは新規プロジェクトのメンバーとして参加している。\n同僚の佐藤さんが担当しているデザイン作業の進捗が予定より遅れており、このままではあなたの担当領域（フロントエンド実装）の着手にも影響が出そうだ。\n\n佐藤さんに状況を確認し、どう進めるか話し合いたい。","kiridashi":{"A":"「佐藤さん、今ちょっといいかな。プロジェクトの進捗について、確認と相談があるんだけど」","B":"「佐藤さん、最近お忙しそうですよね…デザインの件、もし何か手伝えることがあれば言ってください」","C":"「佐藤さん…あの…デザインの進捗についてなんですけど…あまり急かしたくないんですが…」","D":"「佐藤さん、デザインの進捗どうですか？スケジュール的にかなり厳しいと思うんですが」","correct":"A"},"furumai":{"A":"相手の状況を先に聞き、「どう進めるのがお互いにとって良いか」を一緒に考える","B":"相手が悩んでいそうなら励まし、自分が少し我慢して待ってあげる","C":"遠慮がちに「いつ頃できそう？」とだけ聞いて、あとは相手に任せる","D":"「デザインが遅れると実装も遅れるんで、なんとかお願いします」と督促する","correct":"A"},"result":"A + A","naze":"同僚関係は上下関係ではない。対等な立場だからこそ、「確認と相談」という言葉で**相手を責めるのではなく、一緒に考える姿勢**を見せることが大切。\n\nいきなり「遅れてる」「厳しい」と事実を突きつけられると、相手は防御的になる。まずは相手の事情を聞くことで、本当のボトルネックが見えてくる。お互いにとって良い着地点を探るのがプロフェッショナルな働き方につながりやすい。","otoshiana":"INFJは**「相手を傷つけないように遠回しすぎて、問題が伝わらない」**ことがある。BやCの切り出し方はまさにそのパターン。「手伝えることがあれば」と言うのは優しいけど、実際には「進捗が遅れて困っている」ことが伝わらない。\n\nもう一つ注意。INFJは**相手の気持ちを汲み取るのが得意だからこそ、相手が悩んでいると感じると「聞く」ことにとどまってしまう**。でも、この場面で必要なのは励ましではなく、具体的な進め方の合意。「気遣い」と「課題解決」は別物だと意識するのがおすすめ。","hint":"**同僚への「確認＋相談」の基本パターン：**\n1. 「今ちょっといいかな」（タイミング確認）\n2. 「〇〇の件で、確認と相談があるんだけど」（目的を先に伝える）\n3. 「今どんな状況か教えてもらえる？」（相手の状況を先に聞く）\n\n**言い換え例：**\n- ×「お忙しそうですが…手伝えることがあれば…」（本題が見えない）\n- 〇「デザインの進捗を確認したいんだけど、今どんな感じ？」（直接的＋配慮）","more":"この場面で使えるのが**「水平型コミュニケーション」**。上下関係ではなく対等な関係性で課題を解決するアプローチ。INFJは相手の気持ちに敏感な分、「対等に意見を言う」ことが苦手になりがち。でも、**本音を遠慮せずに伝えること**も、相手への信頼の証。優しさと明確さは両立できる。"},"3":{"situation":"あなたはチームのサブリーダー。入社2年目の後輩・高橋さんが、クライアント向けの提案資料に複数のデータミスを混入させてしまった。\n幸い提出前にあなたが発見したが、高橋さんにはミスの原因を理解してもらい、同じ間違いを繰り返さないように指導したい。","kiridashi":{"A":"「高橋さん、提出前の資料チェックしてて気になった点があったんだけど、ちょっと見てくれる？」","B":"「高橋さん…資料なんだけど…あの…あまり気に病まないでほしいんだけど、いくつか気になる点があって…」","C":"「高橋さん、この資料なんだけど…俺が勝手に直しておいたから、大丈夫だよ」","D":"「高橋さん、この資料のデータ、全部間違ってるよ。どうなってるの？」","correct":"A"},"furumai":{"A":"具体的にどこが違うかを示し、「どうやって確認したか教えてくれる？」と原因を一緒に考える","B":"高橋さんが落ち込まないよう、「誰でもやるミスだよ」「気にしなくていいよ」と励ましに徹する","C":"間違っていた箇所を優しく指摘するだけで、なぜ間違えたかは深く聞かない","D":"「確認の手順書を作ったから、今後はこれに従って」とマニュアルで管理する","correct":"A"},"result":"A + A","naze":"「気になった点がある」という言い方は、ミスを**「指摘」ではなく「一緒に確認」**というフレームに変えている。後輩が防御的になるのを防げる。\n\n「ちょっと見てくれる？」と問いかけ形にすることで、相手に自分で気づく機会を与えている。自分で見つけたミスの方が、次から意識に残りやすい。その上で「どうやって確認した？」と原因を一緒に考えるのが、再発防止につながりやすい。","otoshiana":"INFJは**「後輩の感受性を気遣いすぎて、必要な指摘が甘くなる」**ことがある。BやCの対応はまさにそのパターン。「気に病まないで」「俺が直しておいた」と優しさで包むのは心地いいけど、高橋さんは「何が間違っていたのか」「なぜ起きたのか」に向き合う機会を失ってしまう。\n\nもう一つ注意。INFJは**「相手が傷つく姿を想像してしまって、本質的な指摘を避ける」**傾向がある。でも、今の優しさが将来の大きなミスを防ぐための「厳しさ」になる。優しさと甘やかしは違う。ちゃんと向き合うことも、相手を大切にする証拠。","hint":"**後輩へのフィードバックの基本パターン：**\n1. 「ちょっと見てくれる？」（共に確認する姿勢）\n2. 「ここ、〇〇と××で数字が違うね」（事実を具体的に指摘）\n3. 「どうやって確認したか教えてもらえる？」（プロセスを一緒に振り返る）\n\n**言い換え例：**\n- ×「俺が直しておいたから大丈夫だよ」（学習機会を奪う）\n- 〇「ここ、元のデータと数字が違うんだけど、どこから持ってきたか一緒に見てみよう」（一緒に考える姿勢）","more":"後輩指導で意識したいのが**「コーチング」**の考え方。答えを教えるのではなく、質問で相手の思考を引き出すアプローチ。INFJは相手の感情に敏感だから、安心できる場を作るのは得意。その安心感をベースに**「どうやって確認した？」「どこで違ったと思う？」**と問いかけることで、後輩自身が気づきを得られる。「TeachではなくAsk」の原則は、INFJの共感力と相性が良い。"},"4":{"situation":"あなたはWeb制作会社のプロジェクトマネージャー。\nクライアントの鈴木社長から「納品前に機能を追加したい」という要望が入った。仕様は既に確定し、追加費用の予算はない。\n\n追加費用なしでは対応が難しいが、クライアントとの関係も悪くしたくない。鈴木社長に対応方針を伝える必要がある。","kiridashi":{"A":"「鈴木社長、ご要望ありがとうございます。一度内容を整理させていただき、改めてご提案してもよろしいでしょうか」","B":"「鈴木社長、ご要望の意図はとてもよく分かります。ただ…社内で確認してみないと何とも言えなくて…何とかお力になれる方法を探してみます」","C":"「鈴木社長…その機能、仕様には含まれていないので…予算の都合もあって…その…」","D":"「鈴木社長、その機能は今回のスコープ外ですので、別途お見積もりになります」","correct":"A"},"furumai":{"A":"相手の要望の背景を質問で深掘りし、本当に必要なものを一緒に整理した上で、現実的な提案を行う","B":"クライアントの期待に応えたい気持ちから、「何とか工夫して対応できないか検討します」と安請け合いしそうになる","C":"断るのが申し訳なくて、話題を変えようとする","D":"契約の条文を提示し、「仕様確定後の追加はルール上できません」と説得する","correct":"A"},"result":"A + A","naze":"クライアントの要望をまず受け止めることが出発点。「ありがとうございます」で相手の提案を尊重しつつ、「整理して改めてご提案」と**即答を避けて考える時間を確保**している。\n\n即座に「追加費用が必要です」と断ると、相手は突き放されたと感じる。まず相手の真のニーズを理解してから、一緒に解決策を探るのがおすすめ。INFJの洞察力は、ここで本当の課題を見抜くことに活かせる。","otoshiana":"INFJは**「クライアントの気持ちを汲み取りすぎて、自社の利益を損なう」**ことがある。Bの対応はまさにそのパターン。「何とかお力になれる方法を探します」と言ってしまうと、後で自社のリソースを割くことになり、結果的に自分もチームも苦しくなる。\n\nもう一つ注意。INFJは**「相手をがっかりさせたくない」という思いが強すぎて、明確な「ノー」を言えない**。「検討します」は便利な言葉だけど、期待を持たせたまま結論を引き延ばすと、後で関係がより悪くなる。誠実に線を引くことも、長期的な信頼には必要。","hint":"**クライアントの追加要望への3ステップ：**\n1. 「ありがとうございます／ご要望、承知しました」（まず受け止める）\n2. 「少し具体的に教えても良いですか？ どういう場面で使いたいかなど」（背景を深掘り）\n3. 「整理して、〇日までにご提案します」（即答せず時間をもらう）\n\n**言い換え例：**\n- ×「何とか工夫して…お力になれる方法を…」（安請け合い）\n- 〇「ご要望の背景を教えていただければ、ベストな提案ができます」（協力の姿勢＋明確な線引き）","more":"この場面で鍵になるのが**「ニーズの背後にあるニーズ」**を探るスキル。INFJの強みである洞察力は、ここで存分に発揮できる。顧客が「機能が欲しい」と言うとき、本当は「不安を解消したい」「競合に遅れを取りたくない」など別の理由があることが多い。その奥にある課題を解決する提案ができると、追加費用なしでも満足してもらえることがある。"},"5":{"situation":"あなたはマーケティング部門のメンバー。来月実施するキャンペーンの企画が承認されたが、実行にはシステム部門の協力（LPの開発とサーバー準備）が必要だ。\n\nシステム部門は今、自社サービスの大型リリース準備で忙しいと聞いている。システム部門の山田課長に協力を依頼しなければならない。","kiridashi":{"A":"「山田課長、お忙しいところ恐れ入ります。マーケティングの〇〇キャンペーンの件で、ご相談がございます」","B":"「山田課長…システム部門いま忙しいとお聞きしてるんですが…実はお願いがあって…でも無理なら言ってください」","C":"「山田課長、お忙しいと思いますので、お時間ができた頃にでもお話しできればと…」","D":"「山田課長、〇〇キャンペーンのLP開発をお願いします。期限は来月の〇日です」","correct":"A"},"furumai":{"A":"相手の都合を先に聞き、こちらの要件を共有した上で「一緒にスケジュールを調整できないか」と提案する","B":"相手が忙しいことを理由に、最低限のことだけお願いしようとする","C":"「いつ頃なら可能でしょうか」と相手の都合に完全に委ね、自分の希望は言わない","D":"「うちの部長からもお願いしてもらえますか」と上長ルートに頼る","correct":"A"},"result":"A + A","naze":"他部署への依頼は、社内とはいえ**「相手にも相手の仕事がある」**ことが前提。まず「お忙しいところ恐れ入ります」と相手の状況を認めることで、「こちらの事情を押し付けるつもりはない」というサインになる。\n\n「ご相談がございます」という言葉で、一方的な依頼ではなく**双方向の話し合いの姿勢**を示せている。相手の都合を聞きつつ、自分の希望も明確に伝える。このバランスが協力を得やすい。","otoshiana":"INFJは**「他部署の事情を察しすぎて、必要な依頼ができない・遅れる」**ことがある。BやCの切り出し方はまさにそのパターン。相手が忙しいと聞くと、「今は頼むべきじゃないかも」と遠慮してしまう。\n\nもう一つ注意。INFJは**「相手に負担をかけたくない」という思いから、依頼内容を小さく小さくしてしまう**。「最低限これだけ」でも、本来必要なことを全部伝えないと、後で不十分な状態で進むことになる。相手に負担をかけない配慮は立派だけど、まずは必要なことを全部伝えて、それから一緒に調整するのが基本の順番。","hint":"**他部署への依頼の基本パターン：**\n1. 「お忙しいところ恐れ入ります」（相手の状況を認める）\n2. 「〇〇の件でご相談がございます」（「お願い」より「相談」が良い）\n3. 「まずは今の状況を教えていただけますか」（相手の都合を先に聞く）\n\n**言い換え例：**\n- ×「忙しいだろうけど…無理なら言ってください…」（遠慮しすぎ）\n- 〇「〇日が理想ですが、山田課長のスケジュールに合わせて調整できます」（柔軟性を示す）","more":"他部署との協力で意識したいのが**「組織横断的コミュニケーション」**のスキル。INFJは相手の状況を想像するのが得意だから、相手の優先事項を理解するのは得意なはず。その強みを**「遠慮」ではなく「戦略的な配慮」**に活かすのがおすすめ。相手の都合を理解した上で、自分の要件もちゃんと伝える。これが「配慮のある自己主張」であり、まさにアサーティブな姿勢。"}},"INFP":{"1":{"situation":"あなたは社内プロジェクトのリーダーを任されている。\n来週金曜が納期の重要な成果物について、協力会社からの納品遅延が判明。全体スケジュールが3日ほど後ろ倒しになる見込みだ。\n\n田中部長（プロジェクト責任者）にこの事実を報告し、今後の対応を相談しなければならない。","kiridashi":{"A":"「部長、今お時間よろしいでしょうか。〇〇プロジェクトについて、ご報告とご相談がございます」","B":"「部長…あの…〇〇プロジェクトの件なんですけど…私のせいではないんですが…協力会社が遅れていて…」","C":"「部長、あの…もし今後の対応として…理想的な進め方を考えてみたんですが…聞いてもらえますか」","D":"「部長！大変です！〇〇プロジェクト、納期がヤバい状況になってて…！」","correct":"A"},"furumai":{"A":"落ち着いて事実を簡潔に伝え、「こう対応したいと考えているが、ご意見を伺いたい」と相談する","B":"自分の責任ではないことを先に説明し、それから協力会社の事情を長く語る","C":"まず理想の解決策を情熱的に語ってから、遅延の事実を伝える","D":"部長の反応を伺いながら、相手が聞きたい順番に情報を出していく","correct":"A"},"result":"A + A","naze":"「今お時間よろしいでしょうか」は、相手の状況を尊重する基本の切り出し。田中部長は多忙な管理職だから、いきなり本題に入られると心の準備ができていない。\n\n「ご報告とご相談がございます」と伝えることで、**話の目的を先に示して、相手に受け止める準備を促せる**。事実を簡潔に伝えてから相談に移る。この王道パターンが、どんなタイプの上司にも響きやすい。","otoshiana":"INFPは**「どう思われるか」を気にしすぎて行動が遅れる**傾向がある。Bの切り出し方はまさにそのパターン。「私のせいではないんですが」と自己防衛が先に出てしまうのは、「部長に責められるかも」と不安だから。\n\nもう一つ注意。INFPは**「本音と建前で揺れる」**傾向がある。「早く報告すべき」と分かっていても、「部長がどう反応するか」を考えすぎて、タイミングを逃してしまう。完璧な言い回しを探すより、事実をシンプルに伝える勇気が信頼の土台になる。","hint":"**悪い報告の3ステップ切り出し：**\n1. 「今お時間よろしいでしょうか」（タイミングの確認）\n2. 「ご報告とご相談がございます」（目的の提示）\n3. 「実は〜」（本題に入る）\n\n**言い換え例：**\n- ×「私のせいではないんですが…」（自己防衛が先）\n- 〇「スケジュールに影響が出る件がございまして、ご相談がございます」（事実を先に）","more":"INFPは「自分の価値観に沿って行動したい」という強い思いがある。報連相の場面でも、「誠実に伝えたい」「正当に評価されたい」という気持ちが先行しがち。でも、**「事実を素早く伝えること」自体が誠実さの表れ**になることもある。このバランスを意識すると、報連相がぐっとラクになる。"},"2":{"situation":"あなたは新規プロジェクトのメンバーとして参加している。\n同僚の佐藤さんが担当しているデザイン作業の進捗が予定より遅れており、このままではあなたの担当領域（フロントエンド実装）の着手にも影響が出そうだ。\n\n佐藤さんに状況を確認し、どう進めるか話し合いたい。","kiridashi":{"A":"「佐藤さん、今ちょっといいかな。プロジェクトの進捗について、確認と相談があるんだけど」","B":"「佐藤さん、あの…デザインの件なんだけど…別に急かしてるわけじゃないんですけど…もし何か困ってたら聞くからね」","C":"「佐藤さん…デザインの進捗、大丈夫かなって思って…無理しないでね」","D":"「佐藤さん、このままじゃスケジュール本当に厳しいよ。どうするつもり？」","correct":"A"},"furumai":{"A":"相手の状況を先に聞き、「どう進めるのがお互いにとって良いか」を一緒に考える","B":"相手の気持ちを気遣って、「いつでもいいから」「無理しないで」と譲歩し、自分が我慢して待つ","C":"相手がなんとかしてくれると信じて、もう少し様子を見る","D":"自分の不満を感情的にぶつける","correct":"A"},"result":"A + A","naze":"同僚関係は上下関係ではない。対等な立場だからこそ、「確認と相談」という言葉で**相手を責めるのではなく、一緒に考える姿勢**を見せることが大切。\n\n「今どんな状況？」と相手の事情を聞くことで、本当のボトルネックが見えてくる。自分の困っていることも正直に伝えつつ、協力して進め方を決める。これが同僚として信頼されやすいスタンス。","otoshiana":"INFPは**「対立を恐れて本音を言えず、自分が我慢する。後で不満が溜まる」**ことがある。BやCの対応はまさにそのパターン。「急かしてるわけじゃない」「無理しないで」と配慮するのは心地いいけど、実際には「遅れていて困っている」という自分の本音を伝えられていない。\n\nもう一つ注意。INFPは**「自分が我慢すれば波風が立たない」と思いがち**だけど、我慢し続けた不満はいつか爆発する。小さなうちに正直に伝える方が、関係性を守ることにつながる。本音を言うことは、相手への信頼の証でもある。","hint":"**同僚への「確認＋相談」の基本パターン：**\n1. 「今ちょっといいかな」（タイミング確認）\n2. 「〇〇の件で、確認と相談があるんだけど」（目的を先に伝える）\n3. 「今どんな状況か教えてもらえる？」（相手の状況を先に聞く）\n\n**言い換え例：**\n- ×「急かしてるわけじゃないけど…別に…」（本音が見えない）\n- 〇「デザインの進捗を確認したいんだけど、今どんな感じ？」（直接的＋配慮）","more":"INFPの強みは**「相手の気持ちがわかる」**共感力。でも、その共感力が裏目に出ると**「言うべきことを言えない」**ことになる。共感力と発言力は両立できる。「あなたの状況も理解できるし、私の状況も伝えたい」。この両方を大切にする姿勢が、**アサーティブ・コミュニケーション**の基本。"},"3":{"situation":"あなたはチームのサブリーダー。入社2年目の後輩・高橋さんが、クライアント向けの提案資料に複数のデータミスを混入させてしまった。\n幸い提出前にあなたが発見したが、高橋さんにはミスの原因を理解してもらい、同じ間違いを繰り返さないように指導したい。","kiridashi":{"A":"「高橋さん、提出前の資料チェックしてて気になった点があったんだけど、ちょっと見てくれる？」","B":"「高橋さん…大丈夫だよ、誰でもミスするから…でも次から気をつけてね」","C":"「高橋さん…あの…資料なんですけど…俺が確認したらちょっと…直しておいたから…」","D":"「高橋さん、この資料、確認した？データの整合性が取れてないよ」","correct":"A"},"furumai":{"A":"具体的にどこが違うかを示し、「どうやって確認したか教えてくれる？」と原因を一緒に考える","B":"高橋さんが落ち込んでいないか気にして、「辛かったね」「プレッシャーかかったよね」と感情的にサポートする","C":"間違っていた箇所を指摘するが、高橋さんが悲しそうだとすぐ話題を変える","D":"「なんでこんなミスしたの？」と感情的に問い詰める","correct":"A"},"result":"A + A","naze":"「気になった点がある」という言い方は、ミスを**「指摘」ではなく「一緒に確認」**というフレームに変えている。後輩が防御的になるのを防げる。\n\n「ちょっと見てくれる？」と問いかけ形にすることで、相手に自分で気づく機会を与えている。自分で見つけたミスの方が、次から意識に残りやすい。その上で原因を一緒に考えることで、再発防止につながる。","otoshiana":"INFPは**「後輩を感情的にサポートすることに注力しすぎて、実務的な指導が甘い」**ことがある。Bの対応はまさにそのパターン。「大丈夫だよ」「誰でもミスするから」は優しい言葉だけど、何が間違っていて、なぜ起きたのか、どう防ぐのか、という実務面がスッポリ抜け落ちている。\n\nもう一つ注意。INFPは**「相手が悲しむ姿を見たくない」**あまり、核心的な指摘を避けてしまう。でも、今ちゃんと指摘することが、高橋さんを守ることにつながる。優しさには時に「言うべきことを言う」という形もある。","hint":"**後輩へのフィードバックの基本パターン：**\n1. 「ちょっと見てくれる？」（共に確認する姿勢）\n2. 「ここ、〇〇と××で数字が違うね」（事実を具体的に指摘）\n3. 「どうやって確認したか教えてもらえる？」（プロセスを一緒に振り返る）\n\n**言い換え例：**\n- ×「大丈夫だよ、誰でもミスするから」（実務的な指摘がない）\n- 〇「ここ、元のデータと数字が違うんだけど、どこから持ってきたか一緒に見てみよう」（一緒に考える姿勢）","more":"INFPの強みである感情のサポートは、後輩指導でも最初の一歩としてとても大事。「安心できる場を作る」のはINFPの得意分野。でも、**安心の次のステップとして「事実を整理する」「原因を考える」「対策を決める」**という実務プロセスをセットにするのがおすすめ。感情のキャッチボールと課題のキャッチボール、両方できるとより良い指導になる。"},"4":{"situation":"あなたはWeb制作会社のプロジェクトマネージャー。\nクライアントの鈴木社長から「納品前に機能を追加したい」という要望が入った。仕様は既に確定し、追加費用の予算はない。\n\n追加費用なしでは対応が難しいが、クライアントとの関係も悪くしたくない。鈴木社長に対応方針を伝える必要がある。","kiridashi":{"A":"「鈴木社長、ご要望ありがとうございます。一度内容を整理させていただき、改めてご提案してもよろしいでしょうか」","B":"「鈴木社長、その追加機能、素晴らしいアイデアですね！ぜひ実現したいですね、ちょっとチームと工夫してみます！」","C":"「鈴木社長…その機能、今の予算だとちょっと…でも鈴木社長がどうしてもというなら…」","D":"「鈴木社長、それは仕様外の要望ですので、正式な変更申請をしていただく必要がございます」","correct":"A"},"furumai":{"A":"相手の要望の背景を質問で深掘りし、本当に必要なものを一緒に整理した上で、現実的な提案を行う","B":"クライアントの熱意に共感しすぎて、「何とか予算内で工夫してみます」と安請け合いする","C":"断るのが申し訳なくて、黙って引き受けて後で社内で悩む","D":"冷静に追加費用の内訳を説明し、理性的な判断を促す","correct":"A"},"result":"A + A","naze":"クライアントの要望をまず受け止めることが出発点。「ありがとうございます」で相手の提案を尊重しつつ、「整理して改めてご提案」と**即答を避けて考える時間を確保**している。\n\n即座に「できます！」と安請け合いすると後で苦しくなる。かといって即座に断ると関係が悪くなる。まずは相手の真のニーズを深掘りして、現実的な着地点を一緒に探るのが誠実な対応につながりやすい。","otoshiana":"INFPは**「クライアントに共感しすぎて、安請け合いしてしまう」**ことがある。Bの対応はまさにそのパターン。「素晴らしいアイデアですね」「工夫してみます」と、相手の熱意に引っ張られてしまう。\n\nもう一つ注意。INFPは**「相手の期待に応えたい」という思いが強く、断ることに罪悪感を感じやすい**。でも、安請け合いして後で実現できなかった時のダメージは、最初に正直に伝えるよりずっと大きい。一時的な罪悪感より、長期的な信頼を大切にするのがおすすめ。","hint":"**クライアントの追加要望への3ステップ：**\n1. 「ありがとうございます／ご要望、承知しました」（まず受け止める）\n2. 「少し具体的に教えても良いですか？ どういう場面で使いたいかなど」（背景を深掘り）\n3. 「整理して、〇日までにご提案します」（即答せず時間をもらう）\n\n**言い換え例：**\n- ×「ぜひ実現したいですね！工夫してみます！」（安請け合い）\n- 〇「ご要望の背景を教えていただければ、ベストな提案ができます」（協力の姿勢＋時間をもらう）","more":"INFPの共感力は、クライアントの「本当の困りごと」を理解する強力な武器。ただし**「共感」と「承諾」は別物**。「あなたの気持ちはわかります」と「はい、できます」を分けて考えるのがおすすめ。共感は無料でいくらでもできる。でも、約束にはリソースが伴う。この違いを意識するだけで、ビジネスでの自分を守りながら関係も築ける。"},"5":{"situation":"あなたはマーケティング部門のメンバー。来月実施するキャンペーンの企画が承認されたが、実行にはシステム部門の協力（LPの開発とサーバー準備）が必要だ。\n\nシステム部門は今、自社サービスの大型リリース準備で忙しいと聞いている。システム部門の山田課長に協力を依頼しなければならない。","kiridashi":{"A":"「山田課長、お忙しいところ恐れ入ります。マーケティングの〇〇キャンペーンの件で、ご相談がございます」","B":"「山田課長…システム部門いま忙しいって聞いてるんですが…あの…実はお願いしたいことがあって…でも無理だったら全然いいんです」","C":"「山田課長、お忙しいと思いますので、メールで概要だけ送らせていただきますね。お時間ある時にでも…」","D":"「山田課長、マーケティングのキャンペーンのLP開発をお願いしたいです。来月までにお願いできますか？」","correct":"A"},"furumai":{"A":"相手の都合を先に聞き、こちらの要件を共有した上で「一緒にスケジュールを調整できないか」と提案する","B":"相手の雰囲気に圧倒されて、お願いしたいことを全部言いきれずに終わる","C":"相手が忙しそうなので、最低限のことだけ口頭で伝えて、詳細はまた今度にする","D":"自分の企画の素晴らしさを情熱的に語って、相手を巻き込もうとする","correct":"A"},"result":"A + A","naze":"他部署への依頼は、社内とはいえ**「相手にも相手の仕事がある」**ことが前提。まず「お忙しいところ恐れ入ります」と相手の状況を認めることで、「こちらの事情を押し付けるつもりはない」というサインになる。\n\n「ご相談がございます」という言葉で、一方的な依頼ではなく**双方向の話し合いの姿勢**を示せている。相手の都合も尊重しつつ、自分の希望も明確に伝える。このバランスが、協力を得やすくなる。","otoshiana":"INFPは**「相手の雰囲気に圧倒されて、必要なお願いができない」**ことがある。BやCの対応はまさにそのパターン。山田課長が忙しそうにしていると、「今はダメだ」と空気を読んで引いてしまう。\n\nもう一つ注意。INFPは**「断られるのが怖い」という思いから、依頼そのものを先延ばしにしがち**。「無理だったら全然いいんです」という言葉は、自分を守るための保険だけど、逆に「そこまで重要じゃないんだな」と受け取られてしまう。本当に必要なことだからこそ、堂々とお願いするのがおすすめ。","hint":"**他部署への依頼の基本パターン：**\n1. 「お忙しいところ恐れ入ります」（相手の状況を認める）\n2. 「〇〇の件でご相談がございます」（「お願い」より「相談」が良い）\n3. 「まずは今の状況を教えていただけますか」（相手の都合を先に聞く）\n\n**言い換え例：**\n- ×「無理だったら全然いいんで…」（重要度が伝わらない）\n- 〇「〇日が理想ですが、山田課長のスケジュールに合わせて調整できます」（柔軟性を示す）","more":"INFPは「空気を読む」のが得意だけど、**「空気を読むこと」と「空気に従うこと」は違う**。相手が忙しそうなのは事実として読み取る。でも、それに加えて「自分の要件も伝える」という行動をとる。この**「読む＋行動」のセット**が、ビジネスでのINFPの強みになる。"}},"ESFP":{"1":{"situation":"あなたは社内プロジェクトのリーダーを任されている。\n来週金曜が納期の重要な成果物について、協力会社からの納品遅延が判明。全体スケジュールが3日ほど後ろ倒しになる見込みだ。\n\n田中部長（プロジェクト責任者）にこの事実を報告し、今後の対応を相談しなければならない。","kiridashi":{"A":"「部長、今お時間よろしいでしょうか。〇〇プロジェクトについて、ご報告とご相談がございます」","B":"「部長！お疲れ様ですー！あ、そうそう、〇〇プロジェクトの件なんですけどね〜、ちょっと遅れちゃってて…でもまあ大丈夫ですよ！」","C":"「部長…お忙しいところ申し訳ないんですが…〇〇の件で、ちょっとご相談が…」","D":"「部長、〇〇プロジェクトの進捗について、会議室でお話しさせてください」","correct":"A"},"furumai":{"A":"資料を手に持ち、相手の目を見て、落ち着いた声ではじめる","B":"報告の前に「最近どうですか〜？」と雑談から入り、その流れで明るく遅延を伝える","C":"姿勢を低くし、申し訳なさそうな表情で切り出す","D":"笑顔で「まあなんとかなりますよ！」とポジティブに切り抜けようとする","correct":"A"},"result":"A + A","naze":"「今お時間よろしいでしょうか」は、相手の状況を尊重する基本の切り出し。田中部長は多忙な管理職だから、いきなり本題に入られると心の準備ができていない。\n\n「ご報告とご相談がございます」と伝えることで、**話の目的を先に示して、相手に受け止める準備を促せる**。悪い報告は明るい雰囲気で伝えると、深刻さが伝わらない。まずはシンプルに。","otoshiana":"ESFPは**「場を明るくする」**のが得意。でもBの切り出し方は注意したいパターン。雑談の流れで悪い報告をさらっと伝えると、部長は「え、それマジで？」と困惑する。深刻さが伝わらないと、対応が遅れて事態が悪化する。\n\nもう一つ注意。ESFPは**「なんとかポジティブに終わらせたい」**から、Dのように「なんとかなりますよ！」と明るく振る舞う。でも悪い報告は、事実としてきちんと重みを伝えることが相手への誠意。空気を良くするのは報告の後で構わない。","hint":"**悪い報告の3ステップ切り出し：**\n1. 「今お時間よろしいでしょうか」（タイミングの確認）\n2. 「ご報告とご相談がございます」（目的の提示）\n3. 「実は〜」（本題に入る）\n\n**言い換え例：**\n- ×「大丈夫ですよ、なんとかなります！」（深刻さが伝わらない）\n- 〇「スケジュールに影響が出る件がございまして、ご相談させてください」（事実をきちんと）","more":"ESFPの**「ポジティブな雰囲気」**は、悪い報告の後こそ活きる。「遅延は判明しましたが、ここから挽回するプランをご一緒に考えたいんです」と伝えれば、問題報告なのに前向きな印象になる。コツは**「事実はシリアスに、対策はポジティブに」**。報告の内容と伝え方のトーンを分けて考えると、ESFPの明るさが効果的に活きる。"},"2":{"situation":"あなたは新規プロジェクトのメンバーとして参加している。\n同僚の佐藤さんが担当しているデザイン作業の進捗が予定より遅れており、このままではあなたの担当領域（フロントエンド実装）の着手にも影響が出そうだ。\n\n佐藤さんに状況を確認し、どう進めるか話し合いたい。","kiridashi":{"A":"「佐藤さん、今ちょっといいかな。プロジェクトの進捗について、確認と相談があるんだけど」","B":"「佐藤さーん！お疲れー！あ、そうそう、デザインの進捗どう？まあ焦んなくていいよー！」","C":"「佐藤さん…お忙しいと思いますが…デザインの件でちょっと気になってて…」","D":"「佐藤さん、デザインの進捗どうなってる？ みんな待ってるよ」","correct":"A"},"furumai":{"A":"まず相手の状況を聞き、「一緒に進め方を考えたい」と協力姿勢を示す","B":"「大丈夫だよー！応援してる！」と励ますだけで、具体的な進め方の話をしない","C":"「いつ頃できそう？」と相手のペースに任せる","D":"「手伝おうか？」と相手の作業に直接介入する","correct":"A"},"result":"A + A","naze":"同僚関係は上下関係ではない。対等な立場だからこそ、「確認と相談」という言葉で**相手を責めるのではなく、一緒に考える姿勢**を見せることが大切。\n\nまずは相手の事情を聞くことで、本当のボトルネックが見えてくる。励ますのも大切だけど、問題の核心に向き合わないと解決しない。","otoshiana":"ESFPは**「雰囲気を明るく保つ」**ことに注力しすぎる。Bの対応はまさにそのパターン。「焦んなくていいよー」「応援してる！」は優しいけど、具体的な問題解決に一切触れていない。佐藤さんは「気遣ってくれた」で終わり、進捗の課題は放置される。\n\nもう一つ注意。ESFPは**「人との関係を良好に保ちたい」**あまり、Cのように遠慮しすぎたり、逆にDのように場を盛り上げようとして「みんな待ってるよ」と無意識にプレッシャーをかけたりする。バランスを意識すると良い。","hint":"**同僚への「確認＋相談」の基本パターン：**\n1. 「今ちょっといいかな」（タイミング確認）\n2. 「〇〇の件で、確認と相談があるんだけど」（目的を先に伝える）\n3. 「今どんな状況か教えてもらえる？」（相手の状況を先に聞く）\n\n**言い換え例：**\n- ×「焦んなくていいよー！応援してる！」（問題の先送り）\n- 〇「一緒にスケジュール調整できないかな」（協力の招待）","more":"ESFPの**「人を励ます力」**は、チームの士気維持に不可欠。ただし**「励ます」と「解決する」は別のステップ**。まずは問題の事実を確認し、解決策を一緒に考える。その後で「一緒に頑張ろう！」と励ます。この順番なら、ESFPの持ち味が効果的に活きる。「明るさは解決策の後で」を意識してみましょう。"},"3":{"situation":"あなたはチームのサブリーダー。入社2年目の後輩・高橋さんが、クライアント向けの提案資料に複数のデータミスを混入させてしまった。\n幸い提出前にあなたが発見したが、高橋さんにはミスの原因を理解してもらい、同じ間違いを繰り返さないように指導したい。","kiridashi":{"A":"「高橋さん、提出前の資料チェックしてて気になった点があったんだけど、ちょっと見てくれる？」","B":"「高橋さーん！お疲れー！あ、そうそう、資料なんだけど、ちょっと数字が違ってたよー。まあ提出前だしいいよね！」","C":"「高橋さん…資料なんだけど…ちょっと直したいところがあって…」","D":"「高橋さん、データの検証手順、これから一緒にやろう」","correct":"A"},"furumai":{"A":"具体的にどこが違うかを示し、「どうやって確認したか教えてくれる？」と原因を一緒に考える","B":"「まあ提出前でよかったしね〜！次は気をつけてね！」と笑顔で明るく済ませる","C":"「まあ提出前でよかったね」と軽く流す","D":"「これくらいのミス、自分で気づかないとまずいよ」と厳しく指導する","correct":"A"},"result":"A + A","naze":"「気になった点がある」という言い方は、ミスを**「指摘」ではなく「一緒に確認」**というフレームに変えている。後輩が防御的になるのを防げる。\n\n「ちょっと見てくれる？」と問いかけ形にすることで、相手に自分で気づく機会を与えている。明るく済ませるのは優しさに見えるけど、後輩の成長には不十分。","otoshiana":"ESFPは**「後輩と仲良くなる」**ことに全力を注ぎがち。Bの対応はまさにそのパターン。「まあいいよね！」と明るく流すと、後輩は「ミスしても大丈夫なんだ」と甘く捉える。仲の良さは大切だけど、指導者としての役割も忘れないようにしたい。\n\nもう一つ注意。ESFPは**「空気を悪くしたくない」**から、ミスを笑い話にして終わらせがち。でも複数のデータミスがある場合は、笑って済ませる前に原因を一緒に考えた方が、後輩の成長によりつながりやすい。一時的に空気が重くなっても、きちんと事実を伝えることが、結果的に後輩のためになることが多い。","hint":"**後輩へのフィードバックの基本パターン：**\n1. 「ちょっと見てくれる？」（共に確認する姿勢）\n2. 「ここ、〇〇と××で数字が違うね」（事実を具体的に指摘）\n3. 「どうやって確認したか教えてもらえる？」（プロセスを一緒に振り返る）\n\n**言い換え例：**\n- ×「まあいいよね！次は気をつけて！」（問題の先送り）\n- 〇「ここ、元のデータと数字が合わないんだけど、どこから持ってきたか一緒に見てみよう」（一緒に考える姿勢）","more":"ESFPの**「温かくて楽しい雰囲気」**は、後輩指導で大きな強み。後輩は「怒られる」と身構えているから、ESFPの雰囲気ならリラックスして話せる。ただし**「仲の良い先輩」と「頼れる先輩」は両立できる**。楽しく雑談した後に、「ちょっと真面目な話だけど」とスイッチを切り替える。この切り替えができるESFPは、後輩から「話しやすくて、一番ためになる」と慕われる。"},"4":{"situation":"あなたはWeb制作会社のプロジェクトマネージャー。\nクライアントの鈴木社長から「納品前に機能を追加したい」という要望が入った。仕様は既に確定し、追加費用の予算はない。\n\n追加費用なしでは対応が難しいが、クライアントとの関係も悪くしたくない。鈴木社長に対応方針を伝える必要がある。","kiridashi":{"A":"「鈴木社長、ご要望ありがとうございます。一度内容を整理させていただき、改めてご提案してもよろしいでしょうか」","B":"「鈴木社長、もちろんです！ぜひやらせてください！お任せくださいね〜！」","C":"「鈴木社長…ご希望はお聞きしたのですが…社内で検討させていただけますか…」","D":"「鈴木社長、それは仕様外です。契約の範囲内でご対応いただけますか」","correct":"A"},"furumai":{"A":"相手の要望の背景を質問で深掘りし、本当に必要なものを一緒に整理する","B":"クライアントと楽しく会話するうちに、条件面の確認を忘れてそのまま帰ってしまう","C":"「何とかします」と安請け合いして、後で社内に持ち帰る","D":"「今回は難しいですが、次回の改修で対応しましょう」と先延ばしする","correct":"A"},"result":"A + A","naze":"クライアントの要望をまず受け止めることが出発点。「ありがとうございます」で相手の提案を尊重しつつ、「整理して改めてご提案」と**即答を避けて考える時間を確保**している。\n\nクライアントとの会話が盛り上がるのは良いこと。でも大切なのは、楽しく話した後に「いつまでに」「いくらで」「何を」をきちんと確認すること。","otoshiana":"","hint":"**クライアントの追加要望への3ステップ：**\n1. 「ありがとうございます／ご要望、承知しました」（まず受け止める）\n2. 「少し具体的に教えても良いですか？ どういう場面で使いたいかなど」（背景を深掘り）\n3. 「整理して、〇日までにご提案します」（即答せず時間をもらう）\n\n**言い換え例：**\n- ×「もちろんです！ぜひやらせてください！」（条件未確認の約束）\n- 〇「ご要望の意図を教えていただければ、一番良い方法をご提案できます」（誠実な姿勢）","more":"ESFPの**「人との温かい関係づくり」**は、クライアント対応で圧倒的な強み。鈴木社長が親近感を持てば、後で条件を詰める話もスムーズに進む。ただし**「関係づくり」と「条件確認」はワンセット**。楽しい会話の後に忘れずに「ちなみに、スケジュールと予算についても確認させてください」と切り出す。この「ちなみに」を忘れないことが、ESFPの課題。"},"5":{"situation":"あなたはマーケティング部門のメンバー。来月実施するキャンペーンの企画が承認されたが、実行にはシステム部門の協力（LPの開発とサーバー準備）が必要だ。\n\nシステム部門は今、自社サービスの大型リリース準備で忙しいと聞いている。システム部門の山田課長に協力を依頼しなければならない。","kiridashi":{"A":"「山田課長、お忙しいところ恐れ入ります。マーケティングの〇〇キャンペーンの件で、ご相談がございます」","B":"「山田課長、お疲れ様ですー！最近忙しそうですね〜、大丈夫ですか？あ、そうそう、ちょっとお願いがあって…」","C":"「山田課長…システム部門いま忙しいとお聞きしてるんですが…実はお願いがあって…」","D":"「山田課長、〇〇キャンペーンの件ですが、経営陣からも優先度高いプロジェクトなので、ご協力をお願いします」","correct":"A"},"furumai":{"A":"相手の都合を先に聞き、こちらの要件を共有した上で「一緒にスケジュールを調整できないか」と提案する","B":"雑談で盛り上がった後、帰り際に「あ、そうそう、LPの件もお願いします！」とサラッと伝えて帰る","C":"「いつ頃なら対応可能ですか？」と相手の都合に完全に委ねる","D":"自分の上長にエスカレーションして、正式な依頼ルートを回す","correct":"A"},"result":"A + A","naze":"他部署への依頼は、社内とはいえ**「相手にも相手の仕事がある」**ことが前提。まず「お忙しいところ恐れ入ります」と相手の状況を認めることで、「こちらの事情を押し付けるつもりはない」というサインになる。\n\n「ご相談がございます」という言葉で、一方的な依頼ではなく**双方向の話し合いの姿勢**を示せている。雑談は関係づくりに有用だけど、本題をきちんと伝えることが先。","otoshiana":"ESFPは**「雑談から入るのが大好き」**。Bの切り出し方はまさにそのパターン。山田課長と楽しく話してるうちに、「あ、そうそう」と本題を後回しにする。しかも帰り際にサラッと伝えると、相手は「今それ言う？」と困惑する。依頼の本題が雑談に埋もれてしまう。\n\nもう一つ注意。ESFPは**「相手と仲良くなること」**に集中しすぎて、Dのように「経営陣からも〜」と権力を持ち出したり、逆にCのように弱腰になったりする。まずは簡潔に用件を伝えてから、関係づくりに進む。順番を意識すると良い。","hint":"**他部署への依頼の基本パターン：**\n1. 「お忙しいところ恐れ入ります」（相手の状況を認める）\n2. 「〇〇の件でご相談がございます」（「お願い」より「相談」が良い）\n3. 「まずは今の状況を教えていただけますか」（相手の都合を先に聞く）\n\n**言い換え例：**\n- ×「あ、そうそう、LPの件もお願いします！」（雑談のオマケ扱い）\n- 〇「ご相談がございます。LP開発について、ご協力いただけないかと思いまして」（本題をきちんと）","more":"ESFPの**「人懐っこさ」**は、他部署との関係構築で大きなアドバンテージ。普段から雑談で関係を築いておくと、いざ依頼するときにスムーズに進む。ただし**「普段の関係づくり」と「その日の依頼」は分けて考える**。依頼の席では、まず簡潔に用件を伝えてから、必要に応じて雑談を挟む。「本題→関係づくり」の順番で。"}},"ESTP":{"1":{"situation":"あなたは社内プロジェクトのリーダーを任されている。\n来週金曜が納期の重要な成果物について、協力会社からの納品遅延が判明。全体スケジュールが3日ほど後ろ倒しになる見込みだ。\n\n田中部長（プロジェクト責任者）にこの事実を報告し、今後の対応を相談しなければならない。","kiridashi":{"A":"「部長、今お時間よろしいでしょうか。〇〇プロジェクトについて、ご報告とご相談がございます」","B":"「部長！〇〇プロジェクト、協力会社が遅れてます。俺、もう別の業者に当たってます！」","C":"「部長…お忙しいところ申し訳ないんですが…〇〇の件で、ちょっとご相談が…」","D":"「部長、〇〇プロジェクトですけど、納期厳しいっすね。どうします？」","correct":"A"},"furumai":{"A":"資料を手に持ち、相手の目を見て、落ち着いた声ではじめる","B":"報告しながら既にスマホで別業者に連絡を取っている","C":"姿勢を低くし、申し訳なさそうな表情で切り出す","D":"腕を組み、少し後ろに重心を置いて、事態を分析し始める","correct":"A"},"result":"A + A","naze":"「今お時間よろしいでしょうか」は、相手の状況を尊重する基本の切り出し。田中部長は多忙な管理職だから、いきなり本題に入られると心の準備ができていない。\n\n「ご報告とご相談がございます」と伝えることで、**話の目的を先に示して、相手に受け止める準備を促せる**。勢いよく飛び込む前に、一呼吸置くとスムーズ。","otoshiana":"ESTPは**「まず動いてから考えろ」**タイプ。Bの切り出し方はまさにそのパターン。報告する前に勝手に動き出すと、上司は「相談してくれないんだな」と不信感を持ちがち。行動力は長所だけど、報告の順序が逆だとマイナスに働く可能性がある。\n\nもう一つ注意。ESTPは**「状況を楽観的に捉える」**傾向があるから、Dのように「どうします？」と問題を丸投げしがち。自分の見通しを先に伝えてから相談する流れのほうが、スムーズに進みやすいかも。","hint":"**悪い報告の3ステップ切り出し：**\n1. 「今お時間よろしいでしょうか」（タイミングの確認）\n2. 「ご報告とご相談がございます」（目的の提示）\n3. 「実は〜」（本題に入る）\n\n**言い換え例：**\n- ×「もう別の手打ってます！」（報告前に独断行動）\n- 〇「状況が判明したので、すぐご報告させていただきます。ご相談も含めて」（適切な順序）","more":"ESTPの**「素早い判断と行動力」**は、プロジェクトのピンチでは欠かせない武器。ただし組織の中では、**「報告→相談→行動」の順序**が基本。この順序を守ることで、あなたの行動力が「頼れるリーダー」として評価されやすい。逆に報告なしの行動は「暴走」と受け取られることもある。行動の前に「一報入れる」癖をつけましょう。"},"2":{"situation":"あなたは新規プロジェクトのメンバーとして参加している。\n同僚の佐藤さんが担当しているデザイン作業の進捗が予定より遅れており、このままではあなたの担当領域（フロントエンド実装）の着手にも影響が出そうだ。\n\n佐藤さんに状況を確認し、どう進めるか話し合いたい。","kiridashi":{"A":"「佐藤さん、今ちょっといいかな。プロジェクトの進捗について、確認と相談があるんだけど」","B":"「佐藤さーん！デザインまだー？まあなんとかなるっしょ！笑」","C":"「佐藤さん…お忙しいと思いますが…デザインの件でちょっと気になってて…」","D":"「佐藤さん、デザインの進捗どうなってる？ これ以上遅れると俺の作業に響くんだけど」","correct":"A"},"furumai":{"A":"まず相手の状況を聞き、「一緒に進め方を考えたい」と協力姿勢を示す","B":"「まあ俺が手伝えば早いって！任せて！」と軽く受け流して、具体的な話をしない","C":"「いつ頃できそう？」と相手のペースに任せる","D":"「手伝おうか？」と相手の作業に直接介入する","correct":"A"},"result":"A + A","naze":"同僚関係は上下関係ではない。対等な立場だからこそ、「確認と相談」という言葉で**相手を責めるのではなく、一緒に考える姿勢**を見せることが大切。\n\nまずは相手の事情を聞くことで、本当のボトルネックが見えてくる。軽いノリで済ませようとせず、ちゃんと向き合うことが信頼につながる。","otoshiana":"ESTPは**「冗談や軽いノリで場を和ませる」**のが得意。Bの切り出し方はまさにそのパターン。でも今回は仕事の進捗に関する真面目な話。軽く受け流されると、佐藤さんは「真剣に受け止めてもらえてない」と感じる。\n\nもう一つ注意。ESTPは**「なんとかなるっしょ精神」**が強いから、Bのように「俺が手伝えば早い」と言うけど、具体的な計画がない。手伝うにしても、いつ・どう手伝うのかをちゃんと話し合ったほうがいい。","hint":"**同僚への「確認＋相談」の基本パターン：**\n1. 「今ちょっといいかな」（タイミング確認）\n2. 「〇〇の件で、確認と相談があるんだけど」（目的を先に伝える）\n3. 「今どんな状況か教えてもらえる？」（相手の状況を先に聞く）\n\n**言い換え例：**\n- ×「なんとかなるっしょ！」（根拠のない楽観）\n- 〇「一緒にスケジュール調整できないかな」（協力の招待）","more":"ESTPの**「場の空気を明るくする力」**は、チームにとって貴重な存在。ただし、**「空気を良くする」と「問題から目を逸らす」は別**。空気を良くした上で、ちゃんと本題に取り組む。この2つを両立できれば、ESTPはチームのムードメーカー兼、問題解決のエンジンになれる。「笑顔で、でも真剣に」を意識してみましょう。"},"3":{"situation":"あなたはチームのサブリーダー。入社2年目の後輩・高橋さんが、クライアント向けの提案資料に複数のデータミスを混入させてしまった。\n幸い提出前にあなたが発見したが、高橋さんにはミスの原因を理解してもらい、同じ間違いを繰り返さないように指導したい。","kiridashi":{"A":"「高橋さん、提出前の資料チェックしてて気になった点があったんだけど、ちょっと見てくれる？」","B":"「高橋さん、資料ちょっと見たけどー、まあ提出前でよかったね！次は気をつけて！」","C":"「高橋さん…資料なんだけど…ちょっと直したいところがあって…」","D":"「高橋さん、データの検証プロセスについて、後で時間もらえる？」","correct":"A"},"furumai":{"A":"具体的にどこが違うかを示し、「どうやって確認したか教えてくれる？」と原因を一緒に考える","B":"「まあなんとかなるって！俺も最初はよくミスしてたしね〜。次頑張ろう！」と軽く流す","C":"「まあ提出前でよかったね」と軽く流す","D":"「これくらいのミス、自分で気づかないとまずいよ」と厳しく指導する","correct":"A"},"result":"A + A","naze":"「気になった点がある」という言い方は、ミスを**「指摘」ではなく「一緒に確認」**というフレームに変えている。後輩が防御的になるのを防げる。\n\n「ちょっと見てくれる？」と問いかけ形にすることで、相手に自分で気づく機会を与えている。自分で見つけたミスの方が、次から意識に残りやすい。","otoshiana":"ESTPは**「まあなんとかなるよ」**精神が強め。Bの対応はまさにそのパターン。「俺もミスしてたしね」と共感するのは良いところだけど、肝心の「なぜ間違えたか」「どう防ぐか」に触れないと、同じミスが繰り返されがち。軽く流すだけだと、指導として十分でないこともある。\n\nもう一つ注意。ESTPは**「自分の経験談で終わらせる」**傾向があるかも。「俺のときはこうだったよ」は参考になるけど、後輩各自の確認プロセスの課題に直結しないことも。まずは本人のやり方を聞いて、そこにアドバイスを足す流れのほうがおすすめ。","hint":"**後輩へのフィードバックの基本パターン：**\n1. 「ちょっと見てくれる？」（共に確認する姿勢）\n2. 「ここ、〇〇と××で数字が違うね」（事実を具体的に指摘）\n3. 「どうやって確認したか教えてもらえる？」（プロセスを一緒に振り返る）\n\n**言い換え例：**\n- ×「まあなんとかなるって！次頑張ろう！」（問題の先送り）\n- 〇「ここ、元のデータと数字が合わないんだけど、どこから持ってきたか一緒に見てみよう」（一緒に考える姿勢）","more":"ESTPの**「親しみやすさ」**は、後輩との関係構築で大きな強み。後輩は先輩に話しかけにくいことが多いけど、ESTPなら自然にコミュニケーションが取れる。この強みを活かしつつ、**「仲間」としての距離感と「指導者」としての距離感」**を使い分けるのがポイント。楽しい雑談で信頼を築いた後に、真面目な指導に切り替える。このギアチェンジができると、後輩にとって頼れるメンターになれる。"},"4":{"situation":"あなたはWeb制作会社のプロジェクトマネージャー。\nクライアントの鈴木社長から「納品前に機能を追加したい」という要望が入った。仕様は既に確定し、追加費用の予算はない。\n\n追加費用なしでは対応が難しいが、クライアントとの関係も悪くしたくない。鈴木社長に対応方針を伝える必要がある。","kiridashi":{"A":"「鈴木社長、ご要望ありがとうございます。一度内容を整理させていただき、改めてご提案してもよろしいでしょうか」","B":"「鈴木社長、お任せください！なんとかしますよ！追加機能、やります！」","C":"「鈴木社長…ご希望はお聞きしたのですが…社内で検討させていただけますか…」","D":"「鈴木社長、それは仕様外です。契約の範囲内でご対応いただけますか」","correct":"A"},"furumai":{"A":"相手の要望の背景を質問で深掘りし、本当に必要なものを一緒に整理する","B":"自信満々に「大丈夫です！」と約束するが、具体的な方法は何も考えていない","C":"「何とかします」と安請け合いして、後で社内に持ち帰る","D":"「今回は難しいですが、次回の改修で対応しましょう」と先延ばしする","correct":"A"},"result":"A + A","naze":"クライアントの要望をまず受け止めることが出発点。「ありがとうございます」で相手の提案を尊重しつつ、「整理して改めてご提案」と**即答を避けて考える時間を確保**している。\n\n「お任せください！」と飛びつく（B）のは魅力的だけど、追加費用なしで実現可能かの判断が先。自信があるのは良いことだけど、条件を詰めてからの約束が信頼につながる。","otoshiana":"ESTPは**「その場の勢いで約束しがち」**な傾向がある。Bの切り出し方はまさにそのパターン。鈴木社長も「やってくれるのか！」と期待するけど、後で「追加費用が必要です」となると、信頼を損なう可能性がある。\n\nもう一つ注意。ESTPは**「詳細を詰めるのが苦手」**な傾向があるかも。その場の勢いで条件を飲んでも、「いつまでに」「いくらで」「何を」が曖昧なままだと、後で双方が困りがち。自信は見せるけど、約束は時間をもらってから、という順番のほうがおすすめ。","hint":"**クライアントの追加要望への3ステップ：**\n1. 「ありがとうございます／ご要望、承知しました」（まず受け止める）\n2. 「少し具体的に教えても良いですか？ どういう場面で使いたいかなど」（背景を深掘り）\n3. 「整理して、〇日までにご提案します」（即答せず時間をもらう）\n\n**言い換え例：**\n- ×「お任せください！やります！」（根拠のない約束）\n- 〇「ご要望の意図を教えていただければ、ベストな提案ができます」（誠実な姿勢）","more":"ESTPの**「即座の対応力と自信」**は、クライアントに安心感を与える強力な武器。ただし「安心感」と「安請け合い」は紙一重。**「できること」と「約束すること」の間に一段階挟む**のがコツ。「検討してお答えします」という言葉は、自信のなさではなく、プロフェッショナルな慎重さの表れ。この「一段階」を挟むことで、後のトラブルを防ぎやすくなる。"},"5":{"situation":"あなたはマーケティング部門のメンバー。来月実施するキャンペーンの企画が承認されたが、実行にはシステム部門の協力（LPの開発とサーバー準備）が必要だ。\n\nシステム部門は今、自社サービスの大型リリース準備で忙しいと聞いている。システム部門の山田課長に協力を依頼しなければならない。","kiridashi":{"A":"「山田課長、お忙しいところ恐れ入ります。マーケティングの〇〇キャンペーンの件で、ご相談がございます」","B":"「山田課長！〇〇キャンペーンのLP頼みたいんですけど、来月頭まででいけますよね？」","C":"「山田課長…システム部門いま忙しいとお聞きしてるんですが…実はお願いがあって…」","D":"「山田課長、〇〇キャンペーンの件ですが、経営陣からも優先度高いプロジェクトなので、ご協力をお願いします」","correct":"A"},"furumai":{"A":"相手の都合を先に聞き、こちらの要件を共有した上で「一緒にスケジュールを調整できないか」と提案する","B":"「忙しいのは分かるんですけど、〇〇だけでもお願いしますよ！なんとかなりますって！」と勢いで押す","C":"「いつ頃なら対応可能ですか？」と相手の都合に完全に委ねる","D":"「じゃあ、うちの部長から正式に依頼出してもらいますね」と上長に丸投げする","correct":"A"},"result":"A + A","naze":"他部署への依頼は、社内とはいえ**「相手にも相手の仕事がある」**ことが前提。まず「お忙しいところ恐れ入ります」と相手の状況を認めることで、「こちらの事情を押し付けるつもりはない」というサインになる。\n\n「ご相談がございます」という言葉で、一方的な依頼ではなく**双方向の話し合いの姿勢**を示せている。勢いで押すのではなく、相手の状況を理解した上で依頼するのがおすすめ。","otoshiana":"ESTPは**「勢いで動く」**のが得意だけど、他部署への依頼では裏目に出る。Bの切り出し方はまさにそのパターン。「なんとかなりますって！」は自分に言い聞かせているだけで、相手にとってはプレッシャー。しかも具体的な条件（いつまでに・何を・どの程度のリソースで）が何も伝わっていない。\n\nもう一つ注意。ESTPは**「結果重視」**だから、Dのように上長を使って正式ルートで一気に進めようとする。でも、現場の協力関係なしに押し切られた仕事は、質が落ちたり後で対応が遅れたりする。まずは現場同士で信頼を築くのがおすすめ。","hint":"**他部署への依頼の基本パターン：**\n1. 「お忙しいところ恐れ入ります」（相手の状況を認める）\n2. 「〇〇の件でご相談がございます」（「お願い」より「相談」が良い）\n3. 「まずは今の状況を教えていただけますか」（相手の都合を先に聞く）\n\n**言い換え例：**\n- ×「来月頭まででお願いできます？」（いきなり期限提示）\n- 〇「〇日が理想ですが、山田課長のスケジュールに合わせて調整できます」（柔軟性を示す）","more":"ESTPの**「スピード感と行動力」**は、他部署との協業でも「推進力」として頼られる。ただし、**「速い」と「荒い」は違う**。依頼の精度を上げるコツは「5W1H」を整理してから伝えること。「誰が・何を・いつまでに・どこで・なぜ・どうやって」をざっくりでもいいから用意してから行くと、相手も前向きに検討しやすい。この準備があるかないかで、相手の対応が変わってくる。"}},"ISTP":{"1":{"situation":"あなたは社内プロジェクトのリーダーを任されている。\n来週金曜が納期の重要な成果物について、協力会社からの納品遅延が判明。全体スケジュールが3日ほど後ろ倒しになる見込みだ。\n\n田中部長（プロジェクト責任者）にこの事実を報告し、今後の対応を相談しなければならない。","kiridashi":{"A":"「部長、今お時間よろしいでしょうか。〇〇プロジェクトについて、ご報告とご相談がございます」","B":"「部長、遅延の件はもう対応しておきました。代替業者に切り替えてます」","C":"「部長…〇〇の件なんですけど…たぶん大丈夫だと思いますが…一応ご報告で…」","D":"「部長、協力会社が遅れてます。こっちの資料、ちょっと見てもらえますか」","correct":"A"},"furumai":{"A":"資料を手に持ち、相手の目を見て、落ち着いた声ではじめる","B":"すでに自分で動いた結果を淡々と説明し、「なので対応済みです」とまとめる","C":"姿勢を低くし、申し訳なさそうな表情で切り出す","D":"PCを開いて、詳細な技術データを見せながら説明する","correct":"A"},"result":"A + A","naze":"「今お時間よろしいでしょうか」は、相手の状況を尊重する基本の切り出し。田中部長は多忙な管理職だから、いきなり本題に入られると心の準備ができていない。\n\n「ご報告とご相談がございます」と伝えることで、**話の目的を先に示して、相手に受け止める準備を促せる**。自分で解決したとしても、報告はプロジェクト責任者の判断を経るのが望ましい。","otoshiana":"ISTPは**「自分で解決するのが早い」**と考えがち。Bの切り出し方はまさにそのパターン。報告の前に勝手に動いてしまうと、上司は「なんで相談してくれなかったの」と不信感を持つ。対応が良くても、報告なしは評価を下げかねない。\n\nもう一つ注意。ISTPは**「事実だけ淡々と伝えれば十分」**と思いがち。でも悪い報告ほど、相手の受け止め方に配慮して伝えることが、信頼関係を維持するカギ。感情を交えろという意味ではなく、「相手がどう受け取るか」を意識してみましょう。","hint":"**悪い報告の3ステップ切り出し：**\n1. 「今お時間よろしいでしょうか」（タイミングの確認）\n2. 「ご報告とご相談がございます」（目的の提示）\n3. 「実は〜」（本題に入る）\n\n**言い換え例：**\n- ×「もう対応したんで大丈夫です」（報告なしで動いた後の一言）\n- 〇「対応を検討している状況です。ご相談させてください」（プロセスを共有）","more":"ISTPに特に意識してほしいのが**「報告は解決の後じゃなくて、着手の前」**という考え方。自分で解決する能力が高いのは素晴らしいこと。でも組織の中では、**プロセスの可視化**が求められる。「解決したから報告不要」ではなく、「起きた事象と自分の判断を共有する」ことで、上司との信頼関係が築かれやすくなる。"},"2":{"situation":"あなたは新規プロジェクトのメンバーとして参加している。\n同僚の佐藤さんが担当しているデザイン作業の進捗が予定より遅れており、このままではあなたの担当領域（フロントエンド実装）の着手にも影響が出そうだ。\n\n佐藤さんに状況を確認し、どう進めるか話し合いたい。","kiridashi":{"A":"「佐藤さん、今ちょっといいかな。プロジェクトの進捗について、確認と相談があるんだけど」","B":"「佐藤さん、デザインのとこ、俺がやっておいたよ。一応CSSのとこまで組んどた」","C":"「佐藤さん…デザインの方、進んでますか…？急ぎではないんですけど…」","D":"「佐藤さん、デザインまだ？ 俺の作業始まらないんだけど」","correct":"A"},"furumai":{"A":"まず相手の状況を聞き、「一緒に進め方を考えたい」と協力姿勢を示す","B":"黙って佐藤さんのPCの前に行き、「ここ、こうすれば早いよ」と勝手に操作する","C":"「いつ頃できそう？」と相手のペースに任せる","D":"「じゃあ俺がデザインやるよ」と自分で引き受けてしまう","correct":"A"},"result":"A + A","naze":"同僚関係は上下関係ではない。対等な立場だからこそ、「確認と相談」という言葉で**相手を責めるのではなく、一緒に考える姿勢**を見せることが大切。\n\nまずは相手の事情を聞くことで、本当のボトルネックが見えてくる。「手を動かす前に、まずは言葉でコミュニケーションを取る」とスムーズ。","otoshiana":"ISTPは**「言うよりやる」**タイプ。Bの切り出し方はまさにそのパターン。勝手に手を動かすと、佐藤さんは「勝手にやられた」と感じて信用問題に発展しかねない。\n\nもう一つ注意。ISTPは**「自分でやった方が早い」**と思ってDのように全部引き受けてしまう。短期的には解決するけど、役割分担が崩れて、後で余計な負担がのしかかる。","hint":"**同僚への「確認＋相談」の基本パターン：**\n1. 「今ちょっといいかな」（タイミング確認）\n2. 「〇〇の件で、確認と相談があるんだけど」（目的を先に伝える）\n3. 「今どんな状況か教えてもらえる？」（相手の状況を先に聞く）\n\n**言い換え例：**\n- ×「やっておいたよ」（勝手に手出し）\n- 〇「手伝えることあったら言ってね」（協力の姿勢）","more":"ISTPに覚えておいてほしいのが**「言葉によるアラインメント」**の重要性。手を動かすのが得意なのは長所だけど、チームで働くときは**「何をやるか・誰がやるか」を言葉で共有する**ことが前提。行動が先走ると、周りが取り残されてしまうことがある。「動く前に一言」を癖にしましょう。"},"3":{"situation":"あなたはチームのサブリーダー。入社2年目の後輩・高橋さんが、クライアント向けの提案資料に複数のデータミスを混入させてしまった。\n幸い提出前にあなたが発見したが、高橋さんにはミスの原因を理解してもらい、同じ間違いを繰り返さないように指導したい。","kiridashi":{"A":"「高橋さん、提出前の資料チェックしてて気になった点があったんだけど、ちょっと見てくれる？」","B":"「高橋さん、この資料直しときました。確認お願いします」","C":"「高橋さん…資料なんだけど…ちょっと直したいところがあって…」","D":"「高橋さん、データの検証手順、これから一緒にやろう」","correct":"A"},"furumai":{"A":"具体的にどこが違うかを示し、「どうやって確認したか教えてくれる？」と原因を一緒に考える","B":"「ここ、間違ってたから直しといた」と、すでに修正済みの資料を渡す","C":"「まあ提出前でよかったね」と軽く流す","D":"「次からはこう確認して」と、自分のやり方を一方的に教える","correct":"A"},"result":"A + A","naze":"「気になった点がある」という言い方は、ミスを**「指摘」ではなく「一緒に確認」**というフレームに変えている。後輩が防御的になるのを防げる。\n\n「ちょっと見てくれる？」と問いかけ形にすることで、相手に自分で気づく機会を与えている。自分で見つけたミスの方が、次から意識に残りやすい。","otoshiana":"ISTPは**「自分でやった方が早いし正確」**と思いがち。Bの対応はまさにそのパターン。直して渡すのは親切だけど、後輩は「直し方が分かった」だけで、「なぜ間違えたか」に向き合わない。結果、同じミスを繰り返す。\n\nもう一つ注意。ISTPは**「手順を教えれば身につく」**と考えがち。Dのように自分のやり方を押し付けるのは、相手が「なぜそうするのか」を理解しないまま手順だけをなぞる原因になる。まずは本人の確認プロセスを知るところから始めましょう。","hint":"**後輩へのフィードバックの基本パターン：**\n1. 「ちょっと見てくれる？」（共に確認する姿勢）\n2. 「ここ、〇〇と××で数字が違うね」（事実を具体的に指摘）\n3. 「どうやって確認したか教えてもらえる？」（プロセスを一緒に振り返る）\n\n**言い換え例：**\n- ×「直しときました」（代理解決）\n- 〇「ここ、元のデータと数字が合わないんだけど、どこから持ってきたか一緒に見てみよう」（一緒に考える姿勢）","more":"ISTPの「手を動かして教える」スキルは、後輩指導でも強力な武器になる。ただし**「見せるだけでなく、やらせる」**ことも大切。ISTPが目の前で作業をしているのを後輩に見せるだけでなく、「今度は君がやってみて」と実践の機会を作る。手と頭の両方を使うことで、後輩の成長が加速する。「自分でやる」から「やらせる」への切り替えがポイント。"},"4":{"situation":"あなたはWeb制作会社のプロジェクトマネージャー。\nクライアントの鈴木社長から「納品前に機能を追加したい」という要望が入った。仕様は既に確定し、追加費用の予算はない。\n\n追加費用なしでは対応が難しいが、クライアントとの関係も悪くしたくない。鈴木社長に対応方針を伝える必要がある。","kiridashi":{"A":"「鈴木社長、ご要望ありがとうございます。一度内容を整理させていただき、改めてご提案してもよろしいでしょうか」","B":"「鈴木社長、その機能の追加ですけど、技術的に見ると現在のアーキテクチャだと〇〇の問題があって、工数が〇〇かかります」","C":"「鈴木社長…ご希望はお聞きしたのですが…社内でなんとか…検討してみます…」","D":"「鈴木社長、それは仕様外です。契約の範囲内でご対応いただけますか」","correct":"A"},"furumai":{"A":"相手の要望の背景を質問で深掘りし、本当に必要なものを一緒に整理する","B":"技術的な説明を詳細に展開し、「だから難しい」と論理で押す","C":"「何とかします」と安請け合いして、後で社内に持ち帰る","D":"「今回は難しいです」と事実だけ伝えて終わる","correct":"A"},"result":"A + A","naze":"クライアントの要望をまず受け止めることが出発点。「ありがとうございます」で相手の提案を尊重しつつ、「整理して改めてご提案」と**即答を避けて考える時間を確保**している。\n\n技術的な正しさより、クライアントの**真のニーズ**を引き出すことが先。背景が分かれば、追加費用なしでも解決できる方法が見つかるかもしれない。","otoshiana":"ISTPは**「技術的な事実を説明すれば理解してもらえる」**と考えがち。Bの切り出し方はまさにそのパターン。専門用語を使って詳細に説明しても、クライアントには「難しい理由を並べただけ」と受け取られてしまうかも。\n\nもう一つ注意。ISTPは言葉数が少なめだから、Dのように短く切ってしまうと「冷たい」「やる気がない」と取られる。少ない言葉でも「受け止める」サインを入れるのがコツ。","hint":"**クライアントの追加要望への3ステップ：**\n1. 「ありがとうございます／ご要望、承知しました」（まず受け止める）\n2. 「少し具体的に教えても良いですか？ どういう場面で使いたいかなど」（背景を深掘り）\n3. 「整理して、〇日までにご提案します」（即答せず時間をもらう）\n\n**言い換え例：**\n- ×「技術的に難しいです」（説明不足の拒絶）\n- 〇「ご要望の意図を教えていただければ、一番良い方法をご提案できます」（協力の姿勢）","more":"ISTPは仕組みや技術に強いから、クライアントの要望の**実現可能性を瞬時に判断できる**。この能力は強力だけど、その判断をそのまま伝えると「拒絶」に聞こえがち。**「判断結果」ではなく「検討プロセス」を共有する**ことで、クライアントに「一緒に考えてくれている」と感じてもらえる。技術の視点を活かしつつ、コミュニケーションのクッションを挟むのがコツ。"},"5":{"situation":"あなたはマーケティング部門のメンバー。来月実施するキャンペーンの企画が承認されたが、実行にはシステム部門の協力（LPの開発とサーバー準備）が必要だ。\n\nシステム部門は今、自社サービスの大型リリース準備で忙しいと聞いている。システム部門の山田課長に協力を依頼しなければならない。","kiridashi":{"A":"「山田課長、お忙しいところ恐れ入ります。マーケティングの〇〇キャンペーンの件で、ご相談がございます」","B":"「山田課長、LPの件なんですけど、サーバーの設定とか俺の方でもできそうなんで、アカウントだけもらえます？」と頼む前に自分で何とかしようとする","C":"「山田課長…システム部門いま忙しいとお聞きしてるんですが…実はお願いがあって…」","D":"「山田課長、〇〇キャンペーンの件です。LPとサーバー、〇日までにお願いします」","correct":"A"},"furumai":{"A":"相手の都合を先に聞き、こちらの要件を共有した上で「一緒にスケジュールを調整できないか」と提案する","B":"自分で技術的にできるところは片付けて、「残りの这部分だけお願いします」と最小化して渡す","C":"「いつ頃なら対応可能ですか？」と相手の都合に完全に委ねる","D":"「仕様書、まとめました」と詳細な要件定義書を渡して、「これで進めますか」と投げる","correct":"A"},"result":"A + A","naze":"他部署への依頼は、社内とはいえ**「相手にも相手の仕事がある」**ことが前提。まず「お忙しいところ恐れ入ります」と相手の状況を認めることで、「こちらの事情を押し付けるつもりはない」というサインになる。\n\n「ご相談がございます」という言葉で、一方的な依頼ではなく**双方向の話し合いの姿勢**を示せている。自分で何とかする前に、まずは相手に相談の枠を作るのがおすすめ。","otoshiana":"ISTPは**「自分でできそうなことは自分でやる」**主義。Bの切り出し方はまさにそのパターン。でもシステム部門の管轄を勝手に触ると、セキュリティや運用ルールの問題になる。しかも「結局頼まないといけない部分」だけ残ると、相手には不快感が残る。\n\nもう一つ注意。ISTPは**「言葉より行動」**だから、Dのように仕様書を渡して「あとはお願い」と押し付けがち。準備が整ってても、相手の都合を聞かずに物を投げるのは避けたい。","hint":"**他部署への依頼の基本パターン：**\n1. 「お忙しいところ恐れ入ります」（相手の状況を認める）\n2. 「〇〇の件でご相談がございます」（「お願い」より「相談」が良い）\n3. 「まずは今の状況を教えていただけますか」（相手の都合を先に聞く）\n\n**言い換え例：**\n- ×「俺ができるところはやっときました」（勝手な部分着手）\n- 〇「こちらで準備できることはありますか？ 協力できることを教えてください」（相手を尊重）","more":"ISTPの「自分で解決する力」は、実は他部署との関係構築でも武器になる。**「相手が忙しければ、自分側でできる準備を最大限やる」**という姿勢は好感を持たれる。ただし「勝手にやる」と「準備して相談する」は違う。事前に「ここまでならこちらで用意できますが、よろしいですか？」と確認を挟むことで、能力が適切に評価されやすくなる。"}},"ISFP":{"1":{"situation":"あなたは社内プロジェクトのリーダーを任されている。\n来週金曜が納期の重要な成果物について、協力会社からの納品遅延が判明。全体スケジュールが3日ほど後ろ倒しになる見込みだ。\n\n田中部長（プロジェクト責任者）にこの事実を報告し、今後の対応を相談しなければならない。","kiridashi":{"A":"「部長、今お時間よろしいでしょうか。〇〇プロジェクトについて、ご報告とご相談がございます」","B":"「部長、あの…〇〇プロジェクトの件なんですけど…えっと…その…遅れてまして…」","C":"「部長…お忙しいところ申し訳ないんですが…〇〇の件で、ちょっとご相談が…」","D":"「部長、〇〇プロジェクト、進捗に問題が生じました。すぐに対応が必要です」","correct":"A"},"furumai":{"A":"資料を手に持ち、相手の目を見て、落ち着いた声ではじめる","B":"報告のタイミングを逃して、エレベーターホールで偶然会った時に小声で伝える","C":"姿勢を低くし、申し訳なさそうな表情で切り出す","D":"メールで事実だけを簡潔に送り、直接は話さない","correct":"A"},"result":"A + A","naze":"「今お時間よろしいでしょうか」は、相手の状況を尊重する基本の切り出し。田中部長は多忙な管理職だから、いきなり本題に入られると心の準備ができていない。\n\n「ご報告とご相談がございます」と伝えることで、**話の目的を先に示して、相手に受け止める準備を促せる**。嫌な報告でも、タイミングを選んできちんと伝えるのが望ましい対応。","otoshiana":"ISFPは**「嫌なことは後回し」**にしがち。BやCの切り出し方はまさにそのパターン。報告を先延ばししているうちに、部長が別の情報源で知ることになり、結果的に「なんで早く言ってくれなかったの」と信用を落とす。\n\nもう一つ注意。ISFPは**「嫌な空気を作りたくない」**から、Dのようにメールだけで済ませようとする。でも悪い報告ほど、直接相手の目を見て伝えることで信頼が生まれる。メールは補足に留めよう。","hint":"**悪い報告の3ステップ切り出し：**\n1. 「今お時間よろしいでしょうか」（タイミングの確認）\n2. 「ご報告とご相談がございます」（目的の提示）\n3. 「実は〜」（本題に入る）\n\n**言い換え例：**\n- ×「あの…えっと…実は遅れてて…」（言い淀む）\n- 〇「スケジュールに影響が出る件がございまして、ご相談させてください」（堂々と）","more":"ISFPが直面しやすいのが**「報告の先送り」**という罠。心理学的には**「回避行動」**と呼ばれるパターンで、不安や不快感から逃れるために行動を後回しにしてしまう。でも問題は時間が経っても解決しないどころか、**選択肢が減って状況が悪化する**。「早めの報告」を心がけましょう。報告した瞬間が一番気まずいけど、その後はたいてい楽になる。"},"2":{"situation":"あなたは新規プロジェクトのメンバーとして参加している。\n同僚の佐藤さんが担当しているデザイン作業の進捗が予定より遅れており、このままではあなたの担当領域（フロントエンド実装）の着手にも影響が出そうだ。\n\n佐藤さんに状況を確認し、どう進めるか話し合いたい。","kiridashi":{"A":"「佐藤さん、今ちょっといいかな。プロジェクトの進捗について、確認と相談があるんだけど」","B":"「佐藤さん…デザインの方…大丈夫ですか…？無理しなくていいんで…」","C":"「佐藤さん…お忙しいと思いますが…デザインの件でちょっと気になってて…」","D":"「佐藤さん、デザインの進捗どうなってる？ みんな待ってるよ」","correct":"A"},"furumai":{"A":"まず相手の状況を聞き、「一緒に進め方を考えたい」と協力姿勢を示す","B":"佐藤さんが疲れていそうだから、お茶を買ってきて「無理しないでね」と気遣うだけで終わる","C":"「いつ頃できそう？」と相手のペースに任せる","D":"「手伝おうか？」と相手の作業に直接介入する","correct":"A"},"result":"A + A","naze":"同僚関係は上下関係ではない。対等な立場だからこそ、「確認と相談」という言葉で**相手を責めるのではなく、一緒に考える姿勢**を見せることが大切。\n\nまずは相手の事情を聞くことで、本当のボトルネックが見えてくる。気遣いは大切だけど、問題を解決するにはちゃんと話し合うステップも必要。","otoshiana":"ISFPは**「相手の雰囲気に敏感」**な反面、それに飲まれがち。Bの対応はまさにそのパターン。佐藤さんが忙しそう・疲れていそうという「空気」に引っ張られて、本題に入れない。気遣いだけで終わると、結局問題は何も解決しない。\n\nもう一つ注意。ISFPは**「対立を避けたい」**から、Cのように遠回しにほのめかすだけで、核心の「いつまでにできるか」を聞けない。優しさと甘さは違う。意識したいのは、相手を気遣いながらも必要な確認をしっかりすること。","hint":"**同僚への「確認＋相談」の基本パターン：**\n1. 「今ちょっといいかな」（タイミング確認）\n2. 「〇〇の件で、確認と相談があるんだけど」（目的を先に伝える）\n3. 「今どんな状況か教えてもらえる？」（相手の状況を先に聞く）\n\n**言い換え例：**\n- ×「無理しなくていいよ」（問題の先送り）\n- 〇「一緒にスケジュール調整できないかな」（協力の招待）","more":"ISFPの優しさと察しの良さは、チームの潤滑油になる素晴らしい長所。でも**「配慮」と「問題回避」は別物**。配慮とは「相手の状況を理解した上で、必要なことをきちんと伝えること」。問題回避は「言わなければ波風が立たない」と逃げること。この違いを意識すると、優しさを活かしつつ、必要な対話もできるようになる。"},"3":{"situation":"あなたはチームのサブリーダー。入社2年目の後輩・高橋さんが、クライアント向けの提案資料に複数のデータミスを混入させてしまった。\n幸い提出前にあなたが発見したが、高橋さんにはミスの原因を理解してもらい、同じ間違いを繰り返さないように指導したい。","kiridashi":{"A":"「高橋さん、提出前の資料チェックしてて気になった点があったんだけど、ちょっと見てくれる？」","B":"「高橋さん…資料なんですけど…大丈夫だとは思うんですけど…ちょっとだけ確認お願いできますか…」","C":"「高橋さん…資料なんだけど…ちょっと直したいところがあって…」","D":"「高橋さん、次から気をつけてね。まあ提出前でよかったけど」","correct":"A"},"furumai":{"A":"具体的にどこが違うかを示し、「どうやって確認したか教えてくれる？」と原因を一緒に考える","B":"高橋さんが落ち込まないように、「でも全体的にはすごくいいできだよ！」と褒めてから、ミスをさらっと伝える","C":"「まあ提出前でよかったね」と軽く流す","D":"「これくらいのミス、自分で気づかないとまずいよ」と厳しく指導する","correct":"A"},"result":"A + A","naze":"「気になった点がある」という言い方は、ミスを**「指摘」ではなく「一緒に確認」**というフレームに変えている。後輩が防御的になるのを防げる。\n\n「ちょっと見てくれる？」と問いかけ形にすることで、相手に自分で気づく機会を与えている。優しさと指摘のバランスが取れた伝え方。","otoshiana":"ISFPは**「相手を傷つけたくない」**思いが強すぎる。Bの対応はまさにそのパターン。褒め言葉で包んでミスをぼかすと、後輩は「まあいいのかな」と真剣に受け止めない。角を立てないのは良いことだけど、事実は事実としてきちんと伝えないと成長の機会を逃してしまう。\n\nもう一つ注意。ISFPは**「空気を悪くしたくない」**から、Dのように「まあいいか」と流してしまう（Cの方向）ことも。後輩の成長を思うなら、一時的な気まずさは乗り越える価値がある。","hint":"**後輩へのフィードバックの基本パターン：**\n1. 「ちょっと見てくれる？」（共に確認する姿勢）\n2. 「ここ、〇〇と××で数字が違うね」（事実を具体的に指摘）\n3. 「どうやって確認したか教えてもらえる？」（プロセスを一緒に振り返る）\n\n**言い換え例：**\n- ×「大丈夫だと思うけど…一応…」（弱すぎる指摘）\n- 〇「ここ、元のデータと数字が合わないんだけど、どこから持ってきたか一緒に見てみよう」（事実＋協力）","more":"ISFPの**「温かさ」**は後輩指導で大きな武器になる。後輩は「怒られる」と身構えているから、ISFPの優しい雰囲気に安心して本音を話しやすくなる。ただし**「優しさ」と「甘さ」の境界線**を意識しましょう。優しさとは「相手の成長を本気で願って、必要なことを伝えること」。一時的に気まずくなっても、それが本人の力になるなら、それこそが本当の優しさ。"},"4":{"situation":"あなたはWeb制作会社のプロジェクトマネージャー。\nクライアントの鈴木社長から「納品前に機能を追加したい」という要望が入った。仕様は既に確定し、追加費用の予算はない。\n\n追加費用なしでは対応が難しいが、クライアントとの関係も悪くしたくない。鈴木社長に対応方針を伝える必要がある。","kiridashi":{"A":"「鈴木社長、ご要望ありがとうございます。一度内容を整理させていただき、改めてご提案してもよろしいでしょうか」","B":"「鈴木社長、はい、承知いたしました。できる限り対応させていただきます」","C":"「鈴木社長…ご希望はお聞きしたのですが…社内でなんとか…検討してみます…」","D":"「鈴木社長、現状の仕様でも十分な機能は網羅できてるかと思いますが…」","correct":"A"},"furumai":{"A":"相手の要望の背景を質問で深掘りし、本当に必要なものを一緒に整理する","B":"クライアントの熱意に押されて、その場で「やります」と約束してしまう","C":"「何とかします」と安請け合いして、後で社内に持ち帰る","D":"「今回は難しいですが、次回の改修で対応しましょう」と先延ばしする","correct":"A"},"result":"A + A","naze":"クライアントの要望をまず受け止めることが出発点。「ありがとうございます」で相手の提案を尊重しつつ、「整理して改めてご提案」と**即答を避けて考える時間を確保**している。\n\n「やります」と即答する（B）と、後で自社にしわ寄せが来る。「断る」のもまだ早い。まずは要望の背景を知り、本当に必要なものを見極めるのがおすすめ。","otoshiana":"ISFPは**「相手をがっかりさせたくない」**思いが強い。Bの対応はまさにそのパターン。クライアントが熱心に語ると、つい「わかりました」と飲んでしまう。でも無理な約束は、後で双方が苦しむことになる。\n\nもう一つ注意。ISFPは**「対立を避けるために曖昧にする」**傾向がある。Cのように「検討します」と濁すと、クライアントは「やってもらえる」と期待してしまう。期待を裏切るより、最初に正直に整理する方が関係を守りやすい。","hint":"**クライアントの追加要望への3ステップ：**\n1. 「ありがとうございます／ご要望、承知しました」（まず受け止める）\n2. 「少し具体的に教えても良いですか？ どういう場面で使いたいかなど」（背景を深掘り）\n3. 「整理して、〇日までにご提案します」（即答せず時間をもらう）\n\n**言い換え例：**\n- ×「はい、やります」（安請け合い）\n- 〇「ご要望の意図を教えていただければ、一番良い方法をご提案できます」（誠実な姿勢）","more":"ISFPの**「人の気持ちに寄り添う力」**は、クライアント対応でも大きな武器。ただし「寄り添う」と「言いなりになる」は違う。本当の寄り添いとは、**相手が本当に求めていることを一緒に見つけること**。安請け合いして後で困らせるより、「どういうお気持ちでその機能をご希望なのか」を深掘りする方が、結果的にクライアントの満足度も上がる。"},"5":{"situation":"あなたはマーケティング部門のメンバー。来月実施するキャンペーンの企画が承認されたが、実行にはシステム部門の協力（LPの開発とサーバー準備）が必要だ。\n\nシステム部門は今、自社サービスの大型リリース準備で忙しいと聞いている。システム部門の山田課長に協力を依頼しなければならない。","kiridashi":{"A":"「山田課長、お忙しいところ恐れ入ります。マーケティングの〇〇キャンペーンの件で、ご相談がございます」","B":"「山田課長…あの…システム部門すごく忙しいと思うんですけど…キャンペーンの件で…お時間いただけますか…」","C":"「山田課長…システム部門いま忙しいとお聞きしてるんですが…実はお願いがあって…」","D":"「山田課長、〇〇キャンペーンの件ですけど、うちの部長からも話が行ってると思います」","correct":"A"},"furumai":{"A":"相手の都合を先に聞き、こちらの要件を共有した上で「一緒にスケジュールを調整できないか」と提案する","B":"相手が忙しそうな雰囲気に圧倒されて、用件だけメモで渡して帰ろうとする","C":"「いつ頃なら対応可能ですか？」と相手の都合に完全に委ねる","D":"自分の上長にエスカレーションして、正式な依頼ルートを回す","correct":"A"},"result":"A + A","naze":"他部署への依頼は、社内とはいえ**「相手にも相手の仕事がある」**ことが前提。まず「お忙しいところ恐れ入ります」と相手の状況を認めることで、「こちらの事情を押し付けるつもりはない」というサインになる。\n\n「ご相談がございます」という言葉で、一方的な依頼ではなく**双方向の話し合いの姿勢**を示せている。相手の顔色をうかがいすぎず、でも配慮は示す。このバランスを意識すると良い。","otoshiana":"ISFPは**「相手の雰囲気に圧倒される」**ことがある。BやCの切り出し方はまさにそのパターン。システム部門が忙しそうだと、それだけで「邪魔してはいけない」と引っ込んでしまう。でも依頼は仕事の一部。必要なことをきちんと伝えるのがプロフェッショナルな対応。\n\nもう一つ注意。ISFPは**「直接言うのが怖くて、上長に頼る」**（D）パターンもある。確かに正式ルートも大切だけど、まずは現場同士の対話で関係を築くのが理想。上長を使うと、相手に「圧力をかけられた」と感じさせる場合がある。","hint":"**他部署への依頼の基本パターン：**\n1. 「お忙しいところ恐れ入ります」（相手の状況を認める）\n2. 「〇〇の件でご相談がございます」（「お願い」より「相談」が良い）\n3. 「まずは今の状況を教えていただけますか」（相手の都合を先に聞く）\n\n**言い換え例：**\n- ×「忙しいと思いますけど…お願いできませんか…」（自信なさすぎ）\n- 〇「ご相談がございます。スケジュールを含めて、一緒に調整できればと」（前向きに）","more":"ISFPは**「場の空気を読む力」**が圧倒的に高い。これは、他部署への依頼でも「相手が今どういう状況か」を的確に把握できるという長所になる。ただし、読んだ空気に行動が引っ張られすぎないように。空気を読むのは**「どう切り出すか」に活かす**ものであって、「切り出すかどうか」を決めるものではない。勇気を出して一歩を踏み出してみましょう。"}},"ESFJ":{"1":{"situation":"あなたは社内プロジェクトのリーダーを任されている。\n来週金曜が納期の重要な成果物について、協力会社からの納品遅延が判明。全体スケジュールが3日ほど後ろ倒しになる見込みだ。\n\n田中部長（プロジェクト責任者）にこの事実を報告し、今後の対応を相談しなければならない。","kiridashi":{"A":"「部長、今お時間よろしいでしょうか。〇〇プロジェクトについて、ご報告とご相談がございます」","B":"「部長、〇〇プロジェクトの件なんですが、まずは関係各所に状況を共有して、それから部長にもご報告したいと思っていて…」","C":"「部長…あの…〇〇プロジェクトの件で…ちょっとご相談が…」","D":"「部長、〇〇プロジェクトの進捗について、関係者全員に共有すべきことがあります」","correct":"A"},"furumai":{"A":"資料を手に持ち、相手の目を見て、落ち着いた声ではじめる","B":"関係者全員にまず連絡してから、部長に報告するという順序を説明する","C":"姿勢を低くし、申し訳なさそうな表情で切り出す","D":"「関係者を集めて一緒に報告した方がいいでしょうか」と聞く","correct":"A"},"result":"A + A","naze":"「今お時間よろしいでしょうか」は、相手の状況を尊重する基本の切り出し。田中部長は多忙な管理職だから、いきなり本題に入られると心の準備ができていない。\n\n「ご報告とご相談がございます」と伝えることで、**話の目的を先に示して、相手に受け止める準備を促せる**。この一言があれば、悪い報告でも受け入れられやすくなる。","otoshiana":"ESFJは**「関係者を巻き込むことが丁寧な対応」**と思いがち。Bの切り出し方はまさにそのパターン。関係各所に先に共有してから部長に報告すると、部長は「なぜ自分に先に言わなかったのか」と不信感を持つ。\n\nもう一つ注意。ESFJは**「誰に言うべきか迷って、報告が複雑になる」**癖がある。Dのように「関係者全員に共有」と言いたくなるけど、まず何より優先すべきなのは**プロジェクト責任者である田中部長に直接報告すること**。他の人への共有は、部長と相談してからでいい。","hint":"**悪い報告の3ステップ切り出し：**\n1. 「今お時間よろしいでしょうか」（タイミングの確認）\n2. 「ご報告とご相談がございます」（目的の提示）\n3. 「実は〜」（本題に入る）\n\n**言い換え例：**\n- ×「関係各所にまず共有してからご報告します」（報告ルートの複雑化）\n- 〇「スケジュールに影響が出る可能性があり、ご相談がございます」（まず責任者に直接）","more":"報連相の基本原則は**「悪い報告ほど早く、でも丁寧に」**。ESFJは周りへの配慮が行き届く分、**「誰にどう伝えるか」で迷いすぎる**傾向がある。迷ったときはシンプルに考える。「この件の責任者は誰か？」その人にまず報告する。それがおすすめ。情報共有の優先順位を整理する力は、リーダーとしての信頼に直結する。"},"2":{"situation":"あなたは新規プロジェクトのメンバーとして参加している。\n同僚の佐藤さんが担当しているデザイン作業の進捗が予定より遅れており、このままではあなたの担当領域（フロントエンド実装）の着手にも影響が出そうだ。\n\n佐藤さんに状況を確認し、どう進めるか話し合いたい。","kiridashi":{"A":"「佐藤さん、今ちょっといいかな。プロジェクトの進捗について、確認と相談があるんだけど」","B":"「佐藤さん、デザインの進捗どう？ みんなでスケジュール会議した方がいいかな？ プロジェクトマネージャーにも入ってもらった方がいい？」","C":"「佐藤さん…お忙しいと思いますが…デザインの件でちょっと気になってて…」","D":"「佐藤さん、デザインの進捗どうなってる？ これ以上遅れると俺の作業に響くんだけど」","correct":"A"},"furumai":{"A":"まず相手の状況を聞き、「一緒に進め方を考えたい」と協力姿勢を示す","B":"「チーム全員で進捗会議を開いて、みんなで話し合って決めよう」と提案する","C":"「いつ頃できそう？」と相手のペースに任せる","D":"「手伝おうか？」と相手の作業に直接介入する","correct":"A"},"result":"A + A","naze":"同僚関係は上下関係ではない。対等な立場だからこそ、「確認と相談」という言葉で**相手を責めるのではなく、一緒に考える姿勢**を見せることが大切。\n\nわざわざ会議を開いたりマネージャーを巻き込んだりしなくても、まずは当事者同士で話し合えば解決できることが多い。シンプルなコミュニケーションが効果的。","otoshiana":"ESFJは**「みんなで話し合って合意を取るのが良い進め方」**と思いがち。Bの切り出し方はまさにそのパターン。全員の意見を聞いてから決めようとすると、解決が遅れるし、佐藤さんにとっては「わざわざ会議にされる＝問題を大きくされた」と感じる。\n\nもう一つ注意。ESFJは**「チームの空気を大切にするあまり、問題を先送りする」**傾向がある。Cのように相手のペースに任せているうちに、自分の作業にも遅れが出てしまう。まずは当事者同士で直接、率直に話し合うのが、結果的にチームのためにもつながりやすい。","hint":"**同僚への「確認＋相談」の基本パターン：**\n1. 「今ちょっといいかな」（タイミング確認）\n2. 「〇〇の件で、確認と相談があるんだけど」（目的を先に伝える）\n3. 「今どんな状況か教えてもらえる？」（相手の状況を先に聞く）\n\n**言い換え例：**\n- ×「みんなで会議して決めよう」（合意取りすぎ）\n- 〇「一緒にスケジュール調整できないかな」（当事者同士で直接）","more":"この場面で使えるのが**「水平型コミュニケーション」**。上下関係ではなく対等な関係性で課題を解決するアプローチ。ESFJはチームワークが得意な分、**「関係者を増やしすぎる」**のが落とし穴。シンプルに考えると、「問題は誰と誰の間にあるか？」それが分かれば、その2人で直接話せばいい。周りを巻き込むのは、2人で解決できなかったときで十分。"},"3":{"situation":"あなたはチームのサブリーダー。入社2年目の後輩・高橋さんが、クライアント向けの提案資料に複数のデータミスを混入させてしまった。\n幸い提出前にあなたが発見したが、高橋さんにはミスの原因を理解してもらい、同じ間違いを繰り返さないように指導したい。","kiridashi":{"A":"「高橋さん、提出前の資料チェックしてて気になった点があったんだけど、ちょっと見てくれる？」","B":"「高橋さん、資料全体すごく頑張って作ってくれたね！ 全体的にすごくいい感じなんだけど、少しだけ直すところがあって…」","C":"「高橋さん…資料なんだけど…ちょっと直したいところがあって…」","D":"「高橋さん、データの検証プロセスについて、後で時間もらえる？」","correct":"A"},"furumai":{"A":"具体的にどこが違うかを示し、「どうやって確認したか教えてくれる？」と原因を一緒に考える","B":"まず褒めることに時間をかけ、「でもね、ここが…」と気を遣いながら遠回しに指摘する","C":"「まあ提出前でよかったね」と軽く流す","D":"「これくらいのミス、自分で気づかないとまずいよ」と厳しく指導する","correct":"A"},"result":"A + A","naze":"「気になった点がある」という言い方は、ミスを**「指摘」ではなく「一緒に確認」**というフレームに変えている。後輩が防御的になるのを防げる。\n\n「どうやって確認したか教えてくれる？」と問いかけることで、相手に自分で気づく機会を与えている。自分で見つけたミスの方が、次から意識に残りやすい。","otoshiana":"ESFJは**「後輩を褒めて、モチベーションを上げるのが先」**と思いがち。Bの対応はまさにそのパターン。褒めること自体は悪くないけど、時間をかけすぎると「じゃあ何が問題なの？」と伝えるべきことがぼやける。\n\nもう一つ注意。ESFJは**「改善点を指摘するのが苦手」**。「すごくいい感じなんだけど…」と言い始めて、肝心の指摘が遠回しすぎて伝わらない。後輩は「褒められた」とだけ受け取って、修正点を理解しない可能性もある。**褒めるのは手短に、指摘は具体的に**。このバランスを意識すると良い。","hint":"**後輩へのフィードバックの基本パターン：**\n1. 「ちょっと見てくれる？」（共に確認する姿勢）\n2. 「ここ、〇〇と××で数字が違うね」（事実を具体的に指摘）\n3. 「どうやって確認したか教えてもらえる？」（プロセスを一緒に振り返る）\n\n**言い換え例：**\n- ×「すごく頑張ってくれたね！ 全体的にいい感じ！ でも少しだけ…」（遠回しすぎ）\n- 〇「ここ、元のデータと数字が合わないんだけど、どこから持ってきたか一緒に見てみよう」（直接＋協力の姿勢）","more":"後輩指導で意識したいのが**「コーチング」**の考え方。答えを教えるのではなく、質問で相手の思考を引き出すアプローチ。ESFJは人の感情に敏感だから、後輩を傷つけまいとして指摘をぼやかしがち。でも**「優しく伝えること」と「曖昧に伝えること」は違う**。はっきり具体的に、でも温かい態度で。これができる指導者は、後輩から信頼されやすい。"},"4":{"situation":"あなたはWeb制作会社のプロジェクトマネージャー。\nクライアントの鈴木社長から「納品前に機能を追加したい」という要望が入った。仕様は既に確定し、追加費用の予算はない。\n\n追加費用なしでは対応が難しいが、クライアントとの関係も悪くしたくない。鈴木社長に対応方針を伝える必要がある。","kiridashi":{"A":"「鈴木社長、ご要望ありがとうございます。一度内容を整理させていただき、改めてご提案してもよろしいでしょうか」","B":"「鈴木社長、もちろんです！ ご要望にお応えできるよう全力で対応いたしますね」","C":"「鈴木社長…ご希望はできるだけお応えしたいのですが…社内で検討させていただけますか…」","D":"「鈴木社長、今回は仕様が確定しておりますので、その機能については次回のタイミングで検討させてください」","correct":"A"},"furumai":{"A":"相手の要望の背景を質問で深掘りし、本当に必要なものを一緒に整理する","B":"「鈴木社長との関係が一番大切ですから」と、条件面での妥協を急ぐ","C":"「何とかします」と安請け合いして、後で社内に持ち帰る","D":"「今回は難しいですが、次回の改修で対応しましょう」と先延ばしする","correct":"A"},"result":"A + A","naze":"クライアントの要望をまず受け止めることが出発点。「ありがとうございます」で相手の提案を尊重しつつ、「整理して改めてご提案」と**即答を避けて考える時間を確保**している。\n\n相手の要望の背景を深掘りすることで、実は予算内で代替できる方法が見つかることが多い。まずは聞いて、それから一緒に解決策を探るのがおすすめ。","otoshiana":"ESFJは**「クライアントとの関係を何より優先する」**あまり、Bのように即座に「もちろん！」と受けがち。関係を守ることは大切だけど、安請け合いして後で自社が苦しむと、結局そのしわ寄せが品質や納期に影響して、関係を損なう。\n\nもう一つ注意。ESFJは**「相手に喜んでもらうこと」を優先しすぎて、条件交渉で妥協しがち**。Cのように「検討します」と濁すのも、結局「何とかするつもり」があるから。**「関係を守る」と「条件を守る」は両立できる**。そのためには、まず相手の真のニーズを聞いて、予算内で応えられる提案を考えることが大切。","hint":"**クライアントの追加要望への3ステップ：**\n1. 「ありがとうございます／ご要望、承知しました」（まず受け止める）\n2. 「少し具体的に教えても良いですか？ どういう場面で使いたいかなど」（背景を深掘り）\n3. 「整理して、〇日までにご提案します」（即答せず時間をもらう）\n\n**言い換え例：**\n- ×「もちろんです！ 全力で対応しますね！」（安請け合い）\n- 〇「ご要望の意図を教えていただければ、ベストな提案ができます」（協力の姿勢＋境界線）","more":"この場面で鍵になるのが**「ニーズの背後にあるニーズ」**を探るスキル。ESFJは人間関係を大切にするからこそ、**「喜ばれること」と「正しいこと」が一致しない場面**で苦しくなる。でも実は、クライアントが求めているのは「何でも言うことを聞く制作会社」ではなく「適切なアドバイスをしてくれるパートナー」。条件を守りつつ、誠実に提案する姿勢こそが、長期的な信頼につながる。"},"5":{"situation":"あなたはマーケティング部門のメンバー。来月実施するキャンペーンの企画が承認されたが、実行にはシステム部門の協力（LPの開発とサーバー準備）が必要だ。\n\nシステム部門は今、自社サービスの大型リリース準備で忙しいと聞いている。システム部門の山田課長に協力を依頼しなければならない。","kiridashi":{"A":"「山田課長、お忙しいところ恐れ入ります。マーケティングの〇〇キャンペーンの件で、ご相談がございます」","B":"「山田課長、お疲れ様です！ 先日リリース準備お疲れ様でした。そういえば〇〇キャンペーンの件なんですが、お時間ある時にお話しできればと…」","C":"「山田課長…システム部門いま忙しいとお聞きしてるんですが…実はお願いがあって…」","D":"「山田課長、〇〇キャンペーンの件ですが、経営陣からも優先度高いプロジェクトなので、ご協力をお願いします」","correct":"A"},"furumai":{"A":"相手の都合を先に聞き、こちらの要件を共有した上で「一緒にスケジュールを調整できないか」と提案する","B":"挨拶と雑談を長く続けてから、ようやく本題に入る","C":"「いつ頃なら対応可能ですか？」と相手の都合に完全に委ねる","D":"自分の上長にエスカレーションして、正式な依頼ルートを回す","correct":"A"},"result":"A + A","naze":"他部署への依頼は、社内とはいえ**「相手にも相手の仕事がある」**ことが前提。まず「お忙しいところ恐れ入ります」と相手の状況を認めることで、「こちらの事情を押し付けるつもりはない」というサインになる。\n\n「ご相談がございます」という言葉で、一方的な依頼ではなく**双方向の話し合いの姿勢**を示せている。これで相手も「なんとかしよう」という気になりやすくなる。","otoshiana":"ESFJは**「まずは雑談で関係を築くと信頼につながりやすい」**と思いがち。Bの切り出し方はまさにそのパターン。挨拶や雑談は確かに大切だけど、相手が忙しいときに長い前振りがあると「用件は何？」とイライラさせてしまう。\n\nもう一つ注意。ESFJは**「空気を読みすぎて、本題に入るタイミングを逃す」**傾向がある。山田課長は今、リリース準備で忙しい。そんな時に雑談を長くされるのは、かえって迷惑。**「短い挨拶＋すぐ本題」**が、忙しい人への配慮としておすすめ。","hint":"**他部署への依頼の基本パターン：**\n1. 「お忙しいところ恐れ入ります」（相手の状況を認める）\n2. 「〇〇の件でご相談がございます」（「お願い」より「相談」が良い）\n3. 「まずは今の状況を教えていただけますか」（相手の都合を先に聞く）\n\n**言い換え例：**\n- ×「先日リリース準備お疲れ様でした！ そういえば…その…キャンペーンの件で…」（長い前振り）\n- 〇「お忙しいところ恐れ入ります。〇〇の件でご相談がございます。まずは今の状況を教えていただけますか」（手短に＋本題へ）","more":"他部署との協力で意識したいのが**「組織横断的コミュニケーション」**のスキル。ESFJは関係構築が得意だから、普段から他部署とコミュニケーションを取っておくのは素晴らしい強み。ただ**「関係構築のタイミング」と「依頼のタイミング」は分ける**のがコツ。普段の雑談で関係を作っておいて、依頼のときは手短に本題に入る。この使い分けができると、頼み事も通りやすくなる。"}},"ISTJ":{"1":{"situation":"あなたは社内プロジェクトのリーダーを任されている。\n来週金曜が納期の重要な成果物について、協力会社からの納品遅延が判明。全体スケジュールが3日ほど後ろ倒しになる見込みだ。\n\n田中部長（プロジェクト責任者）にこの事実を報告し、今後の対応を相談しなければならない。","kiridashi":{"A":"「部長、今お時間よろしいでしょうか。〇〇プロジェクトについて、ご報告とご相談がございます」","B":"「部長、前回の〇〇プロジェクトで類似の遅延があった際はどう対応されましたか。確認させてください」","C":"「部長…あの…〇〇プロジェクトの件で…ちょっとご相談が…」","D":"「部長、〇〇プロジェクトの進捗報告書を提出します。3ページ目に遅延の記載があります」","correct":"A"},"furumai":{"A":"資料を手に持ち、相手の目を見て、落ち着いた声ではじめる","B":"過去の類似ケースの資料を探しながら、「前例を確認してからお答えします」と答える","C":"姿勢を低くし、申し訳なさそうな表情で切り出す","D":"報告書を丁寧に綴じて渡し、「まずはこちらをご覧ください」と文書で伝える","correct":"A"},"result":"A + A","naze":"「今お時間よろしいでしょうか」は、相手の状況を尊重する基本の切り出し。田中部長は多忙な管理職だから、いきなり本題に入られると心の準備ができていない。\n\n「ご報告とご相談がございます」と伝えることで、**話の目的を先に示して、相手に受け止める準備を促せる**。これだけで、悪い報告でも受け入れられやすくなる。","otoshiana":"ISTJは**「前例やルールに従って進めるのが基本」**と考えがち。Bの切り出し方はまさにそのパターン。「過去どうだったか」を調べるのは大切だけど、遅延が判明した今は**まず報告すること**が何より優先。\n\nもう一つ注意。ISTJは**「正確な報告書を完成させてから報告しよう」**として、結果的に報告が遅れがち。Dのように文書で完璧にまとめてから渡すのも一つの手だけど、口頭で第一報を入れてから文書を渡すのがおすすめのステップ。","hint":"**悪い報告の3ステップ切り出し：**\n1. 「今お時間よろしいでしょうか」（タイミングの確認）\n2. 「ご報告とご相談がございます」（目的の提示）\n3. 「実は〜」（本題に入る）\n\n**言い換え例：**\n- ×「前例を確認してからご報告します」（報告の遅れ）\n- 〇「事実が判明した時点でまずご報告し、対策は後ほどご提案します」（迅速な第一報）","more":"報連相の基本原則は**「悪い報告ほど早く、でも丁寧に」**。このスキルには名前があって、**アサーティブコミュニケーション**（自己主張と相手配慮の両立）と呼ばれている。事実を正直に伝えつつ、相手の受け止め方に配慮する。前例に頼る前に、まずは「今、何を伝えるべきか」にフォーカスする癖をつけると良い。"},"2":{"situation":"あなたは新規プロジェクトのメンバーとして参加している。\n同僚の佐藤さんが担当しているデザイン作業の進捗が予定より遅れており、このままではあなたの担当領域（フロントエンド実装）の着手にも影響が出そうだ。\n\n佐藤さんに状況を確認し、どう進めるか話し合いたい。","kiridashi":{"A":"「佐藤さん、今ちょっといいかな。プロジェクトの進捗について、確認と相談があるんだけど」","B":"「佐藤さん、ガントチャートを確認したところ、デザイン工程が2営業日遅延しています。理由を教えてください」","C":"「佐藤さん…お忙しいと思いますが…デザインの件でちょっと気になってて…」","D":"「佐藤さん、デザインの進捗どうなってる？ これ以上遅れると俺の作業に響くんだけど」","correct":"A"},"furumai":{"A":"まず相手の状況を聞き、「一緒に進め方を考えたい」と協力姿勢を示す","B":"プロジェクトの手順書を開き、「本来は〇〇の順序で進めるはずです」と指摘する","C":"「いつ頃できそう？」と相手のペースに任せる","D":"「手伝おうか？」と相手の作業に直接介入する","correct":"A"},"result":"A + A","naze":"同僚関係は上下関係ではない。対等な立場だからこそ、「確認と相談」という言葉で**相手を責めるのではなく、一緒に考える姿勢**を見せることが大切。\n\nいきなり「遅延しています。理由を」と事実と手続きで迫られると、相手は尋問されているように感じてしまう。まずは相手の事情を聞くことで、本当のボトルネックが見えてくる。","otoshiana":"ISTJは**「事実と手順が全て」**と考えがち。Bの切り出し方はまさにそのパターン。ガントチャートや手順書で正確に指摘するのは ISTJ の得意分野だけど、相手は「管理されてる」と感じて警戒してしまう。\n\nもう一つ注意。ISTJは**「正しいやり方があるはず」**と思っているから、相手が手順を変えているとイライラしがち。でも「なぜ遅れているか」には、相手ならではの事情があるかもしれない。まずは聞くことを優先すると良い。","hint":"**同僚への「確認＋相談」の基本パターン：**\n1. 「今ちょっといいかな」（タイミング確認）\n2. 「〇〇の件で、確認と相談があるんだけど」（目的を先に伝える）\n3. 「今どんな状況か教えてもらえる？」（相手の状況を先に聞く）\n\n**言い換え例：**\n- ×「ガントチャート通りに進んでないんですが」（事実の指摘だけ）\n- 〇「一緒にスケジュール調整できないかな」（協力の招待）","more":"この場面で使えるのが**「水平型コミュニケーション」**。上下関係ではなく対等な関係性で課題を解決するアプローチ。同僚との信頼関係は、手順の正しさではなく**「一緒に考える」姿勢**で築かれる。事実は大切だけど、事実だけで相手を動かそうとすると、関係が硬直してしまう。人間の感情に配慮する余白も持っておくと良い。"},"3":{"situation":"あなたはチームのサブリーダー。入社2年目の後輩・高橋さんが、クライアント向けの提案資料に複数のデータミスを混入させてしまった。\n幸い提出前にあなたが発見したが、高橋さんにはミスの原因を理解してもらい、同じ間違いを繰り返さないように指導したい。","kiridashi":{"A":"「高橋さん、提出前の資料チェックしてて気になった点があったんだけど、ちょっと見てくれる？」","B":"「高橋さん、この資料の確認手順を説明します。まず〇〇を確認して、次に××を照合する。この手順通りにやればミスは防げます」","C":"「高橋さん…資料なんだけど…ちょっと直したいところがあって…」","D":"「高橋さん、データの検証プロセスについて、後で時間もらえる？」","correct":"A"},"furumai":{"A":"具体的にどこが違うかを示し、「どうやって確認したか教えてくれる？」と原因を一緒に考える","B":"「確認用のチェックリストを作ったから、これを使って」とマニュアルを渡して終わる","C":"「まあ提出前でよかったね」と軽く流す","D":"「これくらいのミス、自分で気づかないとまずいよ」と厳しく指導する","correct":"A"},"result":"A + A","naze":"「気になった点がある」という言い方は、ミスを**「指摘」ではなく「一緒に確認」**というフレームに変えている。後輩が防御的になるのを防げる。\n\n「ちょっと見てくれる？」と問いかけ形にすることで、相手に自分で気づく機会を与えている。自分で見つけたミスの方が、次から意識に残りやすい。","otoshiana":"ISTJは**「正しい手順を教えれば再発防止になる」**と考えがち。Bの対応はまさにそのパターン。チェックリストやマニュアルは確かに有用だけど、後輩は「言われた通りにやる」だけで終わり、なぜミスが起きたのか根本原因に向き合わない。\n\nもう一つ注意。ISTJは**「ルール通りにやればミスは起きないはず」と考えがち**だから、ミスをした人に対して「手順を守らなかったのか」と思いがち。でも新人のミスの多くは「知らなかった」や「焦っていた」が原因。まずは本人の状況を聞くことが先。","hint":"**後輩へのフィードバックの基本パターン：**\n1. 「ちょっと見てくれる？」（共に確認する姿勢）\n2. 「ここ、〇〇と××で数字が違うね」（事実を具体的に指摘）\n3. 「どうやって確認したか教えてもらえる？」（プロセスを一緒に振り返る）\n\n**言い換え例：**\n- ×「このチェックリストを使えば防げます。次からはこれで」（マニュアルの押し付け）\n- 〇「ここ、元のデータと数字が合わないんだけど、どこから持ってきたか一緒に見てみよう」（一緒に考える姿勢）","more":"後輩指導で意識したいのが**「コーチング」**の考え方。答え（やマニュアル）を渡すのではなく、質問で相手の思考を引き出すアプローチ。ISTJは手順を整備するのが得意だから、ついマニュアルを渡して終わりがち。でも**「TeachではなくAsk」**の原則を意識すると、後輩の成長スピードが劇的に変わる。マニュアルは後で渡してもいい。まずは本人に考えさせることから始めましょう。"},"4":{"situation":"あなたはWeb制作会社のプロジェクトマネージャー。\nクライアントの鈴木社長から「納品前に機能を追加したい」という要望が入った。仕様は既に確定し、追加費用の予算はない。\n\n追加費用なしでは対応が難しいが、クライアントとの関係も悪くしたくない。鈴木社長に対応方針を伝える必要がある。","kiridashi":{"A":"「鈴木社長、ご要望ありがとうございます。一度内容を整理させていただき、改めてご提案してもよろしいでしょうか」","B":"「鈴木社長、契約書の第3条に基づき、仕様確定後の追加機能は別途お見積りとなります。追加費用が発生しますがよろしいですか」","C":"「鈴木社長…ご希望はできるだけお応えしたいのですが…社内で検討させていただけますか…」","D":"「鈴木社長、その機能は今回の要件定義には含まれていません。次期プロジェクトで検討いたしましょう」","correct":"A"},"furumai":{"A":"相手の要望の背景を質問で深掘りし、本当に必要なものを一緒に整理する","B":"契約書と仕様書をその場で開き、「該当箇所はここです」と条項を示す","C":"「何とかします」と安請け合いして、後で社内に持ち帰る","D":"「今回は難しいですが、次回の改修で対応しましょう」と先延ばしする","correct":"A"},"result":"A + A","naze":"クライアントの要望をまず受け止めることが出発点。「ありがとうございます」で相手の提案を尊重しつつ、「整理して改めてご提案」と**即答を避けて考える時間を確保**している。\n\n即座に「契約上は追加費用が必要です」と条文を持ち出す（B）と、相手は突き放されたと感じる。まず相手の真のニーズを理解してから、一緒に解決策を探るのがおすすめ。","otoshiana":"ISTJは**「契約・仕様書は何より大切」**と考える傾向がある。Bの切り出し方はまさにそのパターン。論理的には完璧だけど、ビジネスでは「まず受け止める」ステップを飛ばすと信頼を損なう。\n\nもう一つ注意。ISTJは**「決まったルールには従うのが望ましい」**と思っているから、Dのようにルールで押し返しがち。でもクライアントにとっては、その機能が急に必要になった事情があるはず。契約書を見せる前に、まずは相手の話を聞こう。","hint":"**クライアントの追加要望への3ステップ：**\n1. 「ありがとうございます／ご要望、承知しました」（まず受け止める）\n2. 「少し具体的に教えても良いですか？ どういう場面で使いたいかなど」（背景を深掘り）\n3. 「整理して、〇日までにご提案します」（即答せず時間をもらう）\n\n**言い換え例：**\n- ×「契約上それは範囲外です」（条文で門前払い）\n- 〇「ご要望の意図を教えていただければ、ベストな提案ができます」（協力の姿勢）","more":"この場面で鍵になるのが**「ニーズの背後にあるニーズ」**を探るスキル。顧客が「機能が欲しい」と言うとき、本当は「不安を解消したい」「競合に遅れを取りたくない」など別の理由があることが多い。ISTJは契約の文面に忠実な分、**人間の感情面の背景を見落としがち**。仕様書の1行よりも、クライアントの一言の裏にある思いに耳を傾ける習慣を持つと良い。"},"5":{"situation":"あなたはマーケティング部門のメンバー。来月実施するキャンペーンの企画が承認されたが、実行にはシステム部門の協力（LPの開発とサーバー準備）が必要だ。\n\nシステム部門は今、自社サービスの大型リリース準備で忙しいと聞いている。システム部門の山田課長に協力を依頼しなければならない。","kiridashi":{"A":"「山田課長、お忙しいところ恐れ入ります。マーケティングの〇〇キャンペーンの件で、ご相談がございます」","B":"「山田課長、〇〇キャンペーンのLP開発について、正式な依頼書を作成しました。社内申請ルートに従って提出いたします」","C":"「山田課長…システム部門いま忙しいとお聞きしてるんですが…実はお願いがあって…」","D":"「山田課長、〇〇キャンペーンの件ですが、経営陣からも優先度高いプロジェクトなので、ご協力をお願いします」","correct":"A"},"furumai":{"A":"相手の都合を先に聞き、こちらの要件を共有した上で「一緒にスケジュールを調整できないか」と提案する","B":"「社内の正式な手続きに従って進めたいので、依頼書のフォーマットを教えてください」と確認する","C":"「いつ頃なら対応可能ですか？」と相手の都合に完全に委ねる","D":"自分の上長にエスカレーションして、正式な依頼ルートを回す","correct":"A"},"result":"A + A","naze":"他部署への依頼は、社内とはいえ**「相手にも相手の仕事がある」**ことが前提。まず「お忙しいところ恐れ入ります」と相手の状況を認めることで、「こちらの事情を押し付けるつもりはない」というサインになる。\n\n「ご相談がございます」という言葉で、一方的な依頼ではなく**双方向の話し合いの姿勢**を示せている。これで相手も「なんとかしよう」という気になりやすくなる。","otoshiana":"ISTJは**「正しい手順・ルートで依頼するのが望ましい」**と思いがち。Bの切り出し方はまさにそのパターン。正式な依頼書や社内申請ルートは大切だけど、まずは口頭で「ご相談」して相手の状況を把握するのが先。\n\nもう一つ注意。ISTJは**「ルール通りに進めれば問題ない」と考えがち**だから、Dのように上長にエスカレーションして正式ルートで動かそうとしがち。でも現場同士の人間関係と信頼で動く方が、結果的にスムーズになりやすく、その後の協力も得やすくなる。","hint":"**他部署への依頼の基本パターン：**\n1. 「お忙しいところ恐れ入ります」（相手の状況を認める）\n2. 「〇〇の件でご相談がございます」（「お願い」より「相談」が良い）\n3. 「まずは今の状況を教えていただけますか」（相手の都合を先に聞く）\n\n**言い換え例：**\n- ×「正式な依頼書を提出しますので、確認をお願いします」（手続き優先）\n- 〇「まずはお話しだけでもできればと。〇日が理想ですが、山田課長のスケジュールに合わせて調整できます」（柔軟性を示す）","more":"他部署との協力で意識したいのが**「組織横断的コミュニケーション」**のスキル。手続きやルートの正しさだけで動くのではなく、相手部門の状況や優先事項を理解した上で**「Win-Winになる着地点」**を探る。ISTJの几帳面さは依頼内容を整理するのに活きるけど、相手への配慮を添えることで、依頼の通りやすさが大きく変わってくる。"}},"ISFJ":{"1":{"situation":"あなたは社内プロジェクトのリーダーを任されている。\n来週金曜が納期の重要な成果物について、協力会社からの納品遅延が判明。全体スケジュールが3日ほど後ろ倒しになる見込みだ。\n\n田中部長（プロジェクト責任者）にこの事実を報告し、今後の対応を相談しなければならない。","kiridashi":{"A":"「部長、今お時間よろしいでしょうか。〇〇プロジェクトについて、ご報告とご相談がございます」","B":"「部長…あの…本当に申し訳ないんですが…私のプロジェクトで問題が起きてしまって…」","C":"「部長、ちょっと聞いてもらいたいことがあるんですが、今大丈夫でしょうか…お忙しそうなら後でも…」","D":"「部長、〇〇プロジェクトの進捗について、関係者全員に共有すべきことがあります」","correct":"A"},"furumai":{"A":"資料を手に持ち、相手の目を見て、落ち着いた声ではじめる","B":"何度も「申し訳ありません」と謝りながら、遅延の事実をようやく伝える","C":"部長の表情を気にしながら、遅延の事実をぼかして伝える","D":"「関係者に周知してから報告します」と言って、部長への報告を後回しにする","correct":"A"},"result":"A + A","naze":"「今お時間よろしいでしょうか」は、相手の状況を尊重する基本の切り出し。田中部長は多忙な管理職だから、いきなり本題に入られると心の準備ができていない。\n\n「ご報告とご相談がございます」と伝えることで、**話の目的を先に示して、相手に受け止める準備を促せる**。この一言があれば、悪い報告でも受け入れられやすくなる。","otoshiana":"ISFJは**「上司に悪い報告をするのは申し訳ない」**と感じがち。BやCの切り出し方はまさにそのパターン。謝罪や遠慮が先に来て、肝心の事実が伝わらない。\n\nもう一つ注意。ISFJは**「上司に気を遣いすぎて、悪い報告をため込む」**癖がある。遅延が判明した時点ですぐ報告したほうがいいところを、「部長が忙しそうだから後でいいや」「怒られるかも」と先延ばしして、結果的に事態を悪化させてしまう。報告は早いほど被害が小さくなる。","hint":"**悪い報告の3ステップ切り出し：**\n1. 「今お時間よろしいでしょうか」（タイミングの確認）\n2. 「ご報告とご相談がございます」（目的の提示）\n3. 「実は〜」（本題に入る）\n\n**言い換え例：**\n- ×「申し訳ありません、私のプロジェクトで問題が…」（謝罪が先）\n- 〇「スケジュールに影響が出る可能性があり、ご相談がございます」（事実を先に）","more":"報連相の基本原則は**「悪い報告ほど早く、でも丁寧に」**。ISFJは相手の気持ちを察するのが得意だからこそ、**「悪い報告＝相手を不快にさせる」という思い込み**を手放すことが大切。実は上司にとって何より困るのは「報告されないこと」。報告が遅れる方が、信頼を損ないやすい。この事実を知っておくだけで、報告のハードルがぐんと下がるはず。"},"2":{"situation":"あなたは新規プロジェクトのメンバーとして参加している。\n同僚の佐藤さんが担当しているデザイン作業の進捗が予定より遅れており、このままではあなたの担当領域（フロントエンド実装）の着手にも影響が出そうだ。\n\n佐藤さんに状況を確認し、どう進めるか話し合いたい。","kiridashi":{"A":"「佐藤さん、今ちょっといいかな。プロジェクトの進捗について、確認と相談があるんだけど」","B":"「佐藤さん、デザイン大変そうだね。何か手伝えることあったら言ってね。私の方は全然急いでないから大丈夫だよ」","C":"「佐藤さん…お忙しいと思いますが…デザインの件でちょっと気になってて…」","D":"「佐藤さん、デザインの進捗どうなってる？ これ以上遅れると俺の作業に響くんだけど」","correct":"A"},"furumai":{"A":"まず相手の状況を聞き、「一緒に進め方を考えたい」と協力姿勢を示す","B":"「私がデザインの一部やろうか？ フロントエンドは後でいいし」と自分の作業を後回しにして相手を助ける","C":"「いつ頃できそう？」と相手のペースに任せる","D":"「手伝おうか？」と相手の作業に直接介入する","correct":"A"},"result":"A + A","naze":"同僚関係は上下関係ではない。対等な立場だからこそ、「確認と相談」という言葉で**相手を責めるのではなく、一緒に考える姿勢**を見せることが大切。\n\n自分の作業に影響が出ることをちゃんと伝えつつ、協力姿勢を見せる。このバランスが、同僚との健全な関係を保つコツ。","otoshiana":"ISFJは**「相手の負担を減らすのが思いやり」**と考えがち。Bの切り出し方はまさにそのパターン。「急いでないから大丈夫」と言うのは優しさだけど、それは事実じゃないし、後で自分が苦しくなる。\n\nもう一つ注意。ISFJは**「本来伝えるべきことを我慢して、自分が引き受ける」**癖がある。「私がやろうか？」は一見親切だけど、プロジェクト全体で見ると役割が曖昧になって品質リスクも出る。自分の担当範囲を守りつつ、相手をサポートするのが、結果的に相手のためにもなる。","hint":"**同僚への「確認＋相談」の基本パターン：**\n1. 「今ちょっといいかな」（タイミング確認）\n2. 「〇〇の件で、確認と相談があるんだけど」（目的を先に伝える）\n3. 「今どんな状況か教えてもらえる？」（相手の状況を先に聞く）\n\n**言い換え例：**\n- ×「私の方は全然急いでないから大丈夫だよ」（事実と違うことを言う）\n- 〇「私の作業にも影響が出そうだから、一緒にスケジュール調整できないかな」（正直に＋協力の姿勢）","more":"この場面で使えるのが**「水平型コミュニケーション」**。上下関係ではなく対等な関係性で課題を解決するアプローチ。ISFJは人の役に立ちたい気持ちが強いから、つい自分を犠牲にしがち。でも**「適切な境界線を引くこと」も優しさ**。自分が倒れたら誰の助けにもならない。まずは正直に状況を共有して、一緒に解決策を探る関係性を大切にすると良い。"},"3":{"situation":"あなたはチームのサブリーダー。入社2年目の後輩・高橋さんが、クライアント向けの提案資料に複数のデータミスを混入させてしまった。\n幸い提出前にあなたが発見したが、高橋さんにはミスの原因を理解してもらい、同じ間違いを繰り返さないように指導したい。","kiridashi":{"A":"「高橋さん、提出前の資料チェックしてて気になった点があったんだけど、ちょっと見てくれる？」","B":"「高橋さん、大丈夫だよ。私も入社2年目の頃よくミスしてたから。直しておくね」","C":"「高橋さん…資料なんだけど…ちょっと直したいところがあって…」","D":"「高橋さん、データの検証プロセスについて、後で時間もらえる？」","correct":"A"},"furumai":{"A":"具体的にどこが違うかを示し、「どうやって確認したか教えてくれる？」と原因を一緒に考える","B":"「私が直しておくから大丈夫」と言って、自分で修正してしまう","C":"「まあ提出前でよかったね」と軽く流す","D":"「これくらいのミス、自分で気づかないとまずいよ」と厳しく指導する","correct":"A"},"result":"A + A","naze":"「気になった点がある」という言い方は、ミスを**「指摘」ではなく「一緒に確認」**というフレームに変えている。後輩が防御的になるのを防げる。\n\n「どうやって確認したか教えてくれる？」と問いかけることで、後輩自身に原因を考えてもらう。自分で気づいた改善点の方が、次から意識に残りやすい。","otoshiana":"ISFJは**「後輩を守りたい、傷つけたくない」**気持ちが強い。Bの対応はまさにそのパターン。「私が直しておくね」は一見優しさだけど、後輩にとっては学びの機会を奪うことになる。\n\nもう一つ注意。ISFJは**「厳しくすべき場面で指摘が甘くなる」**癖がある。Cのように「提出前でよかったね」で流してしまうと、後輩は「ミスしても大丈夫」と甘く捉えてしまう。優しく包み込むだけでなく、**「次からどう防ぐか」まで踏み込む**のが、長期的に見ると後輩のためにもなる。","hint":"**後輩へのフィードバックの基本パターン：**\n1. 「ちょっと見てくれる？」（共に確認する姿勢）\n2. 「ここ、〇〇と××で数字が違うね」（事実を具体的に指摘）\n3. 「どうやって確認したか教えてもらえる？」（プロセスを一緒に振り返る）\n\n**言い換え例：**\n- ×「私が直しておくから大丈夫だよ」（学びの機会を奪う）\n- 〇「ここ、元のデータと数字が合わないんだけど、どこから持ってきたか一緒に見てみよう」（一緒に考える姿勢）","more":"後輩指導で意識したいのが**「コーチング」**の考え方。答えを教えるのではなく、質問で相手の思考を引き出すアプローチ。ISFJは「代わりにやってあげる」ことで愛情を示しがちだけど、成長を考えると**「自分で気づかせて、自分で直させる」**方が結果的に後輩のため。短期的な優しさと長期的な成長、どちらを大切にするかで指導の質が変わってくる。"},"4":{"situation":"あなたはWeb制作会社のプロジェクトマネージャー。\nクライアントの鈴木社長から「納品前に機能を追加したい」という要望が入った。仕様は既に確定し、追加費用の予算はない。\n\n追加費用なしでは対応が難しいが、クライアントとの関係も悪くしたくない。鈴木社長に対応方針を伝える必要がある。","kiridashi":{"A":"「鈴木社長、ご要望ありがとうございます。一度内容を整理させていただき、改めてご提案してもよろしいでしょうか」","B":"「鈴木社長、もちろんです。何とか予算内で収まるよう、社内で調整いたしますね」","C":"「鈴木社長…ご希望はできるだけお応えしたいのですが…社内で検討させていただけますか…」","D":"「鈴木社長、今回は仕様が確定しておりますので、その機能については次回のタイミングで検討させてください」","correct":"A"},"furumai":{"A":"相手の要望の背景を質問で深掘りし、本当に必要なものを一緒に整理する","B":"「社内で何とか調整します」と言って、自社のチームにしわ寄せを押し付ける","C":"「何とかします」と安請け合いして、後で社内に持ち帰る","D":"「今回は難しいですが、次回の改修で対応しましょう」と先延ばしする","correct":"A"},"result":"A + A","naze":"クライアントの要望をまず受け止めることが出発点。「ありがとうございます」で相手の提案を尊重しつつ、「整理して改めてご提案」と**即答を避けて考える時間を確保**している。\n\n相手の要望の背景を深掘りすることで、実は予算内で代替できる方法が見つかることが多い。まずは聞いて、それから一緒に解決策を探るのがおすすめ。","otoshiana":"ISFJは**「クライアントの役に立ちたい、喜ばせたい」**気持ちが強い。Bの切り出し方はまさにそのパターン。「何とかします」と安請け合いして、しわ寄せが自社チームにいくのは避けたいところ。\n\nもう一つ注意。ISFJは**「対立を避けるために、言えるべきことを言えない」**癖がある。Cのように「検討します」と濁して結局何も進まないパターンも要注意。クライアントに誠実であることは、何でもかんでも受け入れることじゃない。**「誠実に、正直に、でも丁寧に」**がおすすめの姿勢。","hint":"**クライアントの追加要望への3ステップ：**\n1. 「ありがとうございます／ご要望、承知しました」（まず受け止める）\n2. 「少し具体的に教えても良いですか？ どういう場面で使いたいかなど」（背景を深掘り）\n3. 「整理して、〇日までにご提案します」（即答せず時間をもらう）\n\n**言い換え例：**\n- ×「何とか予算内で調整しますね」（安請け合い）\n- 〇「ご要望の意図を教えていただければ、ベストな提案ができます」（協力の姿勢＋境界線）","more":"この場面で鍵になるのが**「ニーズの背後にあるニーズ」**を探るスキル。ISFJは人のために尽くすのが得意な分、**「尽くすこと」と「境界線を守ること」のバランス**が課題。クライアントに誠実であることと、自社を守ることは両立できる。「まず聞く、整理する、それから提案する」という手順を踏めば、関係を悪くせずに条件を守れる。"},"5":{"situation":"あなたはマーケティング部門のメンバー。来月実施するキャンペーンの企画が承認されたが、実行にはシステム部門の協力（LPの開発とサーバー準備）が必要だ。\n\nシステム部門は今、自社サービスの大型リリース準備で忙しいと聞いている。システム部門の山田課長に協力を依頼しなければならない。","kiridashi":{"A":"「山田課長、お忙しいところ恐れ入ります。マーケティングの〇〇キャンペーンの件で、ご相談がございます」","B":"「山田課長…システム部門いま本当に忙しいと思いますが…無理言って申し訳ないんですが…キャンペーンの件で少しだけお時間いただけますか…」","C":"「山田課長、〇〇キャンペーンの件ですが、急ぎではないので、システム部門の都合の良いタイミングで大丈夫です」","D":"「山田課長、〇〇キャンペーンの件ですが、経営陣からも優先度高いプロジェクトなので、ご協力をお願いします」","correct":"A"},"furumai":{"A":"相手の都合を先に聞き、こちらの要件を共有した上で「一緒にスケジュールを調整できないか」と提案する","B":"「お忙しいのは分かるので、最低限これだけでも…」と要件を極端に減らして頼む","C":"「いつ頃なら対応可能ですか？」と相手の都合に完全に委ねる","D":"自分の上長にエスカレーションして、正式な依頼ルートを回す","correct":"A"},"result":"A + A","naze":"他部署への依頼は、社内とはいえ**「相手にも相手の仕事がある」**ことが前提。まず「お忙しいところ恐れ入ります」と相手の状況を認めることで、「こちらの事情を押し付けるつもりはない」というサインになる。\n\n「ご相談がございます」という言葉で、一方的な依頼ではなく**双方向の話し合いの姿勢**を示せている。これで相手も「なんとかしよう」という気になりやすくなる。","otoshiana":"ISFJは**「相手の負担を気にしすぎて、必要な依頼が遅れる」**癖がある。Bの切り出し方はまさにそのパターン。謝罪と遠慮が前に出すぎて、肝心の依頼内容が伝わりにくい。\n\nもう一つ注意。ISFJは**「相手の都合を優先して、自分の要件を下げてしまう」**傾向がある。Cのように「急ぎではない」と言うのは優しさだけど、実際は急ぎの案件。相手に誤った情報を渡すと、結果的にトラブルになる。正直に要件を伝えた上で、調整を提案するのが、相手への配慮として望ましい。","hint":"**他部署への依頼の基本パターン：**\n1. 「お忙しいところ恐れ入ります」（相手の状況を認める）\n2. 「〇〇の件でご相談がございます」（「お願い」より「相談」が良い）\n3. 「まずは今の状況を教えていただけますか」（相手の都合を先に聞く）\n\n**言い換え例：**\n- ×「急ぎじゃないので、いつでも大丈夫です」（事実と違う譲歩）\n- 〇「〇日が理想ですが、山田課長のスケジュールに合わせて調整できます」（正直に＋柔軟性）","more":"他部署との協力で意識したいのが**「組織横断的コミュニケーション」**のスキル。ISFJは相手の気持ちを汲むのが得意だから、そこは強みとして活かせる。ただ**「配慮」と「へりくだり」は違う**。相手を尊重しつつも、自分の要件ははっきり伝える。このバランスが取れると、社内での信頼が高まりやすい。"}},"ESTJ":{"1":{"situation":"あなたは社内プロジェクトのリーダーを任されている。\n来週金曜が納期の重要な成果物について、協力会社からの納品遅延が判明。全体スケジュールが3日ほど後ろ倒しになる見込みだ。\n\n田中部長（プロジェクト責任者）にこの事実を報告し、今後の対応を相談しなければならない。","kiridashi":{"A":"「部長、今お時間よろしいでしょうか。〇〇プロジェクトについて、ご報告とご相談がございます」","B":"「部長、〇〇プロジェクトの遅延対応ですが、私の判断でこう進めます。これで問題ないですよね？」","C":"「部長…あの…〇〇プロジェクトの件で…ちょっとご相談が…」","D":"「部長、協力会社が納品を遅らせました。今後の対応として、私が直接協力会社に交渉してきます」","correct":"A"},"furumai":{"A":"資料を手に持ち、相手の目を見て、落ち着いた声ではじめる","B":"自分の対策案を力強く説明し、「こうすべきだ」と意見を強く押す","C":"姿勢を低くし、申し訳なさそうな表情で切り出す","D":"立ち上がってホワイトボードに図を書き、即座に解決策を説明し始める","correct":"A"},"result":"A + A","naze":"「今お時間よろしいでしょうか」は、相手の状況を尊重する基本の切り出し。田中部長は多忙な管理職だから、いきなり本題に入られると心の準備ができていない。\n\n「ご報告とご相談がございます」と伝えることで、**話の目的を先に示して、相手に受け止める準備を促せる**。「報告」ではなく「相談」の姿勢で伝えることで、部長も一緒に考えてもらいやすくなる。","otoshiana":"ESTJは**「結論と指示を早く出すのが仕事」**と考えがち。Bの切り出し方はまさにそのパターン。「私の判断でこう進めます」は行動力があるように見えるけど、プロジェクト責任者は田中部長。勝手に進めると信頼を損なう。\n\nもう一つ注意。ESTJは**「報告というより、自分の意見を押し通す」**傾向がある。Dのように自分が直接解決に動くのも頼もしいけど、まずは状況を報告して部長の判断を仰ぐのが望ましい手順。**「報告してから動く」**この順番を意識すると良い。","hint":"**悪い報告の3ステップ切り出し：**\n1. 「今お時間よろしいでしょうか」（タイミングの確認）\n2. 「ご報告とご相談がございます」（目的の提示）\n3. 「実は〜」（本題に入る）\n\n**言い換え例：**\n- ×「私の判断でこう進めます。問題ないですよね？」（指示の押し付け）\n- 〇「スケジュールに影響が出ます。ご報告とご相談がございます」（相手を招待する表現）","more":"報連相の基本原則は**「悪い報告ほど早く、でも丁寧に」**。このスキルには**アサーティブコミュニケーション**（自己主張と相手配慮の両立）という名前がついている。ESTJは自己主張が強い分、**相手の立場に立つ練習**が特に効果的。自分の判断の速さは強みだけど、報告すべき相手にちゃんと報告する。この一歩で、周りからの信頼がさらに高まりやすい。"},"2":{"situation":"あなたは新規プロジェクトのメンバーとして参加している。\n同僚の佐藤さんが担当しているデザイン作業の進捗が予定より遅れており、このままではあなたの担当領域（フロントエンド実装）の着手にも影響が出そうだ。\n\n佐藤さんに状況を確認し、どう進めるか話し合いたい。","kiridashi":{"A":"「佐藤さん、今ちょっといいかな。プロジェクトの進捗について、確認と相談があるんだけど」","B":"「佐藤さん、デザイン遅れてるよね。明日までに完了させてもらえる？ そうしないと次の工程に響くから」","C":"「佐藤さん…お忙しいと思いますが…デザインの件でちょっと気になってて…」","D":"「佐藤さん、デザインの進捗どうなってる？ これ以上遅れると俺の作業に響くんだけど」","correct":"A"},"furumai":{"A":"まず相手の状況を聞き、「一緒に進め方を考えたい」と協力姿勢を示す","B":"「じゃあ優先順位を変えて、これを先にやって」と指示を出す","C":"「いつ頃できそう？」と相手のペースに任せる","D":"「手伝おうか？」と相手の作業に直接介入する","correct":"A"},"result":"A + A","naze":"同僚関係は上下関係ではない。対等な立場だからこそ、「確認と相談」という言葉で**相手を責めるのではなく、一緒に考える姿勢**を見せることが大切。\n\nいきなり「明日までに完了させて」と指示を出すと、相手は「同僚なのに指示されている」と不快感を持つ。まずは相手の事情を聞くことで、本当のボトルネックが見えてくる。","otoshiana":"ESTJは**「効率よく進めるには指示を出すのが効果的」**と思いがち。Bの切り出し方はまさにそのパターン。同僚に対してまで指示口調になると、対等な関係ではなく上下関係を作ってしまう。\n\nもう一つ注意。ESTJは**「結果が出ていない人には強く当たる」**傾向がある。Dのように相手の作業をコントロールしようとすると、相手は反発するか萎縮する。同僚なら「どう進めるか一緒に考えよう」というスタンスが、結果的にも効率的な進め方になりやすい。","hint":"**同僚への「確認＋相談」の基本パターン：**\n1. 「今ちょっといいかな」（タイミング確認）\n2. 「〇〇の件で、確認と相談があるんだけど」（目的を先に伝える）\n3. 「今どんな状況か教えてもらえる？」（相手の状況を先に聞く）\n\n**言い換え例：**\n- ×「明日までに完了させて。そうしないと次に響く」（指示命令）\n- 〇「一緒にスケジュール調整できないかな」（協力の招待）","more":"この場面で使えるのが**「水平型コミュニケーション」**。上下関係ではなく対等な関係性で課題を解決するアプローチ。ESTJは組織を動かすのが得意だから、ついリーダーシップを発揮してしまう。でも同僚相手には**「リーダー」ではなく「パートナー」**として振る舞うのがおすすめ。指示で動く仲間より、自発的に協力してくれる仲間の方が、成果も良くなりやすい。"},"3":{"situation":"あなたはチームのサブリーダー。入社2年目の後輩・高橋さんが、クライアント向けの提案資料に複数のデータミスを混入させてしまった。\n幸い提出前にあなたが発見したが、高橋さんにはミスの原因を理解してもらい、同じ間違いを繰り返さないように指導したい。","kiridashi":{"A":"「高橋さん、提出前の資料チェックしてて気になった点があったんだけど、ちょっと見てくれる？」","B":"「高橋さん、この資料の〇〇ページ、数値が間違ってる。何やってるの？ 確認しなかったの？」","C":"「高橋さん…資料なんだけど…ちょっと直したいところがあって…」","D":"「高橋さん、データの検証プロセスについて、後で時間もらえる？」","correct":"A"},"furumai":{"A":"具体的にどこが違うかを示し、「どうやって確認したか教えてくれる？」と原因を一緒に考える","B":"「ここからここまで間違ってる。直して。これ以後やったら不信感持つからね」と厳しく指摘する","C":"「まあ提出前でよかったね」と軽く流す","D":"「これくらいのミス、自分で気づかないとまずいよ」と厳しく指導する","correct":"A"},"result":"A + A","naze":"「気になった点がある」という言い方は、ミスを**「指摘」ではなく「一緒に確認」**というフレームに変えている。後輩が防御的になるのを防げる。\n\n「どうやって確認したか教えてくれる？」と問いかけることで、相手に自分で気づく機会を与えている。自分で見つけたミスの方が、次から意識に残りやすい。","otoshiana":"ESTJは**「ミスは許されない。厳しく指摘するのが指導だ」**と考えがち。Bの対応はまさにそのパターン。「何やってるの？」「確認しなかったの？」と追い詰めると、後輩は萎縮して、逆にミスが増える。\n\nもう一つ注意。ESTJは**「指導というより叱責になりがち」**。Dのように「自分で気づかないとまずい」と正論で押しても、後輩は「怒られた」という感情だけが残る。指導の目的は**「次から防ぐこと」**であって、「怒ること」じゃない。まずは安心させてから、原因を一緒に考えるのがおすすめ。","hint":"**後輩へのフィードバックの基本パターン：**\n1. 「ちょっと見てくれる？」（共に確認する姿勢）\n2. 「ここ、〇〇と××で数字が違うね」（事実を具体的に指摘）\n3. 「どうやって確認したか教えてもらえる？」（プロセスを一緒に振り返る）\n\n**言い換え例：**\n- ×「何やってるの？ 確認しなかったの？」（叱責）\n- 〇「ここ、元のデータと数字が合わないんだけど、どこから持ってきたか一緒に見てみよう」（一緒に考える姿勢）","more":"後輩指導で意識したいのが**「コーチング」**の考え方。答えを教えるのではなく、質問で相手の思考を引き出すアプローチ。ESTJは結果主義だから「なぜできなかったんだ」と感情を出しがち。でも**「TeachではなくAsk」**の原則を意識すると、後輩の成長スピードが劇的に変わる。叱責で動く後輩と、自発的に動く後輩。どちらが成長しやすいかは想像に難くない。"},"4":{"situation":"あなたはWeb制作会社のプロジェクトマネージャー。\nクライアントの鈴木社長から「納品前に機能を追加したい」という要望が入った。仕様は既に確定し、追加費用の予算はない。\n\n追加費用なしでは対応が難しいが、クライアントとの関係も悪くしたくない。鈴木社長に対応方針を伝える必要がある。","kiridashi":{"A":"「鈴木社長、ご要望ありがとうございます。一度内容を整理させていただき、改めてご提案してもよろしいでしょうか」","B":"「鈴木社長、ご要望は分かりました。ただ当社の標準プロセスでは、仕様確定後の追加は対応しておりません。追加費用なしでは難しいです」","C":"「鈴木社長…ご希望はできるだけお応えしたいのですが…社内で検討させていただけますか…」","D":"「鈴木社長、その機能は今回の要件には含まれていません。次回の改修で対応いたしましょう」","correct":"A"},"furumai":{"A":"相手の要望の背景を質問で深掘りし、本当に必要なものを一緒に整理する","B":"「当社の基準ではこうなります」と自社のやり方を説明し、条件を提示する","C":"「何とかします」と安請け合いして、後で社内に持ち帰る","D":"「今回は難しいですが、次回の改修で対応しましょう」と先延ばしする","correct":"A"},"result":"A + A","naze":"クライアントの要望をまず受け止めることが出発点。「ありがとうございます」で相手の提案を尊重しつつ、「整理して改めてご提案」と**即答を避けて考える時間を確保**している。\n\n自社の基準やルールを持ち出す（B）と、相手は「ルールを押し付けられた」と感じる。まず相手の真のニーズを理解してから、一緒に解決策を探るのがおすすめ。","otoshiana":"ESTJは**「自社の基準・やり方が正しい」**と信じがち。Bの切り出し方はまさにそのパターン。「当社のプロセスでは」と正論を言っても、クライアントにとっては「自分たちの事情を無視された」という印象。\n\nもう一つ注意。ESTJは**「即座に結論を出して片付ける」**傾向がある。Dのように「次回で」と即断するのも早すぎる。まずは「なぜその機能が急に必要になったのか」を聞くと、予算内で代替できる方法が見つかることが多い。焦って結論を出す前に、相手の話を聞く余裕を持つと良い。","hint":"**クライアントの追加要望への3ステップ：**\n1. 「ありがとうございます／ご要望、承知しました」（まず受け止める）\n2. 「少し具体的に教えても良いですか？ どういう場面で使いたいかなど」（背景を深掘り）\n3. 「整理して、〇日までにご提案します」（即答せず時間をもらう）\n\n**言い換え例：**\n- ×「当社の基準では仕様確定後の追加は対応しておりません」（自社基準の押し付け）\n- 〇「ご要望の意図を教えていただければ、ベストな提案ができます」（協力の姿勢）","more":"この場面で鍵になるのが**「ニーズの背後にあるニーズ」**を探るスキル。ESTJは効率と結果を重視する分、**プロセスよりも相手の感情に目を向ける練習**が特に効果的。顧客が「機能が欲しい」と言うとき、本当は「不安を解消したい」「競合に遅れを取りたくない」など別の理由がある。この**「背後要件の探索」**ができると、提案の精度が上がり、クライアントからの信頼も高まりやすい。"},"5":{"situation":"あなたはマーケティング部門のメンバー。来月実施するキャンペーンの企画が承認されたが、実行にはシステム部門の協力（LPの開発とサーバー準備）が必要だ。\n\nシステム部門は今、自社サービスの大型リリース準備で忙しいと聞いている。システム部門の山田課長に協力を依頼しなければならない。","kiridashi":{"A":"「山田課長、お忙しいところ恐れ入ります。マーケティングの〇〇キャンペーンの件で、ご相談がございます」","B":"「山田課長、〇〇キャンペーンのLP開発をお願いします。仕様はこれで、納期は〇日でお願いします」","C":"「山田課長…システム部門いま忙しいとお聞きしてるんですが…実はお願いがあって…」","D":"「山田課長、〇〇キャンペーンの件ですが、経営陣からも優先度高いプロジェクトなので、ご協力をお願いします」","correct":"A"},"furumai":{"A":"相手の都合を先に聞き、こちらの要件を共有した上で「一緒にスケジュールを調整できないか」と提案する","B":"「LP開発とサーバー準備、この2点をお願いします。優先的に対応してもらえますか」と具体的な指示を出す","C":"「いつ頃なら対応可能ですか？」と相手の都合に完全に委ねる","D":"自分の上長にエスカレーションして、正式な依頼ルートを回す","correct":"A"},"result":"A + A","naze":"他部署への依頼は、社内とはいえ**「相手にも相手の仕事がある」**ことが前提。まず「お忙しいところ恐れ入ります」と相手の状況を認めることで、「こちらの事情を押し付けるつもりはない」というサインになる。\n\n「ご相談がございます」という言葉で、一方的な依頼ではなく**双方向の話し合いの姿勢**を示せている。これで相手も「なんとかしよう」という気になりやすくなる。","otoshiana":"ESTJは**「依頼するなら具体的に、はっきり伝えるのが親切」**と思いがち。Bの切り出し方はまさにそのパターン。仕様と納期を明確にするのは良いけど、相手は別部署の課長。同格以上に指示を出すと、関係がこじれる。\n\nもう一つ注意。ESTJは**「立場を越えてコントロールしようとする」**傾向がある。Dのように経営陣の名前を出して圧力をかけるのも、短期的には動くかもしれないけど、長期的には相手の協力意欲を削ぐ。まずは相手の都合を聞いて、一緒に解決策を探る。この謙虚さが、後々の信頼の差につながりやすい。","hint":"**他部署への依頼の基本パターン：**\n1. 「お忙しいところ恐れ入ります」（相手の状況を認める）\n2. 「〇〇の件でご相談がございます」（「お願い」より「相談」が良い）\n3. 「まずは今の状況を教えていただけますか」（相手の都合を先に聞く）\n\n**言い換え例：**\n- ×「納期は〇日でお願いします。仕様はこれです」（指示）\n- 〇「〇日が理想ですが、山田課長のスケジュールに合わせて調整できます」（柔軟性を示す）","more":"他部署との協力で意識したいのが**「組織横断的コミュニケーション」**のスキル。ESTJは組織を動かすのが得意だから、つい指示・命令モードになりがち。でも他部署に対しては**「動かす」ではなく「協力してもらう」**のが望ましい姿勢。相手のKPIや優先事項を理解した上で「Win-Winになる着地点」を探る。この視点を持っている人ほど、社内での仕事がスムーズに進みやすくなる。"}},"ENTP":{"1":{"situation":"あなたは社内プロジェクトのリーダーを任されている。\n来週金曜が納期の重要な成果物について、協力会社からの納品遅延が判明。全体スケジュールが3日ほど後ろ倒しになる見込みだ。\n\n田中部長（プロジェクト責任者）にこの事実を報告し、今後の対応を相談しなければならない。","kiridashi":{"A":"「部長、今お時間よろしいでしょうか。〇〇プロジェクトについて、ご報告とご相談がございます」","B":"「部長、〇〇プロジェクトの件なんですけど、遅延の原因って考えると、そもそも協力会社の選定基準に課題があったと思うんですよね。前から気になってたんですが、あの会社の管理体制って…」","C":"「部長…お忙しいところ申し訳ないんですが…〇〇の件で、ちょっとご相談が…」","D":"「部長、〇〇プロジェクトの報告です。で、それとは別に気づいたことがあるんですが、この際だから言わせてもらうと…」","correct":"A"},"furumai":{"A":"資料を手に持ち、相手の目を見て、落ち着いた声ではじめる","B":"報告の流れから「そもそもなぜこの問題が起きたのか」について熱く議論を始める","C":"姿勢を低くし、申し訳なさそうな表情で切り出す","D":"報告しながら「あ、それと〇〇も気になってて」と次々と話題を足していく","correct":"A"},"result":"A + A","naze":"「今お時間よろしいでしょうか」は、相手の状況を尊重する基本の切り出し。田中部長は多忙な管理職だから、いきなり本題に入られると心の準備ができていない。\n\n「ご報告とご相談がございます」と伝えることで、**話の目的を先に示して、相手に受け止める準備を促せる**。これだけで、悪い報告でも受け入れられやすくなる。","otoshiana":"ENTPは**「なぜこうなったか」の議論に熱が入りすぎる**。Bの切り出し方はまさにそのパターン。遅延の報告をするはずが、いつの間にか「協力会社の選定基準」や「管理体制の問題」について議論を始めてしまう。部長からすれば「いや、まず遅延の報告してよ」と思う。\n\nもう一つ注意点。ENTPは**「関連する話題をどんどん繋げていく」**のが得意（D）。報告の途中で「あ、それと〇〇も」「そういえば××も気になってて」と話が発散すると、相手は「何が一番重要なの？」と困惑する。まずは本題を終わらせて、他の話題は別の機会にするのが望ましい。","hint":"**悪い報告の3ステップ切り出し：**\n1. 「今お時間よろしいでしょうか」（タイミングの確認）\n2. 「ご報告とご相談がございます」（目的の提示）\n3. 「実は〜」（本題だけを簡潔に）\n\n**言い換え例：**\n- ×「そもそも原因を考えると、〇〇が問題で…」（議論への脱線）\n- 〇「スケジュールに影響が出ます。詳細はこれから詰めます」（事実だけ先に伝える）","more":"報連相で意識したいのが**「話題を絞る」**スキル。ENTPの脳は次々とアイデアや気づきが湧いてくるから、口を開くとあれもこれも言いたくなる。これを**「発散と収束」**のバランスと呼ぶ。報告は「収束」の時間。議論したいことは「別途相談したいことがあります」とメモして、後で持ち出すのが仕事をうまく進めるコツ。"},"2":{"situation":"あなたは新規プロジェクトのメンバーとして参加している。\n同僚の佐藤さんが担当しているデザイン作業の進捗が予定より遅れており、このままではあなたの担当領域（フロントエンド実装）の着手にも影響が出そうだ。\n\n佐藤さんに状況を確認し、どう進めるか話し合いたい。","kiridashi":{"A":"「佐藤さん、今ちょっといいかな。プロジェクトの進捗について、確認と相談があるんだけど」","B":"「佐藤さん、デザインの進捗だけど、現状のアプローチって効率的なの？ 別のやり方もあると思うんだけど、例えば〇〇とか××とか。一回ちゃんと議論しない？」","C":"「佐藤さん…お忙しいと思いますが…デザインの件でちょっと気になってて…」","D":"「佐藤さん、デザイン遅れてない？ 俺もう待ちきれないんだけど」","correct":"A"},"furumai":{"A":"まず相手の状況を聞き、「一緒に進め方を考えたい」と協力姿勢を示す","B":"「そもそもこの進め方自体に課題があるんじゃない？」と問題提起して議論に持ち込む","C":"「いつ頃できそう？」と相手のペースに任せる","D":"「手伝おうか？ 俺ならもっと早くできる方法知ってるし」と相手のやり方に口を出す","correct":"A"},"result":"A + A","naze":"同僚関係は上下関係ではない。対等な立場だからこそ、「確認と相談」という言葉で**相手を責めるのではなく、一緒に考える姿勢**を見せることが大切。\n\nいきなり「効率的なの？」「別のやり方がある」と議論を吹っかけられる（B）と、相手は「自分のやり方を否定された」と感じて防御的になる。まずは相手の事情を聞くことが第一歩。","otoshiana":"ENTPは**「問題提起＝改善の第一歩」**と思っている。Bの切り出し方はまさにそのパターン。「現状のアプローチって効率的なの？」は確かに重要な問いだけど、進捗が遅れている同僚にとっては「否定された」と響く。議論したい気持ちは分かるけど、タイミングが違う。\n\nもう一つ注意。ENTPは**「改善提案を次々と思いつく」**のが得意。「例えば〇〇とか××とか」と複数のアイデアを出すけど、遅れに焦っている相手にとっては「アイデアを聞いてる余裕はない」と感じる。まずは「どうしてる？」「困ってることある？」と相手の状況を聞いてから、改善案は必要に応じて出すのがおすすめ。","hint":"**同僚への「確認＋相談」の基本パターン：**\n1. 「今ちょっといいかな」（タイミング確認）\n2. 「〇〇の件で、確認と相談があるんだけど」（目的を先に伝える）\n3. 「今どんな状況か教えてもらえる？」（相手の状況を先に聞く）\n\n**言い換え例：**\n- ×「そもそもこのやり方に課題があるよね」（議論のふっかけ）\n- 〇「一緒にスケジュール調整できないかな？」（協力の招待）","more":"ENTPの強みは**「構造的な問題を見抜く力」**。ただし、その力を発揮するタイミングが重要。相手が困っているときは「解決」より「共感」が先。心理学ではこれを**「感情の先行」**と呼ぶ。相手の感情に先に寄り添ってから、論理的な提案を出すと受け入れられやすくなる。順序を逆にすると、どんなに良い提案も「攻撃」と受け取られる。"},"3":{"situation":"あなたはチームのサブリーダー。入社2年目の後輩・高橋さんが、クライアント向けの提案資料に複数のデータミスを混入させてしまった。\n幸い提出前にあなたが発見したが、高橋さんにはミスの原因を理解してもらい、同じ間違いを繰り返さないように指導したい。","kiridashi":{"A":"「高橋さん、提出前の資料チェックしてて気になった点があったんだけど、ちょっと見てくれる？」","B":"「高橋さん、資料見たんだけど、ここからここまで違うよね。で、これ直すだけじゃなくて、そもそも確認の仕方から変えた方がよくない？ 例えばダブルチェック入れるとか、〇〇のツール使うとか、××の手法もあるし」","C":"「高橋さん…資料なんだけど…ちょっと直したいところがあって…」","D":"「高橋さん、資料の件なんだけど、そもそもデータ収集のプロセスに無理があると思うんだよね。〇〇の方法ならもっと確実だし、ついでに××も効率化できるよ」","correct":"A"},"furumai":{"A":"具体的にどこが違うかを示し、「どうやって確認したか教えてくれる？」と原因を一緒に考える","B":"改善アイデアを次々と出して、「これもやってみよう」「あれも導入しよう」と提案を重ねる","C":"「まあ提出前でよかったね」と軽く流す","D":"「根本的にやり方を変えよう」と、ミスの指摘から全く別のプロセス改善に話が飛ぶ","correct":"A"},"result":"A + A","naze":"「気になった点がある」という言い方は、ミスを**「指摘」ではなく「一緒に確認」**というフレームに変えている。後輩が防御的になるのを防げる。\n\n「ちょっと見てくれる？」と問いかけ形にすることで、相手に自分で気づく機会を与えている。自分で見つけたミスの方が、次から意識に残りやすい。","otoshiana":"ENTPは**「改善アイデアが次々と思いつく」**し、全部伝えたくなる。Bの対応はまさにそのパターン。「ダブルチェック」「〇〇のツール」「××の手法」、確かにどれも有用かもしれないけど、高橋さんは入社2年目で、ミスを見つけてショックを受けている可能性がある。改善案が多すぎると「全部やらなきゃ」と混乱するだけ。\n\nもう一つ注意。ENTPは**「根本原因に遡って全てを変えたくなる」**（D）。ミス一つから「データ収集のプロセス全体を見直そう」と話が大きくなりがち。確かに大局的な視点はENTPの強みだけど、後輩指導では「まず目の前のミスを理解する」ことが先。大きな改革は別の機会に。","hint":"**後輩へのフィードバックの基本パターン：**\n1. 「ちょっと見てくれる？」（共に確認する姿勢）\n2. 「ここ、〇〇と××で数字が違うね」（事実を具体的に指摘）\n3. 「どうやって確認したか教えてもらえる？」（一つの原因に絞って一緒に考える）\n\n**言い換え例：**\n- ×「これもやろう、あれもやろう、ついでに〇〇も変えよう」（アイデアの瀑流）\n- 〇「ここ、元のデータと数字が合わないんだけど、どこから持ってきたか一緒に見てみよう」（一点集中で一緒に考える）","more":"後輩指導でENTPが意識したいのが**「一度に一つ」**の原則。脳科学の研究でも、人が一度に処理できる新しい情報は3〜4個程度とされている。ENTPの頭の中では5つの改善案が同時に輝いて見えるかもしれないけど、後輩に伝えるのは「今一番大事な一つ」だけでいい。残りはメモして、別のタイミングで提案する。「たくさん教える」より「一つを確実に定着させる」方が指導の効果は高い。"},"4":{"situation":"あなたはWeb制作会社のプロジェクトマネージャー。\nクライアントの鈴木社長から「納品前に機能を追加したい」という要望が入った。仕様は既に確定し、追加費用の予算はない。\n\n追加費用なしでは対応が難しいが、クライアントとの関係も悪くしたくない。鈴木社長に対応方針を伝える必要がある。","kiridashi":{"A":"「鈴木社長、ご要望ありがとうございます。一度内容を整理させていただき、改めてご提案してもよろしいでしょうか」","B":"「鈴木社長、その追加機能ですけど、正直なところ必要性を感じないんですよね。だってユーザーの動線を考えると、〇〇の方が大事じゃないですか？」","C":"「鈴木社長…ご希望はできるだけお応えしたいのですが…社内で検討させていただけますか…」","D":"「鈴木社長、それ面白いですね！ ついでに〇〇も追加しませんか？ 今ならまとめて提案できますよ」","correct":"A"},"furumai":{"A":"相手の要望の背景を質問で深掘りし、本当に必要なものを一緒に整理する","B":"「その機能、実はユーザーのニーズと合ってない気がします。データ見ると…」と反論する","C":"「何とかします」と安請け合いして、後で社内に持ち帰る","D":"「いいアイデアですね！ じゃあそれもこれも追加しましょう！」と話を大きくする","correct":"A"},"result":"A + A","naze":"クライアントの要望をまず受け止めることが出発点。「ありがとうございます」で相手の提案を尊重しつつ、「整理して改めてご提案」と**即答を避けて考える時間を確保**している。\n\nクライアントの要望に対して「それは違うのでは」と反論する（B）と、相手は「否定された」と感じて関係が悪化する。まず受け止めて、背景を聞くのが効果的。","otoshiana":"ENTPは**「相手の主張の矛盾や非効率にすぐ気づく」**し、それを口に出さずにいられない。Bの切り出し方はまさにそのパターン。「必要性を感じない」「ユーザーの動線を考えると」、確かに鋭い指摘だけど、これはクライアントとの会話であって討論会ではない。鈴木社長は「相談」したのに「反論」されたと感じる。\n\nもう一つ注意。ENTPは**「それ面白いね！ もっと広げようよ」**と話を膨らませたがる（D）。スコープが広がると結果的にどれも中途半端になりかねない。まずは目の前の要望をしっかり受け止めて、整理することが先決。","hint":"**クライアントの追加要望への3ステップ：**\n1. 「ありがとうございます／ご要望、承知しました」（まず受け止める）\n2. 「少し具体的に教えても良いですか？ どういう場面で使いたいかなど」（背景を深掘り）\n3. 「整理して、〇日までにご提案します」（即答せず時間をもらう）\n\n**言い換え例：**\n- ×「それって必要ですか？ ユーザーの動線を考えると…」（討論モード）\n- 〇「ご要望の意図を教えていただければ、ベストな提案ができます」（協力の姿勢）","more":"クライアント対応でENTPが意識したいのが**「反論と質問の違い」**。「それは違うのでは？」が反論なら、「なぜその機能が必要だと感じましたか？」が質問。両方とも相手の主張に興味を持っていることには変わりないけど、受け取られ方は180度違う。この切り替えを**「反論を質問に変換する」**スキルと呼ぶ。ENTPの鋭さは質問の形で使うと、とても効果的な営業ツールになる。"},"5":{"situation":"あなたはマーケティング部門のメンバー。来月実施するキャンペーンの企画が承認されたが、実行にはシステム部門の協力（LPの開発とサーバー準備）が必要だ。\n\nシステム部門は今、自社サービスの大型リリース準備で忙しいと聞いている。システム部門の山田課長に協力を依頼しなければならない。","kiridashi":{"A":"「山田課長、お忙しいところ恐れ入ります。マーケティングの〇〇キャンペーンの件で、ご相談がございます」","B":"「山田課長、キャンペーンのLP開発の件なんですけど、今のシステム部門のフローって非効率じゃないですか？ もっとスピード上げられる方法あると思うんですよね」","C":"「山田課長…システム部門いま忙しいとお聞きしてるんですが…実はお願いがあって…」","D":"「山田課長、〇〇キャンペーンの件ですが、うちの部長からも_systemsにお願いするようにと指示を受けてまして」","correct":"A"},"furumai":{"A":"相手の都合を先に聞き、こちらの要件を共有した上で「一緒にスケジュールを調整できないか」と提案する","B":"「もっと効率的な方法があると思うんですが」と、相手のやり方に改善提案をする","C":"「いつ頃なら対応可能ですか？」と相手の都合に完全に委ねる","D":"「じゃあ、うちの部長と山田課長の上長で調整してもらえますか？」と上層同士に丸投げする","correct":"A"},"result":"A + A","naze":"他部署への依頼は、社内とはいえ**「相手にも相手の仕事がある」**ことが前提。まず「お忙しいところ恐れ入ります」と相手の状況を認めることで、「こちらの事情を押し付けるつもりはない」というサインになる。\n\n「ご相談がございます」という言葉で、一方的な依頼ではなく**双方向の話し合いの姿勢**を示せている。これで相手も「なんとかしよう」という気になりやすくなる。","otoshiana":"ENTPは**「もっといい方法があるのに、なぜみんな気づかないの？」**と思わず口に出しがち。Bの切り出し方はまさにそのパターン。「今のフローって非効率じゃないですか？」は、確かに改善の余地があるかもしれないけど、依頼しに行った相手のやり方を批判するのは避けたいタイミング。\n\nもう一つ注意。ENTPは**「議論しながら関係を作る」**タイプ。改善提案から話を始めて「一緒に良くしましょうよ」という空気を作りたい気持ちは分かる。でも、忙しい相手に「非効率」と指摘されると「お前に何が分かるの？」と反発されるだけ。まずは依頼を済ませて、関係ができてから改善提案する順序が大切。","hint":"**他部署への依頼の基本パターン：**\n1. 「お忙しいところ恐れ入ります」（相手の状況を認める）\n2. 「〇〇の件でご相談がございます」（「お願い」より「相談」が良い）\n3. 「まずは今の状況を教えていただけますか」（相手の都合を先に聞く）\n\n**言い換え例：**\n- ×「今のやり方って非効率じゃないですか？」（相手のやり方へのツッコミ）\n- 〇「山田課長のスケジュールに合わせて調整できます」（柔軟性を示す）","more":"他部署との関係構築で意識したいのが**「信頼の貯金」**。スティーブン・コヴィーが提唱した概念で、人間関係は「貯金」と「引き出し」で成り立つ。依頼は「引き出し」、感謝や協力は「貯金」。まだ関係が浅い相手に「改善提案」（相手のやり方への指摘）をするのは、貯金ゼロの状態で大声で引き出しをするようなもの。まずは小さな協力と感謝で貯金をしてから。"}},"INTP":{"1":{"situation":"あなたは社内プロジェクトのリーダーを任されている。\n来週金曜が納期の重要な成果物について、協力会社からの納品遅延が判明。全体スケジュールが3日ほど後ろ倒しになる見込みだ。\n\n田中部長（プロジェクト責任者）にこの事実を報告し、今後の対応を相談しなければならない。","kiridashi":{"A":"「部長、今お時間よろしいでしょうか。〇〇プロジェクトについて、ご報告とご相談がございます」","B":"「部長、〇〇プロジェクトの件なんですけど…遅延の原因について、いくつか気になる点があって、まだ完全には特定できていない部分もあるんですが、おそらく協力会社の内部体制に問題があって、それがスケジュールに影響して…」","C":"「部長…お忙しいところ申し訳ないんですが…〇〇の件で、ちょっとご報告があって…」","D":"「部長、協力会社の納品遅延について、私の分析結果をお伝えしたいのですが」","correct":"A"},"furumai":{"A":"資料を手に持ち、相手の目を見て、落ち着いた声ではじめる","B":"原因分析のメモを大量に持ち込み、詳細な経緯から説明し始める","C":"姿勢を低くし、申し訳なさそうな表情で切り出す","D":"PCを開いて遅延のタイムライン図を見せながら、技術的な解説を始める","correct":"A"},"result":"A + A","naze":"「今お時間よろしいでしょうか」は、相手の状況を尊重する基本の切り出し。田中部長は多忙な管理職だから、いきなり本題に入られると心の準備ができていない。\n\n「ご報告とご相談がございます」と伝えることで、**話の目的を先に示して、相手に受け止める準備を促せる**。これだけで、悪い報告でも受け入れられやすくなる。","otoshiana":"INTPは**「原因を完全に理解してから報告しなければ」**と思いがち。Bの切り出し方はまさにそのパターン。「原因が完全には特定できていない」と言い訳めいて長く語り出すと、上司は「で、結局どうなるの？」とイライラしてしまう。\n\nもう一つ注意点。INTPは**「分析プロセスそのものが面白くて」**、原因調査に没頭してしまいがち。第一報が遅れると「なぜもっと早く言わなかったのか」と余計に怒られる。事実が判明した時点で、原因が完全に分かっていなくても第一報を入れるのが望ましい。","hint":"**悪い報告の3ステップ切り出し：**\n1. 「今お時間よろしいでしょうか」（タイミングの確認）\n2. 「ご報告とご相談がございます」（目的の提示）\n3. 「実は〜」（事実を簡潔に、詳細は聞かれてから）\n\n**言い換え例：**\n- ×「原因についてですが、おそらく〇〇で、それが××に影響して…」（分析の長口）\n- 〇「スケジュールに影響が出る見込みです。詳細はこれから調査します」（事実だけ先に伝える）","more":"報連相で意識したいのは**「事実ファースト、分析は後」**。この原則は**ピラミッド原理**と呼ばれる思考・伝達技術に基づいている。結論を先に言い、次に根拠を述べ、最後に詳細という順序。INTPの「 bottom-up に考えたい」性向とは逆方向だけど、相手が理解しやすい順序で伝えるのが、ビジネスコミュニケーションの基本。"},"2":{"situation":"あなたは新規プロジェクトのメンバーとして参加している。\n同僚の佐藤さんが担当しているデザイン作業の進捗が予定より遅れており、このままではあなたの担当領域（フロントエンド実装）の着手にも影響が出そうだ。\n\n佐藤さんに状況を確認し、どう進めるか話し合いたい。","kiridashi":{"A":"「佐藤さん、今ちょっといいかな。プロジェクトの進捗について、確認と相談があるんだけど」","B":"「佐藤さん、デザインの進捗について確認なんだけど、タスク管理ツールの更新が止まってるよね。というか、そもそも前回のミーティングで合意したマイルストーンと現在の実績を照合すると、遅れが〇日あって、これがクリティカルパスに与える影響を考えると…」","C":"「佐藤さん…お忙しいと思いますが…デザインの件でちょっと気になってて…」","D":"「佐藤さん、デザイン遅れてる？ 俺の作業に響いてるんだけど、どうなってるの？」","correct":"A"},"furumai":{"A":"まず相手の状況を聞き、「一緒に進め方を考えたい」と協力姿勢を示す","B":"遅延の影響を論理的に説明し、「だからこうしたほうがいい」と最適解を提示する","C":"「いつ頃できそう？」と相手のペースに任せる","D":"「手伝おうか？ 俺なら〇〇の方法で早くできるよ」と相手のやり方に口を出す","correct":"A"},"result":"A + A","naze":"同僚関係は上下関係ではない。対等な立場だからこそ、「確認と相談」という言葉で**相手を責めるのではなく、一緒に考える姿勢**を見せることが大切。\n\nいきなり「遅れてる」「厳しい」と事実を突きつけられると、相手は防御的になる。まずは相手の事情を聞くことで、本当のボトルネックが見えてくる。","otoshiana":"INTPは**「論理的に正しいことを淡々と述べる」**のが得意だけど、それが相手には「冷たい」「責められてる」と受け取られがち。Bの切り出し方はまさにそのパターン。分析は合ってるけど、言い方が全部「あなたのせい」に聞こえてしまう。\n\nもう一つ。INTPは**説明が長くなりがち**。「クリティカルパス」とか「マイルストーンと実績の照合」とか、確かに正しい言葉を使うけど、同僚との会話なら「進捗どう？」で十分伝わる。相手がクリエイター出身なら、プロジェクト管理用語でプレッシャーを感じることも。","hint":"**同僚への「確認＋相談」の基本パターン：**\n1. 「今ちょっといいかな」（タイミング確認）\n2. 「〇〇の件で、確認と相談があるんだけど」（目的を先に伝える）\n3. 「今どんな状況か教えてもらえる？」（相手の状況を先に聞く）\n\n**言い換え例：**\n- ×「マイルストーンと実績の差分が〇日で、クリティカルパスに…」（分析レポート）\n- 〇「デザインの進捗、ちょっと教えてもらえる？ 一緒にスケジュール見直したいな」（協力の招待）","more":"同僚とのコミュニケーションで意識したいのが**「関係性の貯金」**。論理的に正しいことを言うのも大事だけど、相手が「味方だ」と感じていないと、どんな正論も響かない。まずは「一緒に考えたい」という姿勢を見せることが、協力関係の土台になる。これを心理学者ロバート・チアルディーニは**「好意の原則」**と呼んでいる。"},"3":{"situation":"あなたはチームのサブリーダー。入社2年目の後輩・高橋さんが、クライアント向けの提案資料に複数のデータミスを混入させてしまった。\n幸い提出前にあなたが発見したが、高橋さんにはミスの原因を理解してもらい、同じ間違いを繰り返さないように指導したい。","kiridashi":{"A":"「高橋さん、提出前の資料チェックしてて気になった点があったんだけど、ちょっと見てくれる？」","B":"「高橋さん、資料の確認してたんだけど、ここからここまでの数値が元データと一致してないんだよね。で、どこで乖離が起きたかというと、たぶん〇〇の処理の段階で××が起きてて、それが原因で一连のデータに影響が…」","C":"「高橋さん…資料なんだけど…ちょっと直したいところがあって…」","D":"「高橋さん、データの検証プロセスについて、後で時間もらえる？」","correct":"A"},"furumai":{"A":"具体的にどこが違うかを示し、「どうやって確認したか教えてくれる？」と原因を一緒に考える","B":"ホワイトボードに原因分析図を書き、「ここが根本原因で、だから〇〇したほうがいい」と長く解説する","C":"「まあ提出前でよかったね」と軽く流す","D":"「データの確認手順をこれから標準化しよう。私が手順書を作るから、それに従って」と指示する","correct":"A"},"result":"A + A","naze":"「気になった点がある」という言い方は、ミスを**「指摘」ではなく「一緒に確認」**というフレームに変えている。後輩が防御的になるのを防げる。\n\n「ちょっと見てくれる？」と問いかけ形にすることで、相手に自分で気づく機会を与えている。自分で見つけたミスの方が、次から意識に残りやすい。","otoshiana":"INTPは**「なぜ起きたかの根本原因を徹底的に分析したくなる」**。Bの対応はまさにそのパターン。確かに原因究明は大事だけど、高橋さんは入社2年目。ホワイトボードに分析図を書かれても「ついていけない」「怒られてる」と感じるだけ。\n\nもう一つ注意。INTPは**説明が長くなる**。「ここからここまで」「〇〇の処理の段階で」「一连のデータに」…と情報をどんどん足していくけど、後輩が混乱するだけ。指導は短く、一つずつ。まずは「どこが違うか」を伝えて、次に「どうやって確認するか」を一緒に考えるのが効率的。","hint":"**後輩へのフィードバックの基本パターン：**\n1. 「ちょっと見てくれる？」（共に確認する姿勢）\n2. 「ここ、〇〇と××で数字が違うね」（事実を具体的に指摘）\n3. 「どうやって確認したか教えてもらえる？」（プロセスを一緒に振り返る）\n\n**言い換え例：**\n- ×「ここが間違ってて、原因はたぶん〇〇で、だから××したほうがいい…」（分析の長口）\n- 〇「ここ、元のデータと数字が合わないんだけど、どこから持ってきたか一緒に見てみよう」（一緒に考える姿勢）","more":"後輩指導で効果的なのが**「ティーチング不如コーチング」**の考え方。答えを教える（ティーチング）のも大事だけど、質問で相手の思考を引き出す（コーチング）方が、本人の定着率が高い。INTPは「自分が理解したことを全部伝えたい」欲求が強いけど、それをグッとこらえて「どう思う？」「どこで違ったかな？」と問いかけることで、後輩の成長が加速する。"},"4":{"situation":"あなたはWeb制作会社のプロジェクトマネージャー。\nクライアントの鈴木社長から「納品前に機能を追加したい」という要望が入った。仕様は既に確定し、追加費用の予算はない。\n\n追加費用なしでは対応が難しいが、クライアントとの関係も悪くしたくない。鈴木社長に対応方針を伝える必要がある。","kiridashi":{"A":"「鈴木社長、ご要望ありがとうございます。一度内容を整理させていただき、改めてご提案してもよろしいでしょうか」","B":"「鈴木社長、その追加機能についてですね。技術的な観点から言うと、既存のアーキテクチャとの統合には〇〇工数が必要で、データベースの設計変更も…ええと、つまり対応自体は可能なんですが、工数の問題があって…」","C":"「鈴木社長…ご希望はできるだけお応えしたいのですが…社内で検討させていただけますか…」","D":"「鈴木社長、その機能の追加は技術的にあまり推奨されません。もっと良い方法があるので、そちらをご説明してもいいですか？」","correct":"A"},"furumai":{"A":"相手の要望の背景を質問で深掘りし、本当に必要なものを一緒に整理する","B":"追加機能の技術的な実装難易度を詳しく説明し、工数の根拠を示す","C":"「何とかします」と安請け合いして、後で社内に持ち帰る","D":"「別の方法を提案します」と、全く違うアプローチを押し出す","correct":"A"},"result":"A + A","naze":"クライアントの要望をまず受け止めることが出発点。「ありがとうございます」で相手の提案を尊重しつつ、「整理して改めてご提案」と**即答を避けて考える時間を確保**している。\n\n即座に「難しいです」と断る（BやD）と、相手は突き放されたと感じる。まず相手の真のニーズを理解してから、一緒に解決策を探るのが効果的。","otoshiana":"INTPは**「技術的にどうなのか」を先に説明したくなる**。Bの切り出し方はまさにそのパターン。アーキテクチャだのデータベース設計だの、確かにINTPにとっては重要な情報だけど、クライアントは「できるかできないか」を知りたいだけで、技術解説を聞きたいわけではない。\n\nもう一つ注意。INTPは**「もっと良い方法を思いついた」と提案（D）したくなる**けど、クライアントの要望を否定して別案を出すと「聞いてもらえなかった」と不満が残る。まずは要望をしっかり聞いてから、代替案を出す順序が大切。","hint":"**クライアントの追加要望への3ステップ：**\n1. 「ありがとうございます／ご要望、承知しました」（まず受け止める）\n2. 「少し具体的に教えても良いですか？ どういう場面で使いたいかなど」（背景を深掘り）\n3. 「整理して、〇日までにご提案します」（即答せず時間をもらう）\n\n**言い換え例：**\n- ×「技術的に言うと〇〇で…工数が…」（技術解説）\n- 〇「ご要望の意図を教えていただければ、ベストな提案ができます」（協力の姿勢）","more":"クライアント対応で鍵になるのが**「ニーズの背後にあるニーズ」**を探るスキル。顧客が「機能が欲しい」と言うとき、本当は「不安を解消したい」「競合に遅れを取りたくない」など別の理由があることが多い。INTPの分析力はここで活きる。ただし、分析は心の中で行い、口に出すのは「ご要望の背景を教えてください」という質問から始めるのがコツ。"},"5":{"situation":"あなたはマーケティング部門のメンバー。来月実施するキャンペーンの企画が承認されたが、実行にはシステム部門の協力（LPの開発とサーバー準備）が必要だ。\n\nシステム部門は今、自社サービスの大型リリース準備で忙しいと聞いている。システム部門の山田課長に協力を依頼しなければならない。","kiridashi":{"A":"「山田課長、お忙しいところ恐れ入ります。マーケティングの〇〇キャンペーンの件で、ご相談がございます」","B":"「山田課長、キャンペーンのLPなんですけど、仕様の詳細をまだ最終調整していて、というのも要件が一部固まってなくて、サーバーのスペック要件もまだ確定じゃないんですが、とりあえず大枠だけ先にお伝えしてもいいですか…」","C":"「山田課長…システム部門いま忙しいとお聞きしてるんですが…実はお願いがあって…」","D":"「山田課長、キャンペーンのLP開発お願いします。仕様書はまだ途中ですが、概要だけ先に共有しますね」","correct":"A"},"furumai":{"A":"相手の都合を先に聞き、こちらの要件を共有した上で「一緒にスケジュールを調整できないか」と提案する","B":"「仕様が完全に確定してから正式にお願いします」と言って、依頼を保留する","C":"「いつ頃なら対応可能ですか？」と相手の都合に完全に委ねる","D":"「他部署の担当者にも聞いたんですが、山田課長が一番適任だと聞きました」と持ち上げて依頼する","correct":"A"},"result":"A + A","naze":"他部署への依頼は、社内とはいえ**「相手にも相手の仕事がある」**ことが前提。まず「お忙しいところ恐れ入ります」と相手の状況を認めることで、「こちらの事情を押し付けるつもりはない」というサインになる。\n\n「ご相談がございます」という言葉で、一方的な依頼ではなく**双方向の話し合いの姿勢**を示せている。これで相手も「なんとかしよう」という気になりやすくなる。","otoshiana":"INTPは**「情報が全て揃ってから動くのが適切」**と思いがち。Bの切り出し方はまさにそのパターン。仕様が固まってないから、サーバー要件も確定してないから…と自分の中で理由を並べて、結果的に依頼がどんどん遅れる。\n\nもう一つ注意。INTPは**「前提条件が不完全だと話したくない」**性質がある。でも他部署への依頼は、不完全な状態で「こんな感じで考えてるんだけど」と仮相談から始めるのがおすすめ。早めに共有すれば、相手もスケジュールに組み込みやすい。","hint":"**他部署への依頼の基本パターン：**\n1. 「お忙しいところ恐れ入ります」（相手の状況を認める）\n2. 「〇〇の件でご相談がございます」（「お願い」より「相談」が良い）\n3. 「まずは概要だけでも共有させていただいてもよろしいですか？」（完璧を求めず仮相談から）\n\n**言い換え例：**\n- ×「仕様が確定してからまた連絡します」（依頼の先延ばし）\n- 〇「まだ要件の途中ですが、大枠だけ先に共有してもいいですか？」（早めの仮相談）","more":"プロジェクト管理の世界では**「不完璧でも早く共有する」**ことが重要視されている。これを**「漸進的詳細化（プログレッシブ・エラボレーション）」**と呼ぶ。最初は大雑把でも、関係者と情報を共有しながら少しずつ精度を上げていく手法。INTPの「完璧に整理してから伝える」性向を少し緩めることで、社内連携が格段にスムーズになる。"}},"ENTJ":{"1":{"situation":"あなたは社内プロジェクトのリーダーを任されている。\n来週金曜が納期の重要な成果物について、協力会社からの納品遅延が判明。全体スケジュールが3日ほど後ろ倒しになる見込みだ。\n\n田中部長（プロジェクト責任者）にこの事実を報告し、今後の対応を相談しなければならない。","kiridashi":{"A":"「部長、今お時間よろしいでしょうか。〇〇プロジェクトについて、ご報告とご相談がございます」","B":"「部長、〇〇プロジェクトの納期が遅れます。対策としては協力会社を追加でもう一社手配するのが最善です。承認お願いします」","C":"「部長…お忙しいところ申し訳ないんですが…〇〇の件で、ちょっとご相談が…」","D":"「部長、協力会社が遅れてます。私の判断で別の会社に切り替えようと思うのですが、問題ないですよね？」","correct":"A"},"furumai":{"A":"資料を手に持ち、相手の目を見て、落ち着いた声ではじめる","B":"立ち気味で、手際よく結論と対策を早口で説明する","C":"姿勢を低くし、申し訳なさそうな表情で切り出す","D":"携帯を手に持ち、他の業務と並行しながら報告する","correct":"A"},"result":"A + A","naze":"「今お時間よろしいでしょうか」は、相手の状況を尊重する基本の切り出し。田中部長は多忙な管理職だから、いきなり本題に入られると心の準備ができていない。\n\n「ご報告とご相談がございます」と伝えることで、**話の目的を先に示して、相手に受け止める準備を促せる**。これだけで、悪い報告でも受け入れられやすくなる。","otoshiana":"ENTJは**「結論と対策が見えてるなら、すぐ決めて動くのが適切」**と思いがち。Bの切り出し方はまさにそのパターン。「承認お願いします」と結論を先に押し付えると、上司としては「相談じゃなくて通知かよ」と感じてしまう。\n\nもう一つ注意点。ENTJは**「自分が正しい判断をしている自信」**が声や態度に出やすい。Bのように立ち気味で早口だと、「部長の意見を聞く気があるのか？」と取られかねない。上司への報告は、たとえ自分の中に答えがあっても「ご相談」という形を通すのが基本。","hint":"**悪い報告の3ステップ切り出し：**\n1. 「今お時間よろしいでしょうか」（タイミングの確認）\n2. 「ご報告とご相談がございます」（目的の提示）\n3. 「実は〜」（本題に入る）\n\n**言い換え例：**\n- ×「こうしますので承認を」（決定の通知）\n- 〇「こういう状況です。対策案を考えたんですが、部長のご意見も伺えますか？」（相談の姿勢）","more":"上司への報告で意識したいのは**「権力のバランスを意識する」**こと。ENTJは決断力が強みだけど、上司に対しても「自分がリーダー」のように振る舞うと信頼を損なう。これを組織行動論では**「上向きマネジメント」**と呼ぶ。上司との関係を良好に保ちながら、自分の提案を通すためのコミュニケーションスキル。ENTJのリーダーシップ力を上司との関係でも活かすには、「決める」ではなく「合意を取る」意識が鍵。"},"2":{"situation":"あなたは新規プロジェクトのメンバーとして参加している。\n同僚の佐藤さんが担当しているデザイン作業の進捗が予定より遅れており、このままではあなたの担当領域（フロントエンド実装）の着手にも影響が出そうだ。\n\n佐藤さんに状況を確認し、どう進めるか話し合いたい。","kiridashi":{"A":"「佐藤さん、今ちょっといいかな。プロジェクトの進捗について、確認と相談があるんだけど」","B":"「佐藤さん、デザインの進捗遅れてるね。このままだと全体に影響するから、今日中に優先順位見直して、〇〇を先に上げてもらえる？」","C":"「佐藤さん…お忙しいと思いますが…デザインの件でちょっと気になってて…」","D":"「佐藤さん、デザインまだ？ 俺もう手空いてるんだけど、早く進めたいんだけど」","correct":"A"},"furumai":{"A":"まず相手の状況を聞き、「一緒に進め方を考えたい」と協力姿勢を示す","B":"自分がリーダーのように「じゃあこうしよう」と指示を出してまとめる","C":"「いつ頃できそう？」と相手のペースに任せる","D":"「俺が代わりにやろうか？」と相手のテリトリーに入り込む","correct":"A"},"result":"A + A","naze":"同僚関係は上下関係ではない。対等な立場だからこそ、「確認と相談」という言葉で**相手を責めるのではなく、一緒に考える姿勢**を見せることが大切。\n\nいきなり「遅れてる」「こうして」と指示を出される（B）と、同僚は「お前がリーダーなの？」と反発したくなる。まずは相手の事情を聞くことで、協力関係が築ける。","otoshiana":"ENTJは**「効率的な方法が見えたら、即座に指示して進めるのが適切」**と思いがち。Bの切り出し方はまさにそのパターン。「優先順位見直して」「〇〇を先に上げて」、確かに効果的かもしれないけど、これは同僚への「指示」であって「相談」ではない。\n\nもう一つ注意。ENTJは**自然とリーダーポジションを取りたがる**。会話のペースを握り、結論に導くのが得意だから、気づけば「じゃあこうしよう」とまとめている。でもプロジェクトに正式なリーダーがいるなら、同僚への指示は越権行為になりかねない。「一緒に考えよう」というスタンスを意識的に取る必要がある。","hint":"**同僚への「確認＋相談」の基本パターン：**\n1. 「今ちょっといいかな」（タイミング確認）\n2. 「〇〇の件で、確認と相談があるんだけど」（目的を先に伝える）\n3. 「今どんな状況か教えてもらえる？」（相手の状況を先に聞く）\n\n**言い換え例：**\n- ×「だからこうして。今日中にお願い」（指示命令）\n- 〇「どう進めるのがいいか、一緒に考えさせて？」（協力の招待）","more":"同僚との関係で意識したいのが**「影響力」**と**「権限」**の違い。権限がない同僚に対して指示を出すと、関係が悪化する。でも影響力、つまり「この人の言うことなら聞こう」と思わせる関係を作れば、自然と協力が得られる。これが**「インフォーマル・リーダーシップ」**。ENTJのリーダーシップ能力を、立場を超えて発揮するには「指示」ではなく「提案」の言葉を選ぶことが鍵。"},"3":{"situation":"あなたはチームのサブリーダー。入社2年目の後輩・高橋さんが、クライアント向けの提案資料に複数のデータミスを混入させてしまった。\n幸い提出前にあなたが発見したが、高橋さんにはミスの原因を理解してもらい、同じ間違いを繰り返さないように指導したい。","kiridashi":{"A":"「高橋さん、提出前の資料チェックしてて気になった点があったんだけど、ちょっと見てくれる？」","B":"「高橋さん、この資料、〇〇ページと××ページの数値が間違ってる。クライアントに提出する資料でこれだけのミスがあったら、信頼に関わるよ。どうなってるの？」","C":"「高橋さん…資料なんだけど…ちょっと直したいところがあって…」","D":"「高橋さん、資料の確認プロセスを変えよう。これからは提出前にチェックリストを作って、私の確認も必須にする」","correct":"A"},"furumai":{"A":"具体的にどこが違うかを示し、「どうやって確認したか教えてくれる？」と原因を一緒に考える","B":"「このくらいのミスは許されないよ。次は何より気をつけて」と厳しく指導する","C":"「まあ提出前でよかったね」と軽く流す","D":"「今後の対策を決めるね。チェックリスト作るから、これ使って」と改善策を一方的に指示する","correct":"A"},"result":"A + A","naze":"「気になった点がある」という言い方は、ミスを**「指摘」ではなく「一緒に確認」**というフレームに変えている。後輩が防御的になるのを防げる。\n\n「ちょっと見てくれる？」と問いかけ形にすることで、相手に自分で気づく機会を与えている。自分で見つけたミスの方が、次から意識に残りやすい。","otoshiana":"ENTJは**「基準が高く、期待をストレートに伝えるのが指導」**と思いがち。Bの切り出し方はまさにそのパターン。「信頼に関わるよ」「どうなってるの？」と正論だけど、高橋さんは入社2年目。この言い方だと萎縮して、次はミスを隠すようになるかもしれない。\n\nもう一つ注意。ENTJは**「効率的な仕組みを作れば解決する」**と考えがち（D）。チェックリストやフローの整備は確かに有効だけど、まずは本人が「なぜミスをしたか」を理解することが先。仕組みで解決しようとすると、根本原因に向き合わずに表面的な対策で終わってしまう。","hint":"**後輩へのフィードバックの基本パターン：**\n1. 「ちょっと見てくれる？」（共に確認する姿勢）\n2. 「ここ、〇〇と××で数字が違うね」（事実を具体的に指摘）\n3. 「どうやって確認したか教えてもらえる？」（プロセスを一緒に振り返る）\n\n**言い換え例：**\n- ×「このレベルのミスは許されないよ。もっと気をつけて」（高すぎる期待）\n- 〇「ここ、元のデータと数字が合わないんだけど、どこから持ってきたか一緒に見てみよう」（一緒に考える姿勢）","more":"後輩指導で意識したいのが**「心理的安全性」**。ミスを報告しやすい雰囲気を作ることが、チームのパフォーマンス向上に直結する。Googleが行った研究でも、最も生産性の高いチームの特徴は「心理的安全性」だった。ENTJの高い基準は強みだけど、それを「期待として伝える」のか「プレッシャーとして伝える」のかの差が、後輩の成長を大きく左右する。"},"4":{"situation":"あなたはWeb制作会社のプロジェクトマネージャー。\nクライアントの鈴木社長から「納品前に機能を追加したい」という要望が入った。仕様は既に確定し、追加費用の予算はない。\n\n追加費用なしでは対応が難しいが、クライアントとの関係も悪くしたくない。鈴木社長に対応方針を伝える必要がある。","kiridashi":{"A":"「鈴木社長、ご要望ありがとうございます。一度内容を整理させていただき、改めてご提案してもよろしいでしょうか」","B":"「鈴木社長、その追加機能については対応可能です。ただし追加費用が〇〇万円と納期の延長が必要です。どちらもご了承いただけるなら即対応します」","C":"「鈴木社長…ご希望はできるだけお応えしたいのですが…社内で検討させていただけますか…」","D":"「鈴木社長、正直に言うとその機能は不要だと思います。費用対効果を考えると、今の仕様で十分ですよ」","correct":"A"},"furumai":{"A":"相手の要望の背景を質問で深掘りし、本当に必要なものを一緒に整理する","B":"自社の対応力に自信を見せ、「費用さえ出せば何でもできます」と前のめりになる","C":"「何とかします」と安請け合いして、後で社内に持ち帰る","D":"「それはおすすめしません」と、自分の判断をクライアントに押し付ける","correct":"A"},"result":"A + A","naze":"クライアントの要望をまず受け止めることが出発点。「ありがとうございます」で相手の提案を尊重しつつ、「整理して改めてご提案」と**即答を避けて考える時間を確保**している。\n\n即座に「できます、ただし条件は…」（B）と答えると、顧客は「この人はお金さえ払えば何でも言うことを聞くのか」と不信感を持つ可能性がある。まず相手の真のニーズを理解してから、一緒に解決策を探るのが効果的。","otoshiana":"ENTJは**「対応できる自信があるなら、即答して条件を提示するのが誠実な対応」**と思いがち。Bの切り出し方はまさにそのパターン。確かに効率的だけど、クライアントの要望の背景を聞く前に条件を提示すると「聞いてもらえてない」と感じる人もいる。\n\nもう一つ注意。ENTJは**「自分が正しいと思うことをストレートに言う」**傾向がある。Dの「不要だと思います」は極端な例だけど、「費用対効果を考えると…」「正直なところ…」と自分の意見を押し出しがち。クライアント対応では、まず「ご要望の背景」を聞いてから自分の意見を伝える順序を意識すると良い。","hint":"**クライアントの追加要望への3ステップ：**\n1. 「ありがとうございます／ご要望、承知しました」（まず受け止める）\n2. 「少し具体的に教えても良いですか？ どういう場面で使いたいかなど」（背景を深掘り）\n3. 「整理して、〇日までにご提案します」（即答せず時間をもらう）\n\n**言い換え例：**\n- ×「できます。費用は〇〇万です」（条件の即提示）\n- 〇「ご要望の意図を教えていただければ、ベストな提案ができます」（協力の姿勢）","more":"クライアント対応で鍵になるのが**「相手の自制心を刺激しない」**こと。ENTJの自信に満ちた提案は、自分が営業やPMの立場なら強力な武器になる。でも「押し切られた」と感じた顧客は、後から「やっぱり納得できない」とトラブルになることがある。これを**「強制的合意」**と呼ぶ。合意は「相手が自分で決めた」と感じられる形で取るのが長期的な信頼に繋がる。"},"5":{"situation":"あなたはマーケティング部門のメンバー。来月実施するキャンペーンの企画が承認されたが、実行にはシステム部門の協力（LPの開発とサーバー準備）が必要だ。\n\nシステム部門は今、自社サービスの大型リリース準備で忙しいと聞いている。システム部門の山田課長に協力を依頼しなければならない。","kiridashi":{"A":"「山田課長、お忙しいところ恐れ入ります。マーケティングの〇〇キャンペーンの件で、ご相談がございます」","B":"「山田課長、〇〇キャンペーンのLP開発をお願いします。期日は来月の〇日です。必要なリソースは最低2人・工数で〇〇日分です」","C":"「山田課長…システム部門いま忙しいとお聞きしてるんですが…実はお願いがあって…」","D":"「山田課長、このキャンペーン、社長決裁済みの重要プロジェクトです。システム部門にも優先度高く対応してほしいんですが」","correct":"A"},"furumai":{"A":"相手の都合を先に聞き、こちらの要件を共有した上で「一緒にスケジュールを調整できないか」と提案する","B":"「効率的に進めるために、〇〇の方法でお願いします」とこちらのやり方を指定する","C":"「いつ頃なら対応可能ですか？」と相手の都合に完全に委ねる","D":"自分の上長にエスカレーションして、正式な依頼ルートを回す","correct":"A"},"result":"A + A","naze":"他部署への依頼は、社内とはいえ**「相手にも相手の仕事がある」**ことが前提。まず「お忙しいところ恐れ入ります」と相手の状況を認めることで、「こちらの事情を押し付けるつもりはない」というサインになる。\n\n「ご相談がございます」という言葉で、一方的な依頼ではなく**双方向の話し合いの姿勢**を示せている。これで相手も「なんとかしよう」という気になりやすくなる。","otoshiana":"ENTJは**「効率的に進めるために、要件も手順も明確に伝えるのが親切」**と思いがち。Bの切り出し方はまさにそのパターン。期日、リソース、工数まで指定すると、相手は「依頼じゃなくて命令？」と感じる。システム部門にはシステム部門のやり方や事情がある。\n\nもう一つ注意。ENTJは**「権限を使って動かす」**のも選びがち（D）。確かにエスカレーションすれば動くけど、押し付けられた側は「仕方なくやる」態度になり、協力の質が下がる。現場同士の信頼関係で動くのが長期的には有利になりやすい。","hint":"**他部署への依頼の基本パターン：**\n1. 「お忙しいところ恐れ入ります」（相手の状況を認める）\n2. 「〇〇の件でご相談がございます」（「お願い」より「相談」が良い）\n3. 「まずは今の状況を教えていただけますか」（相手の都合を先に聞く）\n\n**言い換え例：**\n- ×「〇日までに、〇〇人で、この方法でお願いします」（指示命令）\n- 〇「〇日が理想ですが、山田課長のスケジュールに合わせて調整できます」（柔軟性を示す）","more":"他部署との協力で意識したいのが**「Win-Winの着地点」**を探ること。ENTJは「自分の目的を達成する」ことに集中しがちだけど、相手にとってのメリットも考えると協力が得られやすくなる。例えば「キャンペーンのLP開発を通じて、〇〇の技術検証もできますよ」と提案できれば、システム部門にとってもメリットのある依頼になる。これが**「組織横断的リーダーシップ」**の基本。"}},"INTJ":{"1":{"situation":"あなたは社内プロジェクトのリーダーを任されている。\n来週金曜が納期の重要な成果物について、協力会社からの納品遅延が判明。全体スケジュールが3日ほど後ろ倒しになる見込みだ。\n\n田中部長（プロジェクト責任者）にこの事実を報告し、今後の対応を相談しなければならない。","kiridashi":{"A":"「部長、今お時間よろしいでしょうか。〇〇プロジェクトについて、ご報告とご相談がございます」","B":"「部長、〇〇プロジェクトの納期が3日遅延します。原因は協力会社の納品遅れです。対策案を3つ用意しました」","C":"「部長…お忙しいところ申し訳ないんですが…〇〇の件で、ちょっとご相談が…」","D":"「部長、〇〇プロジェクトについて、先ほど確認した進捗データを見ていただきたいのですが」","correct":"A"},"furumai":{"A":"資料を手に持ち、相手の目を見て、落ち着いた声ではじめる","B":"PCを開いたまま、画面を見ながら淡々と説明する","C":"姿勢を低くし、申し訳なさそうな表情で切り出す","D":"腕を組み、少し後ろに重心を置いて話す","correct":"A"},"result":"A + A","naze":"「今お時間よろしいでしょうか」は、相手の状況を尊重する基本の切り出し。田中部長は多忙な管理職だから、いきなり本題に入られると心の準備ができていない。\n\n「ご報告とご相談がございます」と伝えることで、**話の目的を先に示して、相手に受け止める準備を促せる**。これだけで、悪い報告でも受け入れられやすくなる。","otoshiana":"INTJは**「事実と対策を早く伝えることが最大の誠意」**と考えがち。Bの切り出し方はまさにそのパターン。「結論ファースト」自体は悪くないけど、悪い報告をいきなりぶつけると相手は感情的に反応してしまう。\n\nもう一つ注意点。INTJは**「完璧な対策を用意してから報告しよう」**として、結果的に報告が遅れがち。対策が完成していなくても、事象が判明した時点で第一報を入れるのがおすすめ。","hint":"**悪い報告の3ステップ切り出し：**\n1. 「今お時間よろしいでしょうか」（タイミングの確認）\n2. 「ご報告とご相談がございます」（目的の提示）\n3. 「実は〜」（本題に入る）\n\n**言い換え例：**\n- ×「納期が遅れます」（事実だけ投げる）\n- 〇「スケジュールに影響が出る可能性があり、ご相談がございます」（相手を招待する表現）","more":"報連相の基本原則は**「悪い報告ほど早く、でも丁寧に」**。このスキルには名前があって、**アサーティブコミュニケーション**（自己主張と相手配慮の両立）と呼ばれている。事実を正直に伝えつつ、相手の受け止め方に配慮する。このバランスが、ビジネスでの信頼関係の基盤になる。"},"2":{"situation":"あなたは新規プロジェクトのメンバーとして参加している。\n同僚の佐藤さんが担当しているデザイン作業の進捗が予定より遅れており、このままではあなたの担当領域（フロントエンド実装）の着手にも影響が出そうだ。\n\n佐藤さんに状況を確認し、どう進めるか話し合いたい。","kiridashi":{"A":"「佐藤さん、今ちょっといいかな。プロジェクトの進捗について、確認と相談があるんだけど」","B":"「佐藤さん、タスク管理ツール見たんだけど、デザインのステータス変わってないね。これだとスケジュール厳しくない？」","C":"「佐藤さん…お忙しいと思いますが…デザインの件でちょっと気になってて…」","D":"「佐藤さん、デザインの進捗どうなってる？ これ以上遅れると俺の作業に響くんだけど」","correct":"A"},"furumai":{"A":"まず相手の状況を聞き、「一緒に進め方を考えたい」と協力姿勢を示す","B":"自分で代替案を作って、「こうすれば解決できる」と提案する","C":"「いつ頃できそう？」と相手のペースに任せる","D":"「手伝おうか？」と相手の作業に直接介入する","correct":"A"},"result":"A + A","naze":"同僚関係は上下関係ではない。対等な立場だからこそ、「確認と相談」という言葉で**相手を責めるのではなく、一緒に考える姿勢**を見せることが大切。\n\nいきなり「遅れてる」「厳しい」と事実を突きつけられると、相手は防御的になる。まずは相手の事情を聞くことで、本当のボトルネックが見えてくる。","otoshiana":"INTJは**「事実は事実として指摘するのが合理的」**と考えがち。BやDの切り出し方はまさにそのパターン。データで指摘された側は「監視されてる」と感じて警戒してしまう。\n\nもう一つ。INTJは**「自分で解決案を作って渡す」**のが得意だから、Bのように一人で答えを出しがち。でも同僚相手なら、一緒に考えた方が関係も成果も良くなる。","hint":"**同僚への「確認＋相談」の基本パターン：**\n1. 「今ちょっといいかな」（タイミング確認）\n2. 「〇〇の件で、確認と相談があるんだけど」（目的を先に伝える）\n3. 「今どんな状況か教えてもらえる？」（相手の状況を先に聞く）\n\n**言い換え例：**\n- ×「進捗遅れてるよね」（事実の指摘だけ）\n- 〇「一緒にスケジュール調整できないかな」（協力の招待）","more":"この場面で使えるのが**「水平型コミュニケーション」**。上下関係ではなく対等な関係性で課題を解決するアプローチ。同僚との信頼関係は、指示命令ではなく**「一緒に考える」姿勢**で築かれる。この意識が、のちのち自分が困ったときの助け合いの土台になる。"},"3":{"situation":"あなたはチームのサブリーダー。入社2年目の後輩・高橋さんが、クライアント向けの提案資料に複数のデータミスを混入させてしまった。\n幸い提出前にあなたが発見したが、高橋さんにはミスの原因を理解してもらい、同じ間違いを繰り返さないように指導したい。","kiridashi":{"A":"「高橋さん、提出前の資料チェックしてて気になった点があったんだけど、ちょっと見てくれる？」","B":"「高橋さん、この資料の〇〇ページ、数値が間違ってるよ。確認した？」","C":"「高橋さん…資料なんだけど…ちょっと直したいところがあって…」","D":"「高橋さん、データの検証プロセスについて、後で時間もらえる？」","correct":"A"},"furumai":{"A":"具体的にどこが違うかを示し、「どうやって確認したか教えてくれる？」と原因を一緒に考える","B":"「ここからここまで間違ってる。正しくはこれ」と正解を示して終わる","C":"「まあ提出前でよかったね」と軽く流す","D":"「これくらいのミス、自分で気づかないとまずいよ」と厳しく指導する","correct":"A"},"result":"A + A","naze":"「気になった点がある」という言い方は、ミスを**「指摘」ではなく「一緒に確認」**というフレームに変えている。後輩が防御的になるのを防げる。\n\n「ちょっと見てくれる？」と問いかけ形にすることで、相手に自分で気づく機会を与えている。自分で見つけたミスの方が、次から意識に残りやすい。","otoshiana":"INTJは**「正解を教えるのが近道」**と考えがち。Bの対応はまさにそのパターン。効率的だけど、後輩は「言われた通りに直す」だけで終わり、根本的な原因に向き合わない。\n\nもう一つ注意。INTJは**「論理的に説明すれば分かるはず」**と思いがちだけど、ミスをした本人は「怒られるかも」と緊張している。まず安心させてから原因を聞くのが、指導の基本。","hint":"**後輩へのフィードバックの基本パターン：**\n1. 「ちょっと見てくれる？」（共に確認する姿勢）\n2. 「ここ、〇〇と××で数字が違うね」（事実を具体的に指摘）\n3. 「どうやって確認したか教えてもらえる？」（プロセスを一緒に振り返る）\n\n**言い換え例：**\n- ×「ここ間違ってるよ。直して」（正解の押し付け）\n- 〇「ここ、元のデータと数字が合わないんだけど、どこから持ってきたか一緒に見てみよう」（一緒に考える姿勢）","more":"後輩指導で意識したいのが**「コーチング」**の考え方。答えを教えるのではなく、質問で相手の思考を引き出すアプローチ。「どうやって確認した？」「どこで違ったと思う？」と問いかけることで、後輩自身が気づきを得られる。この**「TeachではなくAsk」**の原則は、1on1ミーティングでも日常の指導でも使える基本スキル。"},"4":{"situation":"あなたはWeb制作会社のプロジェクトマネージャー。\nクライアントの鈴木社長から「納品前に機能を追加したい」という要望が入った。仕様は既に確定し、追加費用の予算はない。\n\n追加費用なしでは対応が難しいが、クライアントとの関係も悪くしたくない。鈴木社長に対応方針を伝える必要がある。","kiridashi":{"A":"「鈴木社長、ご要望ありがとうございます。一度内容を整理させていただき、改めてご提案してもよろしいでしょうか」","B":"「鈴木社長、その追加機能ですと、追加費用と納期の延長が必要になります。いかがなさいますか」","C":"「鈴木社長…ご希望はできるだけお応えしたいのですが…社内で検討させていただけますか…」","D":"「鈴木社長、現行の仕様ですと〇〇の機能が不足しているということでしょうか。要件定義書を確認させてください」","correct":"A"},"furumai":{"A":"相手の要望の背景を質問で深掘りし、本当に必要なものを一緒に整理する","B":"追加費用の試算をその場で提示し、条件を明確にする","C":"「何とかします」と安請け合いして、後で社内に持ち帰る","D":"「今回は難しいですが、次回の改修で対応しましょう」と先延ばしする","correct":"A"},"result":"A + A","naze":"クライアントの要望をまず受け止めることが出発点。「ありがとうございます」で相手の提案を尊重しつつ、「整理して改めてご提案」と**即答を避けて考える時間を確保**している。\n\n即座に「追加費用が必要です」と断る（B）と、相手は突き放されたと感じる。まず相手の真のニーズを理解してから、一緒に解決策を探るのが効果的。","otoshiana":"INTJは**「契約・仕様が全て」**と考える傾向がある。BやDの切り出し方はまさにそのパターン。論理的には正しいけど、クライアント関係では「まず受け止める」ステップを飛ばすと信頼を損なう。\n\nもう一つ注意。INTJは**「その場で論理的に片付けよう」**として、相手の感情的な背景を見落としがち。「なぜその機能が急に必要になったのか」を聞くと、実は予算内で代替できる方法が見つかることが多い。","hint":"**クライアントの追加要望への3ステップ：**\n1. 「ありがとうございます／ご要望、承知しました」（まず受け止める）\n2. 「少し具体的に教えても良いですか？ どういう場面で使いたいかなど」（背景を深掘り）\n3. 「整理して、〇日までにご提案します」（即答せず時間をもらう）\n\n**言い換え例：**\n- ×「それは仕様外なので追加費用がかかります」（門前払い）\n- 〇「ご要望の意図を教えていただければ、ベストな提案ができます」（協力の姿勢）","more":"この場面で鍵になるのが**「ニーズの背後にあるニーズ」**を探るスキル。顧客が「機能が欲しい」と言うとき、本当は「不安を解消したい」「競合に遅れを取りたくない」など別の理由があることが多い。これを**「背後要件の探索」**と呼ぶ。機能そのものではなく、その奥にある課題を解決する提案ができると、信頼度が一気に上がる。"},"5":{"situation":"あなたはマーケティング部門のメンバー。来月実施するキャンペーンの企画が承認されたが、実行にはシステム部門の協力（LPの開発とサーバー準備）が必要だ。\n\nシステム部門は今、自社サービスの大型リリース準備で忙しいと聞いている。システム部門の山田課長に協力を依頼しなければならない。","kiridashi":{"A":"「山田課長、お忙しいところ恐れ入ります。マーケティングの〇〇キャンペーンの件で、ご相談がございます」","B":"「山田課長、〇〇キャンペーンのLP開発をお願いしたいです。仕様書はこちらで用意しました」","C":"「山田課長…システム部門いま忙しいとお聞きしてるんですが…実はお願いがあって…」","D":"「山田課長、〇〇キャンペーンの件ですが、経営陣からも優先度高いプロジェクトなので、ご協力をお願いします」","correct":"A"},"furumai":{"A":"相手の都合を先に聞き、こちらの要件を共有した上で「一緒にスケジュールを調整できないか」と提案する","B":"「最低限〇〇だけでもお願いできますか」と要求を最小化して伝える","C":"「いつ頃なら対応可能ですか？」と相手の都合に完全に委ねる","D":"自分の上長にエスカレーションして、正式な依頼ルートを回す","correct":"A"},"result":"A + A","naze":"他部署への依頼は、社内とはいえ**「相手にも相手の仕事がある」**ことが前提。まず「お忙しいところ恐れ入ります」と相手の状況を認めることで、「こちらの事情を押し付けるつもりはない」というサインになる。\n\n「ご相談がございます」という言葉で、一方的な依頼ではなく**双方向の話し合いの姿勢**を示せている。これで相手も「なんとかしよう」という気になりやすくなる。","otoshiana":"INTJは**「仕様書が完成してれば、あとは頼むだけ」**と思いがち。Bの切り出し方はまさにそのパターン。準備が完璧でも、相手には相手の優先順位がある。\n\nもう一つ注意。INTJは**「上長にエスカレーションして正式ルートで依頼」**（D）も選びがち。権力で動かそうとすると、その後の協力関係が事務的で味気ないものになる。現場同士の信頼関係で動くのが長期的には有利になりやすい。","hint":"**他部署への依頼の基本パターン：**\n1. 「お忙しいところ恐れ入ります」（相手の状況を認める）\n2. 「〇〇の件でご相談がございます」（「お願い」より「相談」が良い）\n3. 「まずは今の状況を教えていただけますか」（相手の都合を先に聞く）\n\n**言い換え例：**\n- ×「〇〇までにお願いします」（一方的な依頼）\n- 〇「〇日が理想ですが、山田課長のスケジュールに合わせて調整できます」（柔軟性を示す）","more":"他部署との協力で意識したいのが**「組織横断的コミュニケーション」**のスキル。自分の部署の論理だけで動くのではなく、相手部門のKPIや優先事項を理解した上で**「Win-Winになる着地点」**を探る。この視点を持っている人ほど、社内での仕事がスムーズに進む。目の前の依頼を通じて、関係の貯金をしておく意識が大切。"}}};
</file>

<file path="index.html">
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Pieceful - MBTI Communication Quest</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DotGothic16&family=M+PLUS+Rounded+1c:wght@400;500;700;800;900&display=swap" rel="stylesheet" />
  <style>
    :root {
      --ink: #182235;
      --muted: #64748b;
      --paper: #fffdf7;
      --paper-2: #fff7d8;
      --line: #172033;
      --pink: #ec4899;
      --pink-2: #f9a8d4;
      --blue: #38bdf8;
      --green: #22c55e;
      --yellow: #facc15;
      --orange: #fb923c;
      --purple: #a855f7;
      --danger: #ef4444;
      --ok: #10b981;
      --shadow: 7px 7px 0 var(--line);
      --shadow-sm: 4px 4px 0 var(--line);
      --radius: 22px;
      --font: 'M PLUS Rounded 1c', 'Hiragino Maru Gothic ProN', sans-serif;
      --safe-x: clamp(14px, 4vw, 32px);
      --max: 1040px;
    }

    * { box-sizing: border-box; }
    html { min-height: 100%; }
    body {
      margin: 0;
      min-height: 100vh;
      color: var(--ink);
      font-family: var(--font);
      background:
        radial-gradient(circle at 16% 12%, rgba(255,255,255,.9) 0 5%, transparent 5.2%),
        radial-gradient(circle at 84% 18%, rgba(255,255,255,.72) 0 7%, transparent 7.2%),
        radial-gradient(circle at 72% 78%, rgba(255,255,255,.45) 0 9%, transparent 9.2%),
        linear-gradient(135deg, #c084fc 0%, #60a5fa 47%, #facc15 100%);
      overflow-x: hidden;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
      opacity: .18;
      background-image:
        linear-gradient(rgba(255,255,255,.45) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,.45) 1px, transparent 1px);
      background-size: 24px 24px;
      mask-image: linear-gradient(to bottom, #000, transparent 90%);
    }

    button, [role="button"] { font-family: inherit; }
    button { color: inherit; }

    .app {
      position: relative;
      z-index: 1;
      width: min(100%, var(--max));
      min-height: 100vh;
      margin: 0 auto;
      padding: clamp(14px, 3vw, 28px) var(--safe-x) clamp(24px, 5vw, 56px);
      display: grid;
      place-items: center;
    }

    .bg-chip {
      position: fixed;
      z-index: 0;
      pointer-events: none;
      filter: drop-shadow(4px 4px 0 rgba(24,34,53,.18));
      animation: floaty 5s ease-in-out infinite;
      opacity: .88;
    }
    .chip-1 { left: 5vw; top: 9vh; font-size: clamp(34px, 7vw, 78px); }
    .chip-2 { right: 7vw; top: 11vh; font-size: clamp(40px, 8vw, 90px); animation-delay: .4s; }
    .chip-3 { left: 8vw; bottom: 12vh; font-size: clamp(28px, 5vw, 54px); animation-delay: .9s; }
    .chip-4 { right: 12vw; bottom: 10vh; font-size: clamp(30px, 6vw, 68px); animation-delay: 1.2s; }

    @keyframes floaty {
      0%, 100% { transform: translateY(0) rotate(-3deg); }
      50% { transform: translateY(-14px) rotate(4deg); }
    }

    .screen {
      display: none;
      width: 100%;
      animation: screenIn .28s cubic-bezier(.2,.9,.2,1);
    }
    .screen.active { display: block; }

    @keyframes screenIn {
      from { opacity: 0; transform: translateY(16px) scale(.985); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }

    .window {
      width: 100%;
      background: var(--paper);
      border: 4px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      overflow: hidden;
    }

    .window-bar {
      min-height: 46px;
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 16px;
      background: #f8fafc;
      border-bottom: 4px solid var(--line);
    }
    .dot {
      width: 20px;
      height: 20px;
      border: 3px solid var(--line);
      border-radius: 999px;
      display: grid;
      place-items: center;
      font-weight: 900;
      font-size: 10px;
    }
    .dot.red { background: #fecaca; }
    .dot.yellow { background: #fef08a; }
    .dot.green { background: #bbf7d0; }
    .bar-title {
      margin-left: auto;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: .08em;
      color: var(--muted);
    }

    .window-body { padding: clamp(18px, 4vw, 42px); }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.05fr .95fr;
      gap: clamp(20px, 5vw, 52px);
      align-items: center;
    }

    .kicker {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 13px;
      border: 3px solid var(--line);
      border-radius: 999px;
      background: #eff6ff;
      box-shadow: var(--shadow-sm);
      font-size: clamp(12px, 2vw, 14px);
      font-weight: 900;
      letter-spacing: .08em;
      margin-bottom: 14px;
    }

    h1, h2, h3, p { margin: 0; }
    .title {
      font-size: clamp(42px, 10vw, 92px);
      line-height: .9;
      font-weight: 900;
      letter-spacing: -.05em;
      text-shadow: 5px 5px 0 rgba(255,255,255,.6);
    }
    .title small {
      display: block;
      margin-top: 10px;
      font-size: clamp(16px, 4vw, 28px);
      letter-spacing: .08em;
    }
    .lead {
      margin-top: 18px;
      font-size: clamp(15px, 2.8vw, 20px);
      line-height: 1.85;
      font-weight: 700;
      color: #334155;
    }

    .hero-card {
      position: relative;
      min-height: 330px;
      border: 4px solid var(--line);
      border-radius: 30px;
      background:
        radial-gradient(circle at 30% 22%, #fff 0 12%, transparent 12.5%),
        linear-gradient(160deg, #fff7ed, #dbeafe 58%, #fce7f3);
      box-shadow: var(--shadow);
      padding: 24px;
      overflow: hidden;
    }
    .hero-card::after {
      content: "";
      position: absolute;
      inset: auto -24px -34px -24px;
      height: 112px;
      background: linear-gradient(to bottom, #22c55e 0 42%, #92400e 42% 100%);
      border-top: 4px solid var(--line);
    }
    .main-mascot {
      position: absolute;
      left: 50%;
      bottom: 44px;
      transform: translateX(-50%);
      width: min(58%, 260px);
      aspect-ratio: 1;
      display: grid;
      place-items: center;
      animation: hop 2.6s ease-in-out infinite;
      z-index: 1;
    }
    .main-mascot img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      filter: drop-shadow(7px 9px 0 rgba(24,34,53,.22));
    }
    .speech {
      position: absolute;
      top: 22px;
      right: 18px;
      max-width: 220px;
      padding: 12px 14px;
      border: 3px solid var(--line);
      border-radius: 20px;
      background: white;
      box-shadow: var(--shadow-sm);
      font-weight: 900;
      line-height: 1.5;
      z-index: 2;
    }
    .speech::after {
      content: "";
      position: absolute;
      bottom: -13px;
      left: 42px;
      border-width: 12px 9px 0;
      border-style: solid;
      border-color: var(--line) transparent transparent;
    }
    .speech::before {
      content: "";
      position: absolute;
      bottom: -8px;
      left: 45px;
      z-index: 1;
      border-width: 9px 7px 0;
      border-style: solid;
      border-color: white transparent transparent;
    }
    .mini-stat {
      position: absolute;
      left: 18px;
      top: 22px;
      display: grid;
      gap: 8px;
      z-index: 2;
    }
    .mini-pill {
      width: fit-content;
      padding: 7px 10px;
      border: 3px solid var(--line);
      border-radius: 999px;
      background: #fef08a;
      box-shadow: 3px 3px 0 var(--line);
      font-size: 12px;
      font-weight: 900;
    }

    @keyframes hop {
      0%, 100% { transform: translateX(-50%) translateY(0) rotate(-2deg); }
      50% { transform: translateX(-50%) translateY(-12px) rotate(2deg); }
    }

    .actions {
      display: flex;
      gap: 14px;
      flex-wrap: wrap;
      align-items: center;
      margin-top: 28px;
    }
    .btn {
      border: 4px solid var(--line);
      border-radius: 18px;
      padding: 14px 22px;
      min-height: 56px;
      background: white;
      box-shadow: var(--shadow-sm);
      font-size: clamp(15px, 2.5vw, 20px);
      font-weight: 900;
      cursor: pointer;
      transition: transform .12s ease, box-shadow .12s ease, background .12s ease;
    }
    .btn:hover { transform: translate(-3px,-3px); box-shadow: 7px 7px 0 var(--line); }
    .btn:active { transform: translate(2px,2px); box-shadow: 2px 2px 0 var(--line); }
    .btn.primary { background: var(--yellow); }
    .btn.pink { background: #fbcfe8; }
    .btn.blue { background: #bfdbfe; }
    .btn.full { width: 100%; justify-content: center; }

    .topbar {
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: 12px;
      align-items: center;
      margin-bottom: 18px;
    }
    .back-btn {
      width: 48px;
      height: 48px;
      border: 4px solid var(--line);
      border-radius: 16px;
      background: white;
      box-shadow: var(--shadow-sm);
      font-size: 22px;
      font-weight: 900;
      cursor: pointer;
    }
    .screen-title {
      text-align: center;
      font-size: clamp(22px, 4vw, 38px);
      font-weight: 900;
      line-height: 1.25;
    }
    .subnote {
      text-align: center;
      margin: 6px auto 0;
      max-width: 680px;
      color: #475569;
      font-size: clamp(13px, 2.3vw, 16px);
      line-height: 1.7;
      font-weight: 700;
    }

    .character-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: clamp(10px, 2.2vw, 18px);
      margin-top: 24px;
    }
    .character-card {
      position: relative;
      border: 4px solid var(--line);
      border-radius: 24px;
      background: #fff;
      box-shadow: var(--shadow-sm);
      cursor: pointer;
      min-height: 154px;
      padding: 8px;
      overflow: hidden;
      transition: transform .16s ease, box-shadow .16s ease;
    }
    .character-card:hover { transform: translate(-4px,-4px) rotate(-1deg); box-shadow: 8px 8px 0 var(--line); }
    .character-card::before {
      content: attr(data-group);
      position: absolute;
      left: 8px;
      top: 8px;
      z-index: 2;
      padding: 4px 8px;
      border: 2px solid var(--line);
      border-radius: 999px;
      background: rgba(255,255,255,.86);
      font-size: 10px;
      font-weight: 900;
    }
    .character-card img {
      width: 100%;
      height: 106px;
      object-fit: contain;
      display: block;
      filter: drop-shadow(3px 5px 0 rgba(24,34,53,.18));
    }
    .character-card .type {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 4px;
      padding: 7px 9px;
      border: 3px solid var(--line);
      border-radius: 14px;
      background: #f8fafc;
      font-weight: 900;
      font-size: 13px;
    }
    .group-analyst { background: linear-gradient(145deg, #f3e8ff, #fff); }
    .group-diplomat { background: linear-gradient(145deg, #dcfce7, #fff); }
    .group-sentinel { background: linear-gradient(145deg, #dbeafe, #fff); }
    .group-explorer { background: linear-gradient(145deg, #ffedd5, #fff); }

    .stage-map {
      position: relative;
      min-height: 620px;
      margin-top: 18px;
      border: 4px solid var(--line);
      border-radius: 34px;
      background:
        radial-gradient(circle at 50% 44%, rgba(255,255,255,.92) 0 21%, transparent 21.5%),
        radial-gradient(circle at 18% 70%, rgba(254,240,138,.72) 0 14%, transparent 14.3%),
        radial-gradient(circle at 82% 68%, rgba(191,219,254,.72) 0 15%, transparent 15.3%),
        linear-gradient(160deg, #ecfeff, #fef3c7 62%, #dcfce7);
      box-shadow: var(--shadow);
      overflow: hidden;
      padding: 28px;
    }
    .stage-map::after {
      content: "";
      position: absolute;
      left: -24px;
      right: -24px;
      bottom: -12px;
      height: 102px;
      background: linear-gradient(to bottom, #22c55e 0 38%, #92400e 38% 100%);
      border-top: 4px solid var(--line);
    }
    .chosen-hero {
      position: absolute;
      left: 50%;
      top: 48%;
      transform: translate(-50%, -50%);
      display: grid;
      place-items: center;
      text-align: center;
      z-index: 4;
      animation: floaty 3.8s ease-in-out infinite;
    }
    .chosen-hero img {
      width: clamp(116px, 20vw, 190px);
      height: clamp(116px, 20vw, 190px);
      object-fit: contain;
      filter: drop-shadow(6px 8px 0 rgba(24,34,53,.2));
    }
    .chosen-label {
      margin-top: -8px;
      display: inline-flex;
      gap: 8px;
      align-items: center;
      padding: 8px 14px;
      border: 4px solid var(--line);
      border-radius: 999px;
      background: white;
      box-shadow: var(--shadow-sm);
      font-weight: 900;
    }
    .stage-node {
      position: absolute;
      z-index: 5;
      width: min(210px, 28vw);
      border: 0;
      background: transparent;
      cursor: pointer;
      display: grid;
      justify-items: center;
      gap: 8px;
      transition: transform .16s ease;
    }
    .stage-node:hover { transform: translateY(-6px) rotate(-1deg); }
    .stage-node img {
      width: clamp(84px, 14vw, 150px);
      height: clamp(84px, 14vw, 150px);
      object-fit: contain;
      filter: drop-shadow(4px 6px 0 rgba(24,34,53,.2));
    }
    .node-label {
      position: relative;
      padding: 10px 13px;
      border: 4px solid var(--line);
      border-radius: 18px;
      background: white;
      box-shadow: var(--shadow-sm);
      font-size: clamp(13px, 2vw, 17px);
      line-height: 1.25;
      font-weight: 900;
      white-space: nowrap;
    }
    .node-label small {
      display: block;
      color: var(--muted);
      font-size: 11px;
      letter-spacing: .06em;
      margin-top: 3px;
    }
    .stage-1 { left: 4%; bottom: 116px; }
    .stage-2 { left: 4%; top: 26%; }
    .stage-3 { left: 50%; bottom: 58px; transform: translateX(-50%); }
    .stage-3:hover { transform: translateX(-50%) translateY(-6px) rotate(-1deg); }
    .stage-4 { right: 4%; top: 25%; }
    .stage-5 { right: 4%; bottom: 116px; }

    .hud {
      display: grid;
      grid-template-columns: 1fr auto auto;
      gap: 12px;
      align-items: center;
      margin-bottom: 16px;
    }
    .hud-card {
      border: 4px solid var(--line);
      border-radius: 20px;
      background: white;
      box-shadow: var(--shadow-sm);
      padding: 10px 14px;
      font-weight: 900;
    }
    .trust {
      display: grid;
      gap: 6px;
    }
    .trust-head { display: flex; justify-content: space-between; gap: 12px; font-size: 13px; }
    .meter {
      height: 22px;
      border: 3px solid var(--line);
      border-radius: 999px;
      background: #cbd5e1;
      overflow: hidden;
    }
    .meter-fill {
      height: 100%;
      width: 35%;
      background: linear-gradient(90deg, var(--yellow), var(--orange));
      transition: width .5s cubic-bezier(.2,.9,.2,1);
    }

    .mission-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 260px;
      gap: clamp(16px, 3vw, 30px);
      align-items: start;
    }
    .mission-card {
      border: 4px solid var(--line);
      border-radius: 26px;
      background: var(--paper);
      box-shadow: var(--shadow);
      padding: clamp(18px, 3vw, 30px);
    }
    .mission-kicker {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 12px;
      padding: 7px 12px;
      border: 3px solid var(--line);
      border-radius: 999px;
      background: #fce7f3;
      box-shadow: 3px 3px 0 var(--line);
      font-weight: 900;
      font-size: 13px;
    }
    .scenario {
      font-size: clamp(15px, 2.4vw, 19px);
      line-height: 1.95;
      font-weight: 700;
      color: #243244;
    }
    .npc-panel {
      position: sticky;
      top: 16px;
      border: 4px solid var(--line);
      border-radius: 26px;
      background: #fff;
      box-shadow: var(--shadow);
      padding: 16px;
      text-align: center;
    }
    .npc-panel img {
      width: 100%;
      max-width: 190px;
      height: 190px;
      object-fit: contain;
      filter: drop-shadow(5px 7px 0 rgba(24,34,53,.18));
    }
    .npc-name {
      margin-top: 8px;
      border: 3px solid var(--line);
      border-radius: 999px;
      background: #f8fafc;
      padding: 8px 10px;
      font-weight: 900;
    }
    .npc-tag {
      display: inline-flex;
      margin-top: 8px;
      padding: 5px 9px;
      border: 2px solid var(--line);
      border-radius: 999px;
      background: #e0f2fe;
      font-size: 12px;
      font-weight: 900;
    }

    .choice-title {
      margin: 20px 0 12px;
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: clamp(20px, 3vw, 30px);
      font-weight: 900;
      color: #be185d;
    }
    .choices {
      display: grid;
      gap: 13px;
    }
    .choice {
      width: 100%;
      text-align: left;
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: 12px;
      align-items: center;
      padding: 14px;
      border: 4px solid var(--line);
      border-radius: 20px;
      background: white;
      box-shadow: var(--shadow-sm);
      cursor: pointer;
      transition: transform .12s ease, box-shadow .12s ease, background .12s ease;
    }
    .choice:hover { transform: translate(-3px,-3px); box-shadow: 7px 7px 0 var(--line); background: #f8fafc; }
    .choice:active { transform: translate(2px,2px); box-shadow: 2px 2px 0 var(--line); }
    .letter {
      width: 42px;
      height: 42px;
      display: grid;
      place-items: center;
      border: 3px solid var(--line);
      border-radius: 14px;
      background: var(--yellow);
      font-size: 22px;
      font-weight: 900;
    }
    .choice span.text {
      font-size: clamp(14px, 2.2vw, 17px);
      line-height: 1.65;
      font-weight: 800;
    }
    .risk {
      justify-self: end;
      padding: 5px 8px;
      border: 2px solid var(--line);
      border-radius: 999px;
      background: #f1f5f9;
      font-size: 11px;
      font-weight: 900;
      white-space: nowrap;
    }

    .feedback-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 280px;
      gap: clamp(16px, 3vw, 30px);
      align-items: start;
    }
    .result-card {
      border: 4px solid var(--line);
      border-radius: 28px;
      background: white;
      box-shadow: var(--shadow);
      padding: clamp(20px, 4vw, 36px);
      position: relative;
      overflow: hidden;
    }
    .result-card.good { background: linear-gradient(145deg, #ecfdf5, #fff); }
    .result-card.bad { background: linear-gradient(145deg, #fff1f2, #fff); }
    .result-card.okay { background: linear-gradient(145deg, #fffbeb, #fff); }
    .grade {
      display: inline-grid;
      place-items: center;
      width: 78px;
      height: 78px;
      border: 4px solid var(--line);
      border-radius: 24px;
      background: var(--yellow);
      box-shadow: var(--shadow-sm);
      font-size: 34px;
      font-weight: 900;
      transform: rotate(-4deg);
      margin-bottom: 18px;
    }
    .result-title {
      font-size: clamp(24px, 4vw, 42px);
      font-weight: 900;
      line-height: 1.2;
      margin-bottom: 10px;
    }
    .result-message {
      font-size: clamp(15px, 2.5vw, 19px);
      line-height: 1.85;
      font-weight: 700;
      color: #334155;
    }
    .quote-card {
      margin-top: 18px;
      border: 3px solid var(--line);
      border-radius: 20px;
      padding: 14px 16px;
      background: #f0f9ff;
      font-weight: 900;
      line-height: 1.65;
    }
    .coach-panel {
      border: 4px solid var(--line);
      border-radius: 26px;
      background: #fff7ed;
      box-shadow: var(--shadow);
      padding: 16px;
      text-align: center;
    }
    .coach-panel img {
      width: 100%;
      max-width: 190px;
      height: 170px;
      object-fit: contain;
      filter: drop-shadow(5px 7px 0 rgba(24,34,53,.18));
    }
    .coach-bubble {
      margin-top: 10px;
      padding: 12px;
      border: 3px solid var(--line);
      border-radius: 18px;
      background: white;
      box-shadow: 3px 3px 0 var(--line);
      font-weight: 900;
      line-height: 1.55;
      text-align: left;
    }

    .lesson-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: clamp(12px, 2.4vw, 20px);
      margin-top: 20px;
    }
    .lesson-card {
      border: 4px solid var(--line);
      border-radius: 24px;
      background: #fef9c3;
      box-shadow: var(--shadow-sm);
      padding: 18px;
      cursor: pointer;
      transition: transform .14s ease, box-shadow .14s ease;
    }
    .lesson-card:hover { transform: translate(-3px,-3px); box-shadow: 7px 7px 0 var(--line); }
    .lesson-head {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      align-items: flex-start;
    }
    .lesson-head h3 {
      font-size: clamp(15px, 2.4vw, 20px);
      line-height: 1.35;
      font-weight: 900;
    }
    .toggle {
      flex: 0 0 auto;
      width: 38px;
      height: 38px;
      display: grid;
      place-items: center;
      border: 3px solid var(--line);
      border-radius: 999px;
      background: var(--orange);
      color: white;
      box-shadow: 3px 3px 0 var(--line);
      font-weight: 900;
      transition: transform .18s ease;
    }
    .lesson-body {
      display: grid;
      grid-template-rows: 0fr;
      transition: grid-template-rows .2s ease;
    }
    .lesson-body > div { overflow: hidden; }
    .lesson-card.open .lesson-body { grid-template-rows: 1fr; }
    .lesson-card.open .toggle { transform: rotate(180deg); }
    .lesson-card p {
      margin-top: 12px;
      font-size: 14px;
      line-height: 1.75;
      font-weight: 700;
      color: #475569;
    }

    .modal-backdrop {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 20;
      background: rgba(15,23,42,.45);
      padding: 20px;
      place-items: center;
    }
    .modal-backdrop.active { display: grid; }
    .modal {
      width: min(100%, 720px);
      max-height: min(86vh, 760px);
      overflow: auto;
      background: var(--paper);
      border: 4px solid var(--line);
      border-radius: 28px;
      box-shadow: 12px 12px 0 rgba(15,23,42,.45);
      padding: clamp(18px, 4vw, 30px);
      animation: pop .18s ease-out;
    }
    @keyframes pop { from { transform: scale(.96); opacity: 0; } to { transform: scale(1); opacity: 1; } }
    .modal h2 { font-size: clamp(22px, 4vw, 34px); font-weight: 900; margin-bottom: 12px; }
    .modal p, .modal li { font-size: 15px; line-height: 1.8; font-weight: 700; color: #334155; }
    .modal ul { margin: 12px 0 0; padding-left: 1.2em; }

    .toast {
      position: fixed;
      left: 50%;
      bottom: 22px;
      z-index: 30;
      transform: translateX(-50%) translateY(20px);
      opacity: 0;
      transition: opacity .16s ease, transform .16s ease;
      width: min(calc(100% - 28px), 560px);
      padding: 12px 16px;
      border: 4px solid var(--line);
      border-radius: 18px;
      background: white;
      box-shadow: var(--shadow);
      font-weight: 900;
      text-align: center;
      pointer-events: none;
    }
    .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

    .confetti {
      position: fixed;
      inset: 0;
      pointer-events: none;
      overflow: hidden;
      z-index: 25;
    }
    .confetti i {
      position: absolute;
      top: -20px;
      width: 12px;
      height: 18px;
      border: 2px solid rgba(24,34,53,.3);
      border-radius: 4px;
      animation: fall 900ms linear forwards;
    }
    @keyframes fall {
      to { transform: translateY(110vh) rotate(420deg); opacity: .2; }
    }

    :focus-visible {
      outline: 4px dashed #0f172a;
      outline-offset: 4px;
    }

    @media (max-width: 860px) {
      .hero-grid,
      .mission-layout,
      .feedback-grid {
        grid-template-columns: 1fr;
      }
      .hero-card { min-height: 280px; }
      .npc-panel,
      .coach-panel { position: relative; top: auto; }
      .npc-panel img,
      .coach-panel img { height: 150px; }
      .hud { grid-template-columns: 1fr 1fr; }
      .hud .trust { grid-column: 1 / -1; order: 3; }
      .character-grid { grid-template-columns: repeat(2, 1fr); }
      .stage-map {
        min-height: auto;
        display: grid;
        gap: 14px;
        padding: 18px;
      }
      .stage-map::after { display: none; }
      .chosen-hero,
      .stage-node {
        position: relative;
        inset: auto;
        transform: none !important;
        width: 100%;
      }
      .chosen-hero {
        order: -1;
        margin-bottom: 6px;
      }
      .stage-node {
        grid-template-columns: 96px 1fr;
        justify-items: start;
        align-items: center;
        border: 4px solid var(--line);
        border-radius: 24px;
        background: rgba(255,255,255,.76);
        box-shadow: var(--shadow-sm);
        padding: 10px;
      }
      .stage-node img { width: 88px; height: 88px; }
      .node-label { white-space: normal; width: 100%; text-align: left; }
    }

    @media (max-width: 560px) {
      .window-bar { min-height: 40px; padding: 8px 10px; }
      .dot { width: 16px; height: 16px; border-width: 2px; }
      .bar-title { display: none; }
      .actions .btn { width: 100%; }
      .topbar { grid-template-columns: auto 1fr; }
      .topbar .hud-card { display: none; }
      .character-card { min-height: 128px; border-radius: 20px; }
      .character-card img { height: 86px; }
      .character-card .type { font-size: 12px; padding: 5px 7px; }
      .choice { grid-template-columns: auto 1fr; }
      .choice .risk { grid-column: 2; justify-self: start; }
      .lesson-grid { grid-template-columns: 1fr; }
      .hud { grid-template-columns: 1fr; }
      .hud-card { padding: 9px 12px; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: .001ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: .001ms !important;
      }
    }


    /* =====================================================
       8-BIT / FAMICOM SKIN v2
       方針：雰囲気は8-bit、本文は読みやすく、ステージは重ならない
       ===================================================== */
    :root {
      --ink: #10172f;
      --muted: #536177;
      --paper: #fff6d8;
      --paper-2: #f3dda2;
      --line: #071024;
      --navy: #071b3a;
      --navy-2: #0a294b;
      --teal: #0f7f74;
      --pink: #e74d80;
      --blue: #2395cc;
      --green: #4caf50;
      --yellow: #f5c542;
      --orange: #d86d32;
      --danger: #b82e2e;
      --shadow: 8px 8px 0 #071024;
      --shadow-sm: 4px 4px 0 #071024;
      --radius: 0px;
      --font: 'M PLUS Rounded 1c', 'Hiragino Kaku Gothic ProN', sans-serif;
      --font-pixel: 'DotGothic16', 'M PLUS Rounded 1c', monospace;
    }

    html {
      image-rendering: auto;
    }

    body {
      font-family: var(--font);
      letter-spacing: .01em;
      background:
        linear-gradient(rgba(255,255,255,.035) 50%, rgba(0,0,0,.035) 50%) 0 0 / 100% 4px,
        linear-gradient(180deg, #071b3a 0%, #0b3556 52%, #118063 52%, #118063 64%, #78451f 64%, #4e2c19 100%);
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }

    body::before {
      opacity: .22;
      background-image:
        linear-gradient(90deg, rgba(255,255,255,.08) 1px, transparent 1px),
        linear-gradient(rgba(255,255,255,.08) 1px, transparent 1px);
      background-size: 8px 8px;
      mask-image: none;
      mix-blend-mode: screen;
    }

    body::after {
      content: "";
      position: fixed;
      inset: 0;
      z-index: 50;
      pointer-events: none;
      opacity: .08;
      background: repeating-linear-gradient(
        to bottom,
        rgba(255,255,255,.18) 0,
        rgba(255,255,255,.18) 1px,
        transparent 1px,
        transparent 4px
      );
    }

    .app::before,
    .app::after {
      content: "";
      position: fixed;
      z-index: 0;
      pointer-events: none;
      width: 120px;
      height: 48px;
      opacity: .85;
      background:
        linear-gradient(#fff6d8 0 0) 0 18px / 24px 12px no-repeat,
        linear-gradient(#fff6d8 0 0) 20px 10px / 64px 24px no-repeat,
        linear-gradient(#fff6d8 0 0) 82px 20px / 34px 12px no-repeat,
        linear-gradient(#d8d0ae 0 0) 8px 30px / 76px 6px no-repeat;
      filter: drop-shadow(4px 4px 0 rgba(0,0,0,.24));
      animation: pixelCloud 8s steps(5, end) infinite;
    }
    .app::before { left: 4vw; top: 9vh; }
    .app::after { right: 5vw; top: 13vh; transform: scale(.9); animation-delay: 1s; }

    @keyframes pixelCloud {
      0%, 100% { translate: 0 0; }
      50% { translate: 18px 0; }
    }

    .bg-chip {
      font-family: var(--font-pixel);
      color: transparent;
      opacity: .78;
      filter: none;
      text-shadow: none;
      animation: bitBlink 1.4s steps(2, end) infinite;
    }
    .chip-1::before { content: "●"; color: #fff6d8; text-shadow: 3px 3px 0 #071024; }
    .chip-2::before { content: "★"; color: #fff6d8; text-shadow: 3px 3px 0 #071024; }
    .chip-3::before { content: "✦"; color: #fff6d8; text-shadow: 3px 3px 0 #071024; }
