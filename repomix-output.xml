    .screen-title,
    .choice-title,
    .result-title,
    .lesson-head h3,
    .modal h2,
    .btn,
    .back-btn,
    .letter,
    .risk,
    .kicker,
    .mission-kicker,
    .node-label,
    .chosen-label,
    .hud-card,
    .npc-name,
    .npc-tag,
    .grade,
    .bar-title {
      font-family: var(--font-pixel);
    }

    .screen-title {
      letter-spacing: .04em;
      color: #fff6d8;
      text-shadow: 3px 3px 0 #071024;
