          ['押し付けの回避', '自部署の目的だけを語ると、相手には追加作業として届きます。'],
          ['資料の作り方', '相手のメリット、必要な協力、作業時間、期限を1枚で見える化します。'],
          ['合意形成のコツ', '小さく始める提案にすると、相手は参加しやすくなります。']
        ]
      }
    };

    const state = {
      screen: 'title',
      character: 'ESTP',
      stage: 1,
      trust: 35,
      score: 0,
      combo: 0,
      lastChoice: null,
      lastAnswer: null
    };

    const $ = (id) => document.getElementById(id);

    function go(screen) {
      document.querySelectorAll('.screen').forEach(el => el.classList.remove('active'));
      const target = $(`screen-${screen}`);
      if (!target) return;
      target.classList.add('active');
      state.screen = screen;
      window.scrollTo({ top: 0, behavior: 'smooth' });
      syncHud();
    }

    function clamp(n, min, max) { return Math.max(min, Math.min(max, n)); }

    function syncHud() {
      const trust = clamp(state.trust, 0, 100);
      ['trust-label','trust-label-2'].forEach(id => { if ($(id)) $(id).textContent = `${trust}%`; });
      ['trust-fill','trust-fill-2'].forEach(id => { if ($(id)) $(id).style.width = `${trust}%`; });
      ['combo-label','combo-label-2'].forEach(id => { if ($(id)) $(id).textContent = `🔥 COMBO ${state.combo}`; });
      ['star-label','star-label-2','stage-score','lesson-score'].forEach(id => { if ($(id)) $(id).textContent = `⭐ ${state.score}`; });
      if ($('chosen-img')) $('chosen-img').src = charImages[state.character];
      if ($('chosen-type')) $('chosen-type').textContent = state.character;
      if ($('chosen-nick')) $('chosen-nick').textContent = charNick[state.character];
      if ($('coach-img')) $('coach-img').src = charImages[state.character];
    }

    function initCharacters() {
      const grid = $('character-grid');
      grid.innerHTML = characters.map(([type, nick, group, cls]) => `
        <button class="character-card ${cls}" data-group="${group}" onclick="selectCharacter('${type}')">
          <img src="${charImages[type]}" alt="${type}キャラクター" />
          <span class="type"><strong>${type}</strong><small>${nick}</small></span>
        </button>
      `).join('');
    }

    function selectCharacter(type) {
      state.character = type;
      toast(`${type}：${charNick[type]} を選択！`);
      syncHud();
      setTimeout(() => go('stage'), 180);
    }

    function selectStage(stageNo) {
      state.stage = stageNo;
      state.lastChoice = null;
      state.lastAnswer = null;
      renderMission();
      go('mission');
    }

    function renderMission() {
      const s = stages[state.stage];
      $('mission-heading').textContent = s.title;
      $('mission-sub').textContent = s.sub;
      $('mission-kicker').textContent = s.kicker;
      $('scenario').textContent = s.scenario;
      $('npc-img').src = s.npcImg;
      $('npc-name').textContent = s.npc;
      $('npc-tag').textContent = s.npcTag;
      $('choices').innerHTML = s.choices.map(c => `
        <button class="choice" onclick="selectAnswer('${c.id}')">
          <span class="letter">${c.id}</span>
          <span class="text">${c.text}</span>
          <span class="risk">${c.risk}</span>
        </button>
      `).join('');
    }

    function selectAnswer(id) {
      const s = stages[state.stage];
      const answer = s.choices.find(c => c.id === id);
      state.lastAnswer = answer;
      state.lastChoice = id;
      applyScore(answer.score);
      renderFeedback(answer);
      go('feedback');
      if (answer.grade === 'S') burst();
    }

    function applyScore(delta) {
      state.score = Math.max(0, state.score + Math.max(0, Math.round(delta / 2)));
      state.trust = clamp(state.trust + delta, 0, 100);
      state.combo = delta > 10 ? state.combo + 1 : 0;
    }

    function renderFeedback(answer) {
      const card = $('result-card');
      card.className = 'result-card ' + (answer.score >= 20 ? 'good' : answer.score <= 0 ? 'bad' : 'okay');
      $('grade').textContent = answer.grade;
      $('feedback-heading').textContent = answer.title;
      $('feedback-message').textContent = answer.message;
      $('npc-quote').textContent = `${stages[state.stage].npc}「${answer.quote.replace(/[「」]/g, '')}」`;
      $('coach-bubble').textContent = answer.score >= 20
        ? 'いい選択！相手が判断しやすい順番で伝えられています。'
        : answer.score <= 0
          ? '惜しい！相手の不安や負担が増えるポイントを減らそう。'
          : '悪くない！あと一歩、具体性を足すともっと強いです。';
      $('actions').innerHTML = stages[state.stage].actions.map(a => `
        <button class="choice" onclick="selectAction('${a.id}')">
          <span class="letter">${a.id}</span>
          <span class="text">${a.text}</span>
          <span class="risk">${a.risk}</span>
        </button>
      `).join('');
      syncHud();
    }

    function selectAction(id) {
      const action = stages[state.stage].actions.find(a => a.id === id);
      applyScore(action.score);
      toast(action.feedback);
      if (action.score > 10) burst();
      setTimeout(() => {
        renderLesson(action);
        go('lesson');
      }, 460);
    }

    function renderLesson(action) {
      const s = stages[state.stage];
      $('lesson-sub').textContent = `${s.title}｜${s.npcTag}を攻略しました。${action.feedback}`;
      $('lesson-grid').innerHTML = s.lessons.map(([title, body], idx) => `
        <article class="lesson-card ${idx === 0 ? 'open' : ''}" onclick="this.classList.toggle('open')">
          <div class="lesson-head">
            <h3>${idx + 1}. ${title}</h3>
            <span class="toggle">▼</span>
          </div>
          <div class="lesson-body"><div><p>${body}</p></div></div>
        </article>
      `).join('');
      syncHud();
    }

    function openGuide() {
      $('guide-modal').classList.add('active');
    }

    function closeGuide(event) {
      if (event && event.target !== $('guide-modal')) return;
      $('guide-modal').classList.remove('active');
    }

    function toast(message) {
      const el = $('toast');
      el.textContent = message;
      el.classList.add('show');
      clearTimeout(window.__toastTimer);
      window.__toastTimer = setTimeout(() => el.classList.remove('show'), 1800);
    }

    function burst() {
      const box = $('confetti');
      box.innerHTML = '';
      const colors = ['#facc15', '#38bdf8', '#ec4899', '#22c55e', '#fb923c', '#a855f7'];
      for (let i = 0; i < 34; i++) {
        const piece = document.createElement('i');
        piece.style.left = `${Math.random() * 100}%`;
        piece.style.background = colors[i % colors.length];
        piece.style.animationDelay = `${Math.random() * 240}ms`;
        piece.style.animationDuration = `${700 + Math.random() * 650}ms`;
        box.appendChild(piece);
      }
      setTimeout(() => box.innerHTML = '', 1500);
    }

    function resetGame() {
      state.stage = 1;
      state.trust = 35;
      state.score = 0;
      state.combo = 0;
      state.lastChoice = null;
      state.lastAnswer = null;
      syncHud();
      go('title');
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeGuide();
    });

    initCharacters();
    syncHud();
  </script>
</body>
</html>
</file>

