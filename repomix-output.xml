/* ステージ選択：絶対配置をやめ、重ならないカードマップに変更 */
.stage-map {
  min-height: auto;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  grid-template-areas:
    "s2 hero s4"
    "s1 hero s5"
    ".  s3  .";
  gap: clamp(14px, 2.4vw, 24px);
  padding: clamp(20px, 3vw, 34px);
  background:
    linear-gradient(#fff6d8 0 0) 8% 12% / 64px 20px no-repeat,
    linear-gradient(#fff6d8 0 0) 72% 16% / 92px 24px no-repeat,
    repeating-linear-gradient(90deg, rgba(255,246,216,.16) 0 3px, transparent 3px 24px),
    repeating-linear-gradient(0deg, rgba(255,246,216,.16) 0 3px, transparent 3px 24px),
    #0f7f74;
  overflow: visible;
}
.stage-map::before {
  content: "";
  position: absolute;
  inset: 22px;
  pointer-events: none;
  opacity: .55;
  background-image: radial-gradient(circle, #fff6d8 0 3px, transparent 4px);
  background-size: 28px 28px;
}
.stage-map::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 82px;
  z-index: 0;
  background:
    repeating-linear-gradient(90deg, rgba(0,0,0,.18) 0 4px, transparent 4px 24px),
    linear-gradient(to bottom, #21c679 0 44%, #7b421e 44% 100%);
  border-top: 5px solid #071024;
}
.chosen-hero,
.stage-node {
  position: relative !important;
  inset: auto !important;
  transform: none !important;
  z-index: 2;
}
.chosen-hero {
  grid-area: hero;
  align-self: center;
  min-height: 310px;
  padding: 20px;
  border: 5px solid #fff6d8;
  background: rgba(7,16,36,.78);
  box-shadow: 6px 6px 0 #071024;
}
.chosen-hero img {
  width: clamp(120px, 16vw, 180px);
  height: clamp(120px, 16vw, 180px);
}
.chosen-label {
  margin-top: 12px;
  max-width: 100%;
  white-space: normal;
  justify-content: center;
  text-align: center;
  line-height: 1.35;
}
.stage-node {
  width: 100% !important;
  min-height: 190px;
  display: grid;
  grid-template-rows: 1fr auto;
  justify-items: center;
  align-items: end;
  gap: 10px;
  padding: 14px 12px;
  background: rgba(255,246,216,.92);
  border: 5px solid #071024;
  box-shadow: 5px 5px 0 #071024;
}
.stage-node img {
  width: clamp(86px, 12vw, 132px);
  height: clamp(86px, 12vw, 132px);
  object-fit: contain;
  align-self: center;
}
.stage-1 { grid-area: s1; }
.stage-2 { grid-area: s2; }
.stage-3 { grid-area: s3; }
.stage-4 { grid-area: s4; }
.stage-5 { grid-area: s5; }
.node-label,
.chosen-label {
  width: 100%;
  background: #071024;
  color: #fff6d8;
  border: 3px solid #fff6d8;
  text-shadow: 2px 2px 0 #000;
  box-shadow: 3px 3px 0 #071024;
}
.node-label {
  font-size: clamp(14px, 1.8vw, 17px);
  white-space: normal;
  text-align: center;
  line-height: 1.35;
}
.node-label small,
.chosen-label span + span { color: #f5c542; }

.hud-card {
  background: #071024;
  color: #fff6d8;
  text-shadow: 2px 2px 0 #000;
  border-color: #fff6d8;
}
.meter {
  height: 24px;
  background: repeating-linear-gradient(90deg, #1f2b3d 0 14px, #071024 14px 18px);
  border-color: #fff6d8;
}
.meter-fill {
  background: repeating-linear-gradient(90deg, #f5c542 0 16px, #d86d32 16px 20px);
  transition: width .35s steps(8, end);
}

.mission-layout,
.feedback-grid { align-items: stretch; }
.mission-card,
.npc-panel,
.result-card,
.coach-panel { background-color: #fff6d8; }

.mission-card {
  padding: clamp(20px, 3.2vw, 34px);
}
.scenario {
  font-size: clamp(16px, 2.2vw, 19px);
  line-height: 2.05;
  letter-spacing: .02em;
  max-width: 820px;
}
.choice-title {
  color: #e74d80;
  font-size: clamp(24px, 3.4vw, 36px);
  text-shadow: 2px 2px 0 #fff6d8;
  margin-top: 28px;
}

.npc-name,
.npc-tag,
.risk {
  background: #071024;
  color: #fff6d8;
  border-color: #fff6d8;
  text-shadow: 2px 2px 0 #000;
}
.npc-panel img,
.coach-panel img {
  max-width: 210px;
  height: 210px;
}

.choice {
  background: #fffdf1;
  border-width: 4px;
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: center;
  padding: 16px 18px;
  gap: 16px;
}
.choice span.text {
  font-size: clamp(15px, 2vw, 17px);
  line-height: 1.75;
  font-weight: 800;
}
.choice:nth-child(1) .letter { background: #b82e2e; color: #fff6d8; text-shadow: 2px 2px 0 #071024; }
.choice:nth-child(2) .letter { background: #2395cc; color: #fff6d8; text-shadow: 2px 2px 0 #071024; }
.choice:nth-child(3) .letter { background: #4caf50; color: #fff6d8; text-shadow: 2px 2px 0 #071024; }

.result-card.good { background: #d8efc8; }
.result-card.okay { background: #fff6d8; }
.result-card.bad { background: #ffd0c8; }
.grade {
  transform: none;
  width: 72px;
  height: 72px;
  border-width: 5px;
}

.lesson-card {
  background: #fff6d8;
  border-width: 4px;
}
.lesson-card:nth-child(1) { background: #f3dda2; }
.lesson-card:nth-child(2) { background: #c9e8ff; }
.lesson-card:nth-child(3) { background: #d8efc8; }
.lesson-card:nth-child(4) { background: #ffd0df; }

.modal-backdrop { background: rgba(7,16,36,.72); }
.toast {
  background: #071024;
  color: #fff6d8;
  border-color: #fff6d8;
  text-shadow: 2px 2px 0 #000;
}
.confetti i {
  border-radius: 0;
  width: 14px;
  height: 14px;
  animation: bitFall 700ms steps(6, end) forwards;
}
@keyframes bitFall {
  to { transform: translateY(110vh) rotate(180deg); opacity: .15; }
}

::selection { background: #f5c542; color: #071024; }

@media (max-width: 920px) {
  .hero-grid {
    grid-template-columns: 1fr;
  }
  .title {
    font-size: clamp(42px, 12vw, 76px);
  }
  .stage-map {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-areas:
      "hero hero"
      "s1 s2"
      "s3 s4"
      "s5 s5";
  }
  .chosen-hero {
    min-height: 260px;
  }
}

@media (max-width: 680px) {
  .stage-map {
    grid-template-columns: 1fr;
    grid-template-areas:
      "hero"
      "s1"
      "s2"
      "s3"
      "s4"
      "s5";
  }
  .stage-node {
    min-height: 118px;
    grid-template-columns: 86px 1fr;
    grid-template-rows: auto;
    justify-items: start;
    align-items: center;
  }
  .stage-node img {
    width: 74px;
    height: 74px;
  }
  .node-label { text-align: left; }
  .chosen-hero { min-height: 220px; }
  .choice {
    grid-template-columns: auto 1fr;
  }
  .choice .risk {
    grid-column: 2;
    justify-self: start;
  }
}

@media (max-width: 560px) {
  :root { --shadow: 5px 5px 0 #071024; --shadow-sm: 3px 3px 0 #071024; }
  .window,
  .mission-card,
  .stage-map,
  .result-card,
  .coach-panel,
  .npc-panel,
  .modal {
    border-width: 4px;
    box-shadow: 5px 5px 0 #071024;
  }
  .title {
    font-size: clamp(38px, 14vw, 62px);
    text-shadow:
      2px 0 0 #071024,
      -2px 0 0 #071024,
      0 2px 0 #071024,
      0 -2px 0 #071024,
      4px 4px 0 #b82e2e;
  }
  .lead,
  .scenario,
  .choice span.text {
    font-size: 15px;
    line-height: 1.85;
  }
  .choice-title { font-size: 25px; }
  .choice,
  .btn,
  .back-btn { border-width: 3px; }
}

/* ── MBTI Badge & Picker ── */
.mbti-bar {
  display: flex;
  justify-content: center;
  padding: 6px 0 10px;
}
.mbti-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 6px 14px;
  border: 2px solid var(--line);
  border-radius: 999px;
  background: var(--paper);
  cursor: pointer;
  transition: background 0.2s;
  box-shadow: var(--shadow-sm);
}
.mbti-badge:hover {
  background: var(--paper-2);
}
.mbti-badge-img {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  border: 1.5px solid var(--line);
}
.mbti-badge-type {
  font-weight: 700;
  font-size: 14px;
}
.mbti-badge-nick {
  font-size: 12px;
  color: var(--muted);
}
.mbti-change-link {
  font-size: 11px;
  color: var(--blue);
  text-decoration: underline;
  margin-left: 4px;
}

.mbti-picker-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  padding: 16px;
}
.mbti-picker {
  background: var(--paper);
  border: 3px solid var(--line);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 24px;
  max-width: 600px;
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
}
.mbti-picker h3 {
  text-align: center;
  margin: 0 0 16px;
  font-size: 18px;
}
.mbti-picker-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8px;
}
.mbti-picker-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  padding: 8px 4px;
  border: 2px solid var(--line);
  border-radius: 14px;
  background: var(--paper);
  cursor: pointer;
  transition: all 0.15s;
  box-shadow: 2px 2px 0 var(--line);
}
.mbti-picker-card:hover {
  transform: translateY(-2px);
}
.mbti-picker-card.selected {
  background: var(--yellow);
  border-color: var(--pink);
}
.mbti-picker-card img {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: 1.5px solid var(--line);
}
.mbti-picker-card strong {
  font-size: 12px;
}
.mbti-picker-card small {
  font-size: 9px;
  color: var(--muted);
}

.stage-nodes {
  display: contents;
}

@media (max-width: 640px) {
  .mbti-picker-grid {
    grid-template-columns: repeat(4, 1fr);
    gap: 6px;
  }
  .mbti-picker-card {
    padding: 6px 2px;
  }
  .mbti-picker-card img {
    width: 28px;
    height: 28px;
  }
}
