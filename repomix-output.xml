// ── Render MBTI Grid ──
(function renderMBTI() {
  const grid = document.getElementById('mbti-grid');
  const groups = ['Analyst','Sentinel','Diplomat','Explorer'];
  const groupLabels = { Analyst:'Analyst — 分析家', Sentinel:'Sentinel — 管理者', Diplomat:'Diplomat — 外交官', Explorer:'Explorer — 探検家' };
  let html = '';
  groups.forEach(g => {
    html += `<div class="mbti-group-title">${groupLabels[g]}</div>`;
    characters.filter(c => c[2] === g).forEach(c => {
      html += `<div class="mbti-card" data-type="${c[0]}">
        <div class="mbti-type">${c[0]}</div>
        <div class="mbti-nick">${c[1]}</div>
        <div class="mbti-group group-${g.toLowerCase()}">${g}</div>
      </div>`;
    });
  });
  grid.innerHTML = html;
})();

// ── Render Score Matrix ──
(function renderMatrix() {
  const el = document.getElementById('score-matrix');
  let html = '<table class="matrix-table"><thead><tr>';
  html += '<th>ステージ</th><th>相手</th><th>切り出し</th><th>スコア</th><th>グレード</th><th>振る舞い</th><th>スコア</th><th>合計</th>';
  html += '</tr></thead><tbody>';
  for (let i = 1; i <= 5; i++) {
    const s = stages[i];
    s.choices.forEach((c, ci) => {
      const a = s.actions[ci];
      const total = c.score + a.score;
      const cls = c.grade === 'S' ? 'score-high' : c.grade === 'B' ? 'score-mid' : 'score-low';
      const acls = a.score >= 15 ? 'score-high' : a.score >= 3 ? 'score-mid' : 'score-low';
      const tcls = total >= 40 ? 'score-high' : total >= 10 ? 'score-mid' : 'score-low';
      if (ci === 0) {
        html += `<tr><td rowspan="3" style="font-weight:800">${s.title}<br><span style="font-size:11px;color:var(--text-muted)">${s.kicker}</span></td>`;
        html += `<td rowspan="3" style="font-weight:700">${s.npc}<br><span style="font-size:11px;color:var(--text-muted)">${s.npcTag}</span></td>`;
      }
      html += `<td>${c.id}. ${c.title}</td>`;
      html += `<td><span class="score-badge ${cls}">${c.score > 0 ? '+' : ''}${c.score}</span></td>`;
      html += `<td><span class="score-badge grade-${c.grade}" style="width:28px;height:28px;font-size:11px">${c.grade}</span></td>`;
      html += `<td style="font-size:12px">${a.text.substring(0, 30)}…</td>`;
      html += `<td><span class="score-badge ${acls}">${a.score > 0 ? '+' : ''}${a.score}</span></td>`;
      html += `<td><span class="score-badge ${tcls}">${total > 0 ? '+' : ''}${total}</span></td>`;
      html += '</tr>';
    });
  }
  html += '</tbody></table>';
  el.innerHTML = html;
})();

// ── Render Detail Cards ──
(function renderDetails() {
  const tabsEl = document.getElementById('stage-tabs');
  const detailsEl = document.getElementById('stage-details');
  let tabsHtml = '';
  let detailsHtml = '';
  const icons = ['⚠️','🤝','🌱','🧑‍💼','🌀'];

  for (let i = 1; i <= 5; i++) {
    const s = stages[i];
    tabsHtml += `<button class="stage-tab${i===1?' active':''}" data-stage="${i}">${icons[i-1]} ${s.title.replace('ステージ','S')}</button>`;

    detailsHtml += `<div class="stage-detail${i===1?' active':''}" id="detail-${i}">`;

    // Left: scenario + choices + actions
    detailsHtml += `<div class="scenario-card">`;
    detailsHtml += `<div class="scenario-label">${s.kicker}</div>`;
    detailsHtml += `<h2 style="font-size:20px;font-weight:900;margin-bottom:6px">${s.title}</h2>`;
    detailsHtml += `<p style="color:var(--text-muted);font-size:13px;font-weight:600;margin-bottom:16px">${s.sub}</p>`;
    detailsHtml += `<p class="scenario-text">${s.scenario}</p>`;

    // Choices
    detailsHtml += `<div class="choices-section"><div class="choices-title">💬 どう切り出す？（選択肢）</div><div class="choice-list">`;
    s.choices.forEach(c => {
      const cls = c.grade === 'S' ? 'correct' : c.grade === 'C' ? 'wrong' : 'neutral';
      detailsHtml += `<div class="choice-card ${cls}" onclick="this.classList.toggle('expanded')">
        <div class="choice-letter">${c.id}</div>
        <div class="choice-content">
          <div class="choice-label">${c.title}</div>
          <div class="choice-text">${c.text}</div>
        </div>
        <div class="choice-meta">
          <span class="choice-grade grade-${c.grade}">${c.grade}</span>
          <span class="choice-score">${c.score > 0 ? '+' : ''}${c.score}pt</span>
          <span class="choice-risk risk-${c.risk === '安全' ? 'safe' : c.risk === '危険' ? 'danger' : 'hold'}">${c.risk}</span>
        </div>
        <div class="choice-feedback">
          ${c.message}
          <div class="feedback-quote">${s.npc}「${c.quote}」</div>
        </div>
      </div>`;
    });
    detailsHtml += `</div></div>`;

    // Actions
    detailsHtml += `<div class="choices-section"><div class="choices-title">🎮 どう振る舞う？（行動選択）</div><div class="actions-grid">`;
    s.actions.forEach(a => {
      const cls = a.score >= 15 ? 'correct' : a.score <= 0 ? 'wrong' : 'neutral';
      const lcls = a.score >= 15 ? 'correct' : a.score <= 0 ? 'wrong' : 'neutral';
      detailsHtml += `<div class="action-card" onclick="this.classList.toggle('expanded')">
        <div class="choice-letter">${a.id}</div>
        <div class="action-text">${a.text}</div>
        <div style="text-align:right">
          <span class="choice-risk risk-${a.risk === '安全' ? 'safe' : a.risk === '危険' ? 'danger' : 'hold'}">${a.risk}</span>
          <div class="action-score" style="margin-top:4px">${a.score > 0 ? '+' : ''}${a.score}pt</div>
        </div>
        <div class="action-feedback">${a.feedback}</div>
      </div>`;
    });
    detailsHtml += `</div></div>`;

    // Lessons
    detailsHtml += `<div class="lessons-grid">`;
    s.lessons.forEach((l, li) => {
      detailsHtml += `<div class="lesson-card" onclick="this.classList.toggle('open')">
        <div class="lesson-head">
          <div class="lesson-title">${li + 1}. ${l[0]}</div>
          <div class="lesson-toggle">▼</div>
        </div>
        <div class="lesson-body"><div><p class="lesson-text">${l[1]}</p></div></div>
      </div>`;
    });
    detailsHtml += `</div>`;

    detailsHtml += `</div>`; // end scenario-card

    // Right: NPC card
    detailsHtml += `<div class="npc-card">
      <div style="width:120px;height:120px;border-radius:50%;background:var(--bg-surface);display:grid;place-items:center;margin:0 auto;font-size:48px">${icons[i-1]}</div>
      <div class="npc-name">${s.npc}</div>
      <div class="npc-tag">${s.npcTag}</div>
      <div style="margin-top:16px;text-align:left;font-size:12px;color:var(--text-muted);font-weight:600">
        <div style="margin-bottom:4px;font-weight:800;color:var(--text-primary)">ステージ情報</div>
        <div>選択肢: 3択 × 2段階</div>
        <div>最大スコア: +${s.choices[0].score + s.actions[0].score}pt</div>
        <div>レッスン: ${s.lessons.length}枚</div>
      </div>
    </div>`;

    detailsHtml += `</div>`; // end stage-detail
  }

  tabsEl.innerHTML = tabsHtml;
  detailsEl.innerHTML = detailsHtml;

  // Tab switching
  tabsEl.addEventListener('click', e => {
    const btn = e.target.closest('.stage-tab');
    if (!btn) return;
    const stage = btn.dataset.stage;
    tabsEl.querySelectorAll('.stage-tab').forEach(t => t.classList.remove('active'));
    btn.classList.add('active');
    detailsEl.querySelectorAll('.stage-detail').forEach(d => d.classList.remove('active'));
    document.getElementById('detail-' + stage).classList.add('active');
  });
})();

// ── View Switching ──
function switchView(view) {
  document.querySelectorAll('.toolbar-btn').forEach(b => b.classList.remove('active'));
  event.target.classList.add('active');
  document.getElementById('view-flow').style.display = view === 'flow' ? '' : 'none';
  document.getElementById('view-matrix').style.display = view === 'matrix' ? '' : 'none';
  document.getElementById('view-detail').style.display = view === 'detail' ? '' : 'none';
  document.getElementById('view-csv').style.display = view === 'csv' ? '' : 'none';
}

