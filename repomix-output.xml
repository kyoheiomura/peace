<file path="app/globals.css">
:root {
  --ink: #182235;
  --muted: #64748b;
  --paper: #fffdf7;
  --paper-2: #fff7d8;
  --line: #172033;
  --pink: #ec4899;
  --pink-2: #f9a8d4;
  --blue: #38bdf8;
  --green: #22c55e;
  --yellow: #facc15;
  --orange: #fb923c;
  --purple: #a855f7;
  --danger: #ef4444;
  --ok: #10b981;
  --shadow: 7px 7px 0 var(--line);
  --shadow-sm: 4px 4px 0 var(--line);
  --radius: 22px;
  --font: 'M PLUS Rounded 1c', 'Hiragino Maru Gothic ProN', sans-serif;
  --safe-x: clamp(14px, 4vw, 32px);
  --max: 1040px;
}

* { box-sizing: border-box; }
html { min-height: 100%; }
body {
  margin: 0;
  min-height: 100vh;
  color: var(--ink);
  font-family: var(--font);
  background:
    radial-gradient(circle at 16% 12%, rgba(255,255,255,.9) 0 5%, transparent 5.2%),
    radial-gradient(circle at 84% 18%, rgba(255,255,255,.72) 0 7%, transparent 7.2%),
    radial-gradient(circle at 72% 78%, rgba(255,255,255,.45) 0 9%, transparent 9.2%),
    linear-gradient(135deg, #c084fc 0%, #60a5fa 47%, #facc15 100%);
  overflow-x: hidden;
}

body::before {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  opacity: .18;
  background-image:
    linear-gradient(rgba(255,255,255,.45) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.45) 1px, transparent 1px);
  background-size: 24px 24px;
  mask-image: linear-gradient(to bottom, #000, transparent 90%);
}

button, [role="button"] { font-family: inherit; }
button { color: inherit; }

.app {
  position: relative;
  z-index: 1;
  width: min(100%, var(--max));
  min-height: 100vh;
  margin: 0 auto;
  padding: clamp(14px, 3vw, 28px) var(--safe-x) clamp(24px, 5vw, 56px);
  display: grid;
  place-items: center;
}

.bg-chip {
  position: fixed;
  z-index: 0;
  pointer-events: none;
  filter: drop-shadow(4px 4px 0 rgba(24,34,53,.18));
  animation: floaty 5s ease-in-out infinite;
  opacity: .88;
}
.chip-1 { left: 5vw; top: 9vh; font-size: clamp(34px, 7vw, 78px); }
.chip-2 { right: 7vw; top: 11vh; font-size: clamp(40px, 8vw, 90px); animation-delay: .4s; }
.chip-3 { left: 8vw; bottom: 12vh; font-size: clamp(28px, 5vw, 54px); animation-delay: .9s; }
.chip-4 { right: 12vw; bottom: 10vh; font-size: clamp(30px, 6vw, 68px); animation-delay: 1.2s; }

@keyframes floaty {
  0%, 100% { transform: translateY(0) rotate(-3deg); }
  50% { transform: translateY(-14px) rotate(4deg); }
}

.screen {
  display: none;
  width: 100%;
  animation: screenIn .28s cubic-bezier(.2,.9,.2,1);
}
.screen.active { display: block; }

@keyframes screenIn {
  from { opacity: 0; transform: translateY(16px) scale(.985); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

.window {
  width: 100%;
  background: var(--paper);
  border: 4px solid var(--line);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  overflow: hidden;
}

.window-bar {
  min-height: 46px;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 16px;
  background: #f8fafc;
  border-bottom: 4px solid var(--line);
}
.dot {
  width: 20px;
  height: 20px;
  border: 3px solid var(--line);
  border-radius: 999px;
  display: grid;
  place-items: center;
  font-weight: 900;
  font-size: 10px;
}
.dot.red { background: #fecaca; }
.dot.yellow { background: #fef08a; }
.dot.green { background: #bbf7d0; }
.bar-title {
  margin-left: auto;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: .08em;
  color: var(--muted);
}

.window-body { padding: clamp(18px, 4vw, 42px); }

.hero-grid {
  display: grid;
  grid-template-columns: 1.05fr .95fr;
  gap: clamp(20px, 5vw, 52px);
  align-items: center;
}

.kicker {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 13px;
  border: 3px solid var(--line);
  border-radius: 999px;
  background: #eff6ff;
  box-shadow: var(--shadow-sm);
  font-size: clamp(12px, 2vw, 14px);
  font-weight: 900;
  letter-spacing: .08em;
  margin-bottom: 14px;
}

h1, h2, h3, p { margin: 0; }
.title {
  font-size: clamp(42px, 10vw, 92px);
  line-height: .9;
  font-weight: 900;
  letter-spacing: -.05em;
  text-shadow: 5px 5px 0 rgba(255,255,255,.6);
}
.title small {
  display: block;
  margin-top: 10px;
  font-size: clamp(16px, 4vw, 28px);
  letter-spacing: .08em;
}
.lead {
  margin-top: 18px;
  font-size: clamp(15px, 2.8vw, 20px);
  line-height: 1.85;
  font-weight: 700;
  color: #334155;
}

.hero-card {
  position: relative;
  min-height: 330px;
  border: 4px solid var(--line);
  border-radius: 30px;
  background:
    radial-gradient(circle at 30% 22%, #fff 0 12%, transparent 12.5%),
    linear-gradient(160deg, #fff7ed, #dbeafe 58%, #fce7f3);
  box-shadow: var(--shadow);
  padding: 24px;
  overflow: hidden;
}
.hero-card::after {
  content: "";
  position: absolute;
  inset: auto -24px -34px -24px;
  height: 112px;
  background: linear-gradient(to bottom, #22c55e 0 42%, #92400e 42% 100%);
  border-top: 4px solid var(--line);
}
.main-mascot {
  position: absolute;
  left: 50%;
  bottom: 44px;
  transform: translateX(-50%);
  width: min(58%, 260px);
  aspect-ratio: 1;
  display: grid;
  place-items: center;
  animation: hop 2.6s ease-in-out infinite;
  z-index: 1;
}
.main-mascot img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  filter: drop-shadow(7px 9px 0 rgba(24,34,53,.22));
}
.speech {
  position: absolute;
  top: 22px;
  right: 18px;
  max-width: 220px;
  padding: 12px 14px;
  border: 3px solid var(--line);
  border-radius: 20px;
  background: white;
  box-shadow: var(--shadow-sm);
  font-weight: 900;
  line-height: 1.5;
  z-index: 2;
}
.speech::after {
  content: "";
  position: absolute;
  bottom: -13px;
  left: 42px;
  border-width: 12px 9px 0;
  border-style: solid;
  border-color: var(--line) transparent transparent;
}
.speech::before {
  content: "";
  position: absolute;
  bottom: -8px;
  left: 45px;
  z-index: 1;
  border-width: 9px 7px 0;
  border-style: solid;
  border-color: white transparent transparent;
}
.mini-stat {
  position: absolute;
  left: 18px;
  top: 22px;
  display: grid;
  gap: 8px;
  z-index: 2;
}
.mini-pill {
  width: fit-content;
  padding: 7px 10px;
  border: 3px solid var(--line);
  border-radius: 999px;
  background: #fef08a;
  box-shadow: 3px 3px 0 var(--line);
  font-size: 12px;
  font-weight: 900;
}

@keyframes hop {
  0%, 100% { transform: translateX(-50%) translateY(0) rotate(-2deg); }
  50% { transform: translateX(-50%) translateY(-12px) rotate(2deg); }
}

.actions {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 28px;
}
.btn {
  border: 4px solid var(--line);
  border-radius: 18px;
  padding: 14px 22px;
  min-height: 56px;
  background: white;
  box-shadow: var(--shadow-sm);
  font-size: clamp(15px, 2.5vw, 20px);
  font-weight: 900;
  cursor: pointer;
  transition: transform .12s ease, box-shadow .12s ease, background .12s ease;
}
.btn:hover { transform: translate(-3px,-3px); box-shadow: 7px 7px 0 var(--line); }
.btn:active { transform: translate(2px,2px); box-shadow: 2px 2px 0 var(--line); }
.btn.primary { background: var(--yellow); }
.btn.pink { background: #fbcfe8; }
.btn.blue { background: #bfdbfe; }
.btn.full { width: 100%; justify-content: center; }

.topbar {
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: 12px;
  align-items: center;
  margin-bottom: 18px;
}
.back-btn {
  width: 48px;
  height: 48px;
  border: 4px solid var(--line);
  border-radius: 16px;
  background: white;
  box-shadow: var(--shadow-sm);
  font-size: 22px;
  font-weight: 900;
  cursor: pointer;
}
.screen-title {
  text-align: center;
  font-size: clamp(22px, 4vw, 38px);
  font-weight: 900;
  line-height: 1.25;
}
.subnote {
  text-align: center;
  margin: 6px auto 0;
  max-width: 680px;
  color: #475569;
  font-size: clamp(13px, 2.3vw, 16px);
  line-height: 1.7;
  font-weight: 700;
}

.character-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: clamp(10px, 2.2vw, 18px);
  margin-top: 24px;
}
.character-card {
  position: relative;
  border: 4px solid var(--line);
  border-radius: 24px;
  background: #fff;
  box-shadow: var(--shadow-sm);
  cursor: pointer;
  min-height: 154px;
  padding: 8px;
  overflow: hidden;
  transition: transform .16s ease, box-shadow .16s ease;
}
.character-card:hover { transform: translate(-4px,-4px) rotate(-1deg); box-shadow: 8px 8px 0 var(--line); }
.character-card::before {
  content: attr(data-group);
  position: absolute;
  left: 8px;
  top: 8px;
  z-index: 2;
  padding: 4px 8px;
  border: 2px solid var(--line);
  border-radius: 999px;
  background: rgba(255,255,255,.86);
  font-size: 10px;
  font-weight: 900;
}
.character-card img {
  width: 100%;
  height: 106px;
  object-fit: contain;
  display: block;
  filter: drop-shadow(3px 5px 0 rgba(24,34,53,.18));
}
.character-card .type {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 4px;
  padding: 7px 9px;
  border: 3px solid var(--line);
  border-radius: 14px;
  background: #f8fafc;
  font-weight: 900;
  font-size: 13px;
}
.group-analyst { background: linear-gradient(145deg, #f3e8ff, #fff); }
.group-diplomat { background: linear-gradient(145deg, #dcfce7, #fff); }
.group-sentinel { background: linear-gradient(145deg, #dbeafe, #fff); }
.group-explorer { background: linear-gradient(145deg, #ffedd5, #fff); }

.stage-map {
  position: relative;
  min-height: 620px;
  margin-top: 18px;
  border: 4px solid var(--line);
  border-radius: 34px;
  background:
    radial-gradient(circle at 50% 44%, rgba(255,255,255,.92) 0 21%, transparent 21.5%),
    radial-gradient(circle at 18% 70%, rgba(254,240,138,.72) 0 14%, transparent 14.3%),
    radial-gradient(circle at 82% 68%, rgba(191,219,254,.72) 0 15%, transparent 15.3%),
    linear-gradient(160deg, #ecfeff, #fef3c7 62%, #dcfce7);
  box-shadow: var(--shadow);
  overflow: hidden;
  padding: 28px;
}
.stage-map::after {
  content: "";
  position: absolute;
  left: -24px;
  right: -24px;
  bottom: -12px;
  height: 102px;
  background: linear-gradient(to bottom, #22c55e 0 38%, #92400e 38% 100%);
  border-top: 4px solid var(--line);
}
.chosen-hero {
  position: absolute;
  left: 50%;
  top: 48%;
  transform: translate(-50%, -50%);
  display: grid;
  place-items: center;
  text-align: center;
  z-index: 4;
  animation: floaty 3.8s ease-in-out infinite;
}
.chosen-hero img {
  width: clamp(116px, 20vw, 190px);
  height: clamp(116px, 20vw, 190px);
  object-fit: contain;
  filter: drop-shadow(6px 8px 0 rgba(24,34,53,.2));
}
.chosen-label {
  margin-top: -8px;
  display: inline-flex;
  gap: 8px;
  align-items: center;
  padding: 8px 14px;
  border: 4px solid var(--line);
  border-radius: 999px;
  background: white;
  box-shadow: var(--shadow-sm);
  font-weight: 900;
}
.stage-node {
  position: absolute;
  z-index: 5;
  width: min(210px, 28vw);
  border: 0;
  background: transparent;
  cursor: pointer;
  display: grid;
  justify-items: center;
  gap: 8px;
  transition: transform .16s ease;
}
.stage-node:hover { transform: translateY(-6px) rotate(-1deg); }
.stage-node img {
  width: clamp(84px, 14vw, 150px);
  height: clamp(84px, 14vw, 150px);
  object-fit: contain;
  filter: drop-shadow(4px 6px 0 rgba(24,34,53,.2));
}
.node-label {
  position: relative;
  padding: 10px 13px;
  border: 4px solid var(--line);
  border-radius: 18px;
  background: white;
  box-shadow: var(--shadow-sm);
  font-size: clamp(13px, 2vw, 17px);
  line-height: 1.25;
  font-weight: 900;
  white-space: nowrap;
}
.node-label small {
  display: block;
  color: var(--muted);
  font-size: 11px;
  letter-spacing: .06em;
  margin-top: 3px;
}
.stage-1 { left: 4%; bottom: 116px; }
.stage-2 { left: 4%; top: 26%; }
.stage-3 { left: 50%; bottom: 58px; transform: translateX(-50%); }
.stage-3:hover { transform: translateX(-50%) translateY(-6px) rotate(-1deg); }
.stage-4 { right: 4%; top: 25%; }
.stage-5 { right: 4%; bottom: 116px; }

.hud {
  display: grid;
  grid-template-columns: 1fr auto auto;
  gap: 12px;
  align-items: center;
  margin-bottom: 16px;
}
.hud-card {
  border: 4px solid var(--line);
  border-radius: 20px;
  background: white;
  box-shadow: var(--shadow-sm);
  padding: 10px 14px;
  font-weight: 900;
}
.trust {
  display: grid;
  gap: 6px;
}
.trust-head { display: flex; justify-content: space-between; gap: 12px; font-size: 13px; }
.meter {
  height: 22px;
  border: 3px solid var(--line);
  border-radius: 999px;
  background: #cbd5e1;
  overflow: hidden;
}
.meter-fill {
  height: 100%;
  width: 35%;
  background: linear-gradient(90deg, var(--yellow), var(--orange));
  transition: width .5s cubic-bezier(.2,.9,.2,1);
}

.mission-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 260px;
  gap: clamp(16px, 3vw, 30px);
  align-items: start;
}
.mission-card {
  border: 4px solid var(--line);
  border-radius: 26px;
  background: var(--paper);
  box-shadow: var(--shadow);
  padding: clamp(18px, 3vw, 30px);
}
.mission-kicker {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 12px;
  padding: 7px 12px;
  border: 3px solid var(--line);
  border-radius: 999px;
  background: #fce7f3;
  box-shadow: 3px 3px 0 var(--line);
  font-weight: 900;
  font-size: 13px;
}
.scenario {
  font-size: clamp(15px, 2.4vw, 19px);
  line-height: 1.95;
  font-weight: 700;
  color: #243244;
}
.npc-panel {
  position: sticky;
  top: 16px;
  border: 4px solid var(--line);
  border-radius: 26px;
  background: #fff;
  box-shadow: var(--shadow);
  padding: 16px;
  text-align: center;
}
.npc-panel img {
  width: 100%;
  max-width: 190px;
  height: 190px;
  object-fit: contain;
  filter: drop-shadow(5px 7px 0 rgba(24,34,53,.18));
}
.npc-name {
  margin-top: 8px;
  border: 3px solid var(--line);
  border-radius: 999px;
  background: #f8fafc;
  padding: 8px 10px;
  font-weight: 900;
}
.npc-tag {
  display: inline-flex;
  margin-top: 8px;
  padding: 5px 9px;
  border: 2px solid var(--line);
  border-radius: 999px;
  background: #e0f2fe;
  font-size: 12px;
  font-weight: 900;
}

.choice-title {
  margin: 20px 0 12px;
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: clamp(20px, 3vw, 30px);
  font-weight: 900;
  color: #be185d;
}
.choices {
  display: grid;
  gap: 13px;
}
.choice {
  width: 100%;
  text-align: left;
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: 12px;
  align-items: center;
  padding: 14px;
  border: 4px solid var(--line);
  border-radius: 20px;
  background: white;
  box-shadow: var(--shadow-sm);
  cursor: pointer;
  transition: transform .12s ease, box-shadow .12s ease, background .12s ease;
}
.choice:hover { transform: translate(-3px,-3px); box-shadow: 7px 7px 0 var(--line); background: #f8fafc; }
.choice:active { transform: translate(2px,2px); box-shadow: 2px 2px 0 var(--line); }
.letter {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border: 3px solid var(--line);
  border-radius: 14px;
  background: var(--yellow);
  font-size: 22px;
  font-weight: 900;
}
.choice span.text {
  font-size: clamp(14px, 2.2vw, 17px);
  line-height: 1.65;
  font-weight: 800;
}
.risk {
  justify-self: end;
  padding: 5px 8px;
  border: 2px solid var(--line);
  border-radius: 999px;
  background: #f1f5f9;
  font-size: 11px;
  font-weight: 900;
  white-space: nowrap;
}

.feedback-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 280px;
  gap: clamp(16px, 3vw, 30px);
  align-items: start;
}
.result-card {
  border: 4px solid var(--line);
  border-radius: 28px;
  background: white;
  box-shadow: var(--shadow);
  padding: clamp(20px, 4vw, 36px);
  position: relative;
  overflow: hidden;
}
.result-card.good { background: linear-gradient(145deg, #ecfdf5, #fff); }
.result-card.bad { background: linear-gradient(145deg, #fff1f2, #fff); }
.result-card.okay { background: linear-gradient(145deg, #fffbeb, #fff); }
.grade {
  display: inline-grid;
  place-items: center;
  width: 78px;
  height: 78px;
  border: 4px solid var(--line);
  border-radius: 24px;
  background: var(--yellow);
  box-shadow: var(--shadow-sm);
  font-size: 34px;
  font-weight: 900;
  transform: rotate(-4deg);
  margin-bottom: 18px;
}
.result-title {
  font-size: clamp(24px, 4vw, 42px);
  font-weight: 900;
  line-height: 1.2;
  margin-bottom: 10px;
}
.result-message {
  font-size: clamp(15px, 2.5vw, 19px);
  line-height: 1.85;
  font-weight: 700;
  color: #334155;
}
.quote-card {
  margin-top: 18px;
  border: 3px solid var(--line);
  border-radius: 20px;
  padding: 14px 16px;
  background: #f0f9ff;
  font-weight: 900;
  line-height: 1.65;
}
.coach-panel {
  border: 4px solid var(--line);
  border-radius: 26px;
  background: #fff7ed;
  box-shadow: var(--shadow);
  padding: 16px;
  text-align: center;
}
.coach-panel img {
  width: 100%;
  max-width: 190px;
  height: 170px;
  object-fit: contain;
  filter: drop-shadow(5px 7px 0 rgba(24,34,53,.18));
}
.coach-bubble {
  margin-top: 10px;
  padding: 12px;
  border: 3px solid var(--line);
  border-radius: 18px;
  background: white;
  box-shadow: 3px 3px 0 var(--line);
  font-weight: 900;
  line-height: 1.55;
  text-align: left;
}

.lesson-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: clamp(12px, 2.4vw, 20px);
  margin-top: 20px;
}
.lesson-card {
  border: 4px solid var(--line);
  border-radius: 24px;
  background: #fef9c3;
  box-shadow: var(--shadow-sm);
  padding: 18px;
  cursor: pointer;
  transition: transform .14s ease, box-shadow .14s ease;
}
.lesson-card:hover { transform: translate(-3px,-3px); box-shadow: 7px 7px 0 var(--line); }
.lesson-head {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: flex-start;
}
.lesson-head h3 {
  font-size: clamp(15px, 2.4vw, 20px);
  line-height: 1.35;
  font-weight: 900;
}
.toggle {
  flex: 0 0 auto;
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  border: 3px solid var(--line);
  border-radius: 999px;
  background: var(--orange);
  color: white;
  box-shadow: 3px 3px 0 var(--line);
  font-weight: 900;
  transition: transform .18s ease;
}
.lesson-body {
  display: grid;
  grid-template-rows: 0fr;
  transition: grid-template-rows .2s ease;
}
.lesson-body > div { overflow: hidden; }
.lesson-card.open .lesson-body { grid-template-rows: 1fr; }
.lesson-card.open .toggle { transform: rotate(180deg); }
.lesson-card p {
  margin-top: 12px;
  font-size: 14px;
  line-height: 1.75;
  font-weight: 700;
  color: #475569;
}

.modal-backdrop {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 20;
  background: rgba(15,23,42,.45);
  padding: 20px;
  place-items: center;
}
.modal-backdrop.active { display: grid; }
.modal {
  width: min(100%, 720px);
  max-height: min(86vh, 760px);
  overflow: auto;
  background: var(--paper);
  border: 4px solid var(--line);
  border-radius: 28px;
  box-shadow: 12px 12px 0 rgba(15,23,42,.45);
  padding: clamp(18px, 4vw, 30px);
  animation: pop .18s ease-out;
}
@keyframes pop { from { transform: scale(.96); opacity: 0; } to { transform: scale(1); opacity: 1; } }
.modal h2 { font-size: clamp(22px, 4vw, 34px); font-weight: 900; margin-bottom: 12px; }
.modal p, .modal li { font-size: 15px; line-height: 1.8; font-weight: 700; color: #334155; }
.modal ul { margin: 12px 0 0; padding-left: 1.2em; }

.toast {
  position: fixed;
  left: 50%;
  bottom: 22px;
  z-index: 30;
  transform: translateX(-50%) translateY(20px);
  opacity: 0;
  transition: opacity .16s ease, transform .16s ease;
  width: min(calc(100% - 28px), 560px);
  padding: 12px 16px;
  border: 4px solid var(--line);
  border-radius: 18px;
  background: white;
  box-shadow: var(--shadow);
  font-weight: 900;
  text-align: center;
  pointer-events: none;
}
.toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

.confetti {
  position: fixed;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
  z-index: 25;
}
.confetti i {
  position: absolute;
  top: -20px;
  width: 12px;
  height: 18px;
  border: 2px solid rgba(24,34,53,.3);
  border-radius: 4px;
  animation: fall 900ms linear forwards;
}
@keyframes fall {
  to { transform: translateY(110vh) rotate(420deg); opacity: .2; }
}

:focus-visible {
  outline: 4px dashed #0f172a;
  outline-offset: 4px;
}

@media (max-width: 860px) {
  .hero-grid,
  .mission-layout,
  .feedback-grid {
    grid-template-columns: 1fr;
  }
  .hero-card { min-height: 280px; }
  .npc-panel,
  .coach-panel { position: relative; top: auto; }
  .npc-panel img,
  .coach-panel img { height: 150px; }
  .hud { grid-template-columns: 1fr 1fr; }
  .hud .trust { grid-column: 1 / -1; order: 3; }
  .character-grid { grid-template-columns: repeat(2, 1fr); }
  .stage-map {
    min-height: auto;
    display: grid;
    gap: 14px;
    padding: 18px;
  }
  .stage-map::after { display: none; }
  .chosen-hero,
  .stage-node {
    position: relative;
    inset: auto;
    transform: none !important;
    width: 100%;
  }
  .chosen-hero {
    order: -1;
    margin-bottom: 6px;
  }
  .stage-node {
    grid-template-columns: 96px 1fr;
    justify-items: start;
    align-items: center;
    border: 4px solid var(--line);
    border-radius: 24px;
    background: rgba(255,255,255,.76);
    box-shadow: var(--shadow-sm);
    padding: 10px;
  }
  .stage-node img { width: 88px; height: 88px; }
  .node-label { white-space: normal; width: 100%; text-align: left; }
}

@media (max-width: 560px) {
  .window-bar { min-height: 40px; padding: 8px 10px; }
  .dot { width: 16px; height: 16px; border-width: 2px; }
  .bar-title { display: none; }
  .actions .btn { width: 100%; }
  .topbar { grid-template-columns: auto 1fr; }
  .topbar .hud-card { display: none; }
  .character-card { min-height: 128px; border-radius: 20px; }
  .character-card img { height: 86px; }
  .character-card .type { font-size: 12px; padding: 5px 7px; }
  .choice { grid-template-columns: auto 1fr; }
  .choice .risk { grid-column: 2; justify-self: start; }
  .lesson-grid { grid-template-columns: 1fr; }
  .hud { grid-template-columns: 1fr; }
  .hud-card { padding: 9px 12px; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: .001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .001ms !important;
  }
}


/* =====================================================
   8-BIT / FAMICOM SKIN v2
   方針：雰囲気は8-bit、本文は読みやすく、ステージは重ならない
   ===================================================== */
:root {
  --ink: #10172f;
  --muted: #536177;
  --paper: #fff6d8;
  --paper-2: #f3dda2;
  --line: #071024;
  --navy: #071b3a;
  --navy-2: #0a294b;
  --teal: #0f7f74;
  --pink: #e74d80;
  --blue: #2395cc;
  --green: #4caf50;
  --yellow: #f5c542;
  --orange: #d86d32;
  --danger: #b82e2e;
  --shadow: 8px 8px 0 #071024;
  --shadow-sm: 4px 4px 0 #071024;
  --radius: 0px;
  --font: 'M PLUS Rounded 1c', 'Hiragino Kaku Gothic ProN', sans-serif;
  --font-pixel: 'DotGothic16', 'M PLUS Rounded 1c', monospace;
}

html {
  image-rendering: auto;
}

body {
  font-family: var(--font);
  letter-spacing: .01em;
  background:
    linear-gradient(rgba(255,255,255,.035) 50%, rgba(0,0,0,.035) 50%) 0 0 / 100% 4px,
    linear-gradient(180deg, #071b3a 0%, #0b3556 52%, #118063 52%, #118063 64%, #78451f 64%, #4e2c19 100%);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

body::before {
  opacity: .22;
  background-image:
    linear-gradient(90deg, rgba(255,255,255,.08) 1px, transparent 1px),
    linear-gradient(rgba(255,255,255,.08) 1px, transparent 1px);
  background-size: 8px 8px;
  mask-image: none;
  mix-blend-mode: screen;
}

body::after {
  content: "";
  position: fixed;
  inset: 0;
  z-index: 50;
  pointer-events: none;
  opacity: .08;
  background: repeating-linear-gradient(
    to bottom,
    rgba(255,255,255,.18) 0,
    rgba(255,255,255,.18) 1px,
    transparent 1px,
    transparent 4px
  );
}

.app::before,
.app::after {
  content: "";
  position: fixed;
  z-index: 0;
  pointer-events: none;
  width: 120px;
  height: 48px;
  opacity: .85;
  background:
    linear-gradient(#fff6d8 0 0) 0 18px / 24px 12px no-repeat,
    linear-gradient(#fff6d8 0 0) 20px 10px / 64px 24px no-repeat,
    linear-gradient(#fff6d8 0 0) 82px 20px / 34px 12px no-repeat,
    linear-gradient(#d8d0ae 0 0) 8px 30px / 76px 6px no-repeat;
  filter: drop-shadow(4px 4px 0 rgba(0,0,0,.24));
  animation: pixelCloud 8s steps(5, end) infinite;
}
.app::before { left: 4vw; top: 9vh; }
.app::after { right: 5vw; top: 13vh; transform: scale(.9); animation-delay: 1s; }

@keyframes pixelCloud {
  0%, 100% { translate: 0 0; }
  50% { translate: 18px 0; }
}

.bg-chip {
  font-family: var(--font-pixel);
  color: transparent;
  opacity: .78;
  filter: none;
  text-shadow: none;
  animation: bitBlink 1.4s steps(2, end) infinite;
}
.chip-1::before { content: "●"; color: #fff6d8; text-shadow: 3px 3px 0 #071024; }
.chip-2::before { content: "★"; color: #fff6d8; text-shadow: 3px 3px 0 #071024; }
.chip-3::before { content: "✦"; color: #fff6d8; text-shadow: 3px 3px 0 #071024; }
.chip-4::before { content: "■"; color: #c6bda0; text-shadow: 3px 3px 0 #071024; }
.bg-chip { font-size: clamp(22px, 3.5vw, 42px) !important; }

@keyframes bitBlink {
  0%, 50% { opacity: .9; }
  51%, 100% { opacity: .42; }
}

.screen { animation: bitScreenIn .18s steps(4, end); }
@keyframes bitScreenIn {
  from { opacity: 0; transform: translateY(14px); }
  to { opacity: 1; transform: translateY(0); }
}

.window,
.hero-card,
.stage-map,
.mission-card,
.npc-panel,
.result-card,
.coach-panel,
.lesson-card,
.modal,
.toast,
.hud-card,
.choice,
.btn,
.back-btn,
.character-card,
.node-label,
.chosen-label,
