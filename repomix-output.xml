    .lead {
      font-size: clamp(16px, 2.5vw, 19px);
      line-height: 2.0;
      max-width: 560px;
    }

    .hero-card {
      background:
        linear-gradient(#fff6d8 0 0) 18px 54px / 46px 14px no-repeat,
        linear-gradient(#fff6d8 0 0) 58px 38px / 70px 24px no-repeat,
        linear-gradient(#fff6d8 0 0) 128px 56px / 40px 14px no-repeat,
        repeating-linear-gradient(0deg, transparent 0 7px, rgba(255,255,255,.06) 7px 8px),
        #071b3a;
      min-height: 330px;
      overflow: hidden;
    }
    .hero-card::after {
      height: 92px;
      background:
        repeating-linear-gradient(90deg, rgba(0,0,0,.2) 0 4px, transparent 4px 24px),
        linear-gradient(to bottom, #4caf50 0 34%, #2d7a35 34% 42%, #78451f 42% 100%);
      border-top: 6px solid #071024;
    }

    .main-mascot {
      bottom: 54px;
      animation: pixelHop 1s steps(2, end) infinite;
    }
    .chosen-hero {
      animation: none;
    }
    @keyframes pixelHop {
      0%, 100% { transform: translateX(-50%) translateY(0); }
      50% { transform: translateX(-50%) translateY(-10px); }
    }

    img {
      image-rendering: pixelated;
      image-rendering: crisp-edges;
    }
    .main-mascot img,
    .chosen-hero img,
    .character-card img,
    .npc-panel img,
    .coach-panel img,
    .stage-node img {
      filter:
        drop-shadow(3px 0 0 #071024)
        drop-shadow(-3px 0 0 #071024)
        drop-shadow(0 3px 0 #071024)
        drop-shadow(0 7px 0 rgba(0,0,0,.24));
    }

    .speech,
    .quote-card,
    .coach-bubble {
      background: #fff6d8;
      border-width: 4px;
      box-shadow: 4px 4px 0 #071024;
      line-height: 1.7;
    }
    .speech {
      max-width: 250px;
      font-family: var(--font);
      font-size: 15px;
    }
    .speech::before,
    .speech::after { display: none; }
    .speech::after {
      display: block;
      content: "";
      position: absolute;
      left: 32px;
      bottom: -16px;
      width: 16px;
      height: 16px;
      background: #fff6d8;
      border-right: 4px solid #071024;
      border-bottom: 4px solid #071024;
    }

    .btn,
    .choice,
    .back-btn,
    .character-card,
    .stage-node,
    .lesson-card {
      transition: transform .08s steps(2, end), box-shadow .08s steps(2, end), background .08s steps(2, end);
    }
    .btn,
    .choice,
    .back-btn,
    .letter,
    .toggle,
    .grade {
      box-shadow: 4px 4px 0 #071024;
    }
    .btn:hover,
    .choice:hover,
    .character-card:hover,
    .lesson-card:hover,
    .stage-node:hover {
      transform: translate(-4px, -4px) !important;
      box-shadow: 8px 8px 0 #071024 !important;
    }
    .btn:active,
    .choice:active,
    .back-btn:active,
    .stage-node:active {
      transform: translate(4px, 4px) !important;
      box-shadow: 0 0 0 #071024 !important;
    }
    .btn.primary,
    .letter,
    .grade { background: #f5c542; }
    .btn.pink { background: #e74d80; color: #fff6d8; text-shadow: 2px 2px 0 #071024; }
    .btn.blue { background: #2395cc; color: #fff6d8; text-shadow: 2px 2px 0 #071024; }

    .character-card {
      background: #fff6d8;
      border-width: 4px;
      min-height: 148px;
    }
    .character-card::before {
      border-radius: 0;
      background: #071024;
      color: #fff6d8;
      border-color: #fff6d8;
      box-shadow: 2px 2px 0 #071024;
      font-family: var(--font-pixel);
    }
    .character-card .type {
      border-radius: 0;
      background: #071024;
      color: #fff6d8;
      border-color: #071024;
      text-shadow: 2px 2px 0 #000;
      font-family: var(--font-pixel);
    }
    .character-card .type small { color: #f5c542; }
    .group-analyst { background: #7560b8; }
    .group-diplomat { background: #52a85d; }
    .group-sentinel { background: #2395cc; }
    .group-explorer { background: #d86d32; }

    /* ステージ選択：絶対配置をやめ、重ならないカードマップに変更 */
    .stage-map {
      min-height: auto;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-template-areas:
        "s2 hero s4"
        "s1 hero s5"
        ".  s3  .";
      gap: clamp(14px, 2.4vw, 24px);
      padding: clamp(20px, 3vw, 34px);
      background:
        linear-gradient(#fff6d8 0 0) 8% 12% / 64px 20px no-repeat,
        linear-gradient(#fff6d8 0 0) 72% 16% / 92px 24px no-repeat,
        repeating-linear-gradient(90deg, rgba(255,246,216,.16) 0 3px, transparent 3px 24px),
        repeating-linear-gradient(0deg, rgba(255,246,216,.16) 0 3px, transparent 3px 24px),
        #0f7f74;
      overflow: visible;
    }
    .stage-map::before {
      content: "";
      position: absolute;
      inset: 22px;
      pointer-events: none;
      opacity: .55;
      background-image: radial-gradient(circle, #fff6d8 0 3px, transparent 4px);
      background-size: 28px 28px;
    }
    .stage-map::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 82px;
      z-index: 0;
      background:
        repeating-linear-gradient(90deg, rgba(0,0,0,.18) 0 4px, transparent 4px 24px),
        linear-gradient(to bottom, #21c679 0 44%, #7b421e 44% 100%);
      border-top: 5px solid #071024;
    }
    .chosen-hero,
    .stage-node {
      position: relative !important;
      inset: auto !important;
      transform: none !important;
      z-index: 2;
    }
    .chosen-hero {
      grid-area: hero;
      align-self: center;
      min-height: 310px;
      padding: 20px;
      border: 5px solid #fff6d8;
      background: rgba(7,16,36,.78);
      box-shadow: 6px 6px 0 #071024;
    }
    .chosen-hero img {
      width: clamp(120px, 16vw, 180px);
      height: clamp(120px, 16vw, 180px);
    }
    .chosen-label {
      margin-top: 12px;
      max-width: 100%;
      white-space: normal;
      justify-content: center;
      text-align: center;
      line-height: 1.35;
    }
    .stage-node {
      width: 100% !important;
      min-height: 190px;
      display: grid;
      grid-template-rows: 1fr auto;
      justify-items: center;
      align-items: end;
      gap: 10px;
      padding: 14px 12px;
      background: rgba(255,246,216,.92);
      border: 5px solid #071024;
      box-shadow: 5px 5px 0 #071024;
    }
    .stage-node img {
      width: clamp(86px, 12vw, 132px);
      height: clamp(86px, 12vw, 132px);
      object-fit: contain;
      align-self: center;
    }
    .stage-1 { grid-area: s1; }
    .stage-2 { grid-area: s2; }
    .stage-3 { grid-area: s3; }
    .stage-4 { grid-area: s4; }
    .stage-5 { grid-area: s5; }
    .node-label,
    .chosen-label {
      width: 100%;
      background: #071024;
      color: #fff6d8;
      border: 3px solid #fff6d8;
      text-shadow: 2px 2px 0 #000;
      box-shadow: 3px 3px 0 #071024;
    }
    .node-label {
      font-size: clamp(14px, 1.8vw, 17px);
      white-space: normal;
      text-align: center;
      line-height: 1.35;
    }
    .node-label small,
    .chosen-label span + span { color: #f5c542; }

    .hud-card {
      background: #071024;
      color: #fff6d8;
      text-shadow: 2px 2px 0 #000;
      border-color: #fff6d8;
    }
    .meter {
      height: 24px;
      background: repeating-linear-gradient(90deg, #1f2b3d 0 14px, #071024 14px 18px);
      border-color: #fff6d8;
    }
    .meter-fill {
      background: repeating-linear-gradient(90deg, #f5c542 0 16px, #d86d32 16px 20px);
      transition: width .35s steps(8, end);
    }

    .mission-layout,
    .feedback-grid { align-items: stretch; }
    .mission-card,
    .npc-panel,
    .result-card,
    .coach-panel { background-color: #fff6d8; }

    .mission-card {
      padding: clamp(20px, 3.2vw, 34px);
    }
    .scenario {
      font-size: clamp(16px, 2.2vw, 19px);
      line-height: 2.05;
      letter-spacing: .02em;
      max-width: 820px;
    }
    .choice-title {
      color: #e74d80;
      font-size: clamp(24px, 3.4vw, 36px);
      text-shadow: 2px 2px 0 #fff6d8;
      margin-top: 28px;
    }

    .npc-name,
    .npc-tag,
    .risk {
      background: #071024;
      color: #fff6d8;
      border-color: #fff6d8;
      text-shadow: 2px 2px 0 #000;
    }
    .npc-panel img,
    .coach-panel img {
      max-width: 210px;
      height: 210px;
    }

    .choice {
      background: #fffdf1;
      border-width: 4px;
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      padding: 16px 18px;
      gap: 16px;
    }
    .choice span.text {
      font-size: clamp(15px, 2vw, 17px);
      line-height: 1.75;
      font-weight: 800;
    }
    .choice:nth-child(1) .letter { background: #b82e2e; color: #fff6d8; text-shadow: 2px 2px 0 #071024; }
    .choice:nth-child(2) .letter { background: #2395cc; color: #fff6d8; text-shadow: 2px 2px 0 #071024; }
    .choice:nth-child(3) .letter { background: #4caf50; color: #fff6d8; text-shadow: 2px 2px 0 #071024; }

    .result-card.good { background: #d8efc8; }
    .result-card.okay { background: #fff6d8; }
    .result-card.bad { background: #ffd0c8; }
    .grade {
      transform: none;
      width: 72px;
      height: 72px;
      border-width: 5px;
    }

    .lesson-card {
      background: #fff6d8;
      border-width: 4px;
    }
    .lesson-card:nth-child(1) { background: #f3dda2; }
    .lesson-card:nth-child(2) { background: #c9e8ff; }
    .lesson-card:nth-child(3) { background: #d8efc8; }
    .lesson-card:nth-child(4) { background: #ffd0df; }

    .modal-backdrop { background: rgba(7,16,36,.72); }
    .toast {
      background: #071024;
      color: #fff6d8;
      border-color: #fff6d8;
      text-shadow: 2px 2px 0 #000;
    }
    .confetti i {
      border-radius: 0;
      width: 14px;
      height: 14px;
      animation: bitFall 700ms steps(6, end) forwards;
    }
    @keyframes bitFall {
      to { transform: translateY(110vh) rotate(180deg); opacity: .15; }
    }

    ::selection { background: #f5c542; color: #071024; }

    @media (max-width: 920px) {
      .hero-grid {
        grid-template-columns: 1fr;
      }
      .title {
        font-size: clamp(42px, 12vw, 76px);
      }
      .stage-map {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        grid-template-areas:
          "hero hero"
          "s1 s2"
          "s3 s4"
          "s5 s5";
      }
      .chosen-hero {
        min-height: 260px;
      }
    }

    @media (max-width: 680px) {
      .stage-map {
        grid-template-columns: 1fr;
        grid-template-areas:
          "hero"
          "s1"
          "s2"
          "s3"
          "s4"
          "s5";
      }
      .stage-node {
        min-height: 118px;
        grid-template-columns: 86px 1fr;
        grid-template-rows: auto;
        justify-items: start;
        align-items: center;
      }
      .stage-node img {
        width: 74px;
        height: 74px;
      }
      .node-label { text-align: left; }
      .chosen-hero { min-height: 220px; }
      .choice {
        grid-template-columns: auto 1fr;
      }
      .choice .risk {
        grid-column: 2;
        justify-self: start;
      }
    }

    @media (max-width: 560px) {
      :root { --shadow: 5px 5px 0 #071024; --shadow-sm: 3px 3px 0 #071024; }
      .window,
      .mission-card,
      .stage-map,
      .result-card,
      .coach-panel,
      .npc-panel,
      .modal {
        border-width: 4px;
        box-shadow: 5px 5px 0 #071024;
      }
      .title {
        font-size: clamp(38px, 14vw, 62px);
        text-shadow:
          2px 0 0 #071024,
          -2px 0 0 #071024,
          0 2px 0 #071024,
          0 -2px 0 #071024,
          4px 4px 0 #b82e2e;
      }
      .lead,
      .scenario,
      .choice span.text {
        font-size: 15px;
        line-height: 1.85;
      }
      .choice-title { font-size: 25px; }
      .choice,
      .btn,
      .back-btn { border-width: 3px; }
    }
  </style>
</head>
<body>
  <span class="bg-chip chip-1">🌙</span>
  <span class="bg-chip chip-2">☀️</span>
  <span class="bg-chip chip-3">💎</span>
  <span class="bg-chip chip-4">🧩</span>

  <main class="app">
    <section id="screen-title" class="screen active" aria-labelledby="title-heading">
      <div class="window">
        <div class="window-bar" aria-hidden="true">
          <span class="dot red">×</span><span class="dot yellow">−</span><span class="dot green">□</span>
          <span class="bar-title">MBTI COMMUNICATION QUEST</span>
        </div>
        <div class="window-body hero-grid">
          <div>
            <div class="kicker">🧩 伝え方で、世界がちょっと平和になる</div>
            <h1 id="title-heading" class="title">Pieceful<small>ピースフル</small></h1>
            <p class="lead">
              MBTIタイプ別キャラクターで、職場コミュニケーションを攻略するミニゲーム。<br />
              報告・相談・提案の「切り出し方」を選び、相手の信頼ゲージを上げよう。
            </p>
            <div class="actions">
              <button class="btn primary" onclick="go('character')">ゲーム開始 ▶</button>
              <button class="btn pink" onclick="openGuide()">遊び方を見る 📖</button>
            </div>
          </div>
          <div class="hero-card" aria-hidden="true">
            <div class="mini-stat">
              <span class="mini-pill">信頼ゲージ +10</span>
              <span class="mini-pill">コンボ 0</span>
              <span class="mini-pill">ミッション 5種</span>
            </div>
            <div class="speech">今日の相手は誰かな？<br />言い方を選ぼう！</div>
            <div class="main-mascot"><img src="./img/15.png" alt="" /></div>
          </div>
        </div>
      </div>
    </section>

    <section id="screen-character" class="screen" aria-labelledby="character-heading">
      <div class="window">
        <div class="window-bar" aria-hidden="true">
          <span class="dot red">×</span><span class="dot yellow">−</span><span class="dot green">□</span>
          <span class="bar-title">SELECT CHARACTER</span>
        </div>
        <div class="window-body">
          <div class="topbar">
            <button class="back-btn" onclick="go('title')" aria-label="タイトルへ戻る">←</button>
            <div>
              <h2 id="character-heading" class="screen-title">あなたのキャラクターを選ぼう</h2>
              <p class="subnote">タイプごとに「得意な伝え方」と「やりがちな落とし穴」が変わります。</p>
            </div>
            <div class="hud-card">⭐ 0</div>
          </div>
          <div id="character-grid" class="character-grid"></div>
        </div>
      </div>
    </section>

    <section id="screen-stage" class="screen" aria-labelledby="stage-heading">
      <div class="topbar">
        <button class="back-btn" onclick="go('character')" aria-label="キャラクター選択へ戻る">←</button>
        <div>
          <h2 id="stage-heading" class="screen-title">ステージを選ぼう</h2>
          <p class="subnote">相手によって、刺さる言葉・嫌がられる言葉が変わります。</p>
        </div>
        <div class="hud-card" id="stage-score">⭐ 0</div>
      </div>
      <div class="stage-map">
        <div class="chosen-hero">
          <img id="chosen-img" src="./img/15.png" alt="選択中のキャラクター" />
          <div class="chosen-label"><span id="chosen-type">ESTP</span><span id="chosen-nick">瞬発アクション型</span></div>
        </div>
        <button class="stage-node stage-1" onclick="selectStage(1)">
          <img src="./img/stage/st1.png" alt="" />
          <span class="node-label">先輩・上司<small>報連相 / リスク報告</small></span>
        </button>
        <button class="stage-node stage-2" onclick="selectStage(2)">
          <img src="./img/stage/st2.png" alt="" />
          <span class="node-label">同僚<small>協力依頼 / すり合わせ</small></span>
        </button>
